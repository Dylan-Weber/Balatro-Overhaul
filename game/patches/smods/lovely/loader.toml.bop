### Supporting code for loader.lua

## Save discovered, unlocked states
# Game:init_item_prototypes()
[[patches]]
[patches.pattern]
target = 'game.lua'
pattern = "meta.alerted = meta.alerted or {}"
position = 'after'
payload = '''
for _, t in ipairs{
    G.P_CENTERS,
    G.P_BLINDS,
    G.P_TAGS,
    G.P_SEALS,
} do
r 13 131 %20%20%20%20 -
l 5
        SMODS._save_d_u(v)
        v._discovered_unlocked_overwritten = true
    end
end'''
match_indent = true
end
