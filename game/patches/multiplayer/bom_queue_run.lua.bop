local QR = {}
QR.view = QR.view or {text = ""}

local FOUND_DELAY = 5
local LOBBY_KEYS = {"bom_room_code", "mp_opponent"}
local LEAVES_QUEUE = {create_room = true, join_room = true, party_create = true, rejoin_match = true, spectate = true}

local function L(s) return mod_loc and mod_loc(s) or s end
local function now() return love.timer.getTime() end
local function ranked_ui() return rawget(_G, "bom_ranked_ui") end
local function alive(o) return o and not o.REMOVED end

local function searching()
    local u = ranked_ui()
    return u and u.searching and u.searching() or false
end

local function sp_run()
    return G.STAGE == G.STAGES.RUN and G.GAME and not G.GAME.multiplayer
end

local function remove_bar()
    if QR.bar then pcall(function() QR.bar:remove() end) end
    QR.bar, QR.bar_kind = nil, nil
end

local function text_node(key, scale, colour)
    return {n = G.UIT.T, config = {ref_table = QR.view, ref_value = key, scale = scale, colour = colour, shadow = true}}
end

local function pill_button(label, button, colour, minw)
    return {n = G.UIT.C, config = {align = "cm", button = button, colour = colour, r = 0.08, padding = 0.05, minw = minw or 0.8, hover = true, shadow = true}, nodes = {
        {n = G.UIT.T, config = {text = label, scale = 0.26, colour = G.C.WHITE, shadow = true}},
    }}
end

local function gap() return {n = G.UIT.C, config = {minw = 0.08}} end

local function cell(nodes, minw)
    return {n = G.UIT.C, config = {align = "cm", minw = minw, padding = 0.03}, nodes = nodes}
end

local function bar_def(kind)
    local nodes
    if kind == "found" then
        nodes = {cell({text_node("text", 0.28, G.C.GREEN)}, 2.6), gap(), pill_button(L("GO"), "mp_queue_go", G.C.GREEN)}
    elseif kind == "folded" then
        nodes = {pill_button(">", "mp_queue_fold", G.C.UI.BACKGROUND_INACTIVE, 0.4), gap(), cell({text_node("short", 0.28, G.C.GOLD)}, 0.7)}
    elseif kind == "confirm" then
        nodes = {
            pill_button("<", "mp_queue_fold", G.C.UI.BACKGROUND_INACTIVE, 0.4), gap(),
            cell({{n = G.UIT.T, config = {text = L("Leave queue?"), scale = 0.28, colour = G.C.WHITE, shadow = true}}}, 1.6), gap(),
            pill_button(L("YES"), "mp_queue_cancel_yes", G.C.RED, 0.6), gap(),
            pill_button(L("NO"), "mp_queue_cancel_no", G.C.UI.BACKGROUND_INACTIVE, 0.6),
        }
    else
        nodes = {
            pill_button("<", "mp_queue_fold", G.C.UI.BACKGROUND_INACTIVE, 0.4), gap(),
            cell({text_node("text", 0.28, G.C.GOLD)}, 2.2), gap(),
            pill_button("X", "mp_queue_cancel", G.C.RED, 0.4),
        }
    end
    return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR}, nodes = {
        {n = G.UIT.R, config = {align = "cm", colour = G.C.BLACK, r = 0.1, padding = 0.06, emboss = 0.04}, nodes = nodes},
    }}
end

local GAP_PX = 6

local function spot_px()
    local CL = rawget(_G, "CORNER_LABELS")
    local sw = love.graphics.getWidth()
    local margin = CL and CL.MARGIN or 10
    if G.STAGE == G.STAGES.MAIN_MENU and CL and CL.version_rect then
        local r = CL.version_rect
        return r.x - GAP_PX, r.y + r.h / 2, "right_mid"
    end
    local y = margin
    local text = CL and CL.progress_text and CL.progress_text()
    if text and CL.box then
        local _, h = CL.box(text, CL.scale(), love.graphics.getFont())
        y = y + h + GAP_PX
    end
    local fb = CL and G.SETTINGS.GRAPHICS and G.SETTINGS.GRAPHICS.show_fps and CL.fps_box
    if fb and fb.x + fb.w > sw - 200 and fb.y < y + 30 then y = math.max(y, fb.y + fb.h + GAP_PX) end
    return sw - margin, y, "right_top"
end

local function place_bar(snap)
    local b = QR.bar
    if not alive(b) then return end
    local u = G.TILESIZE * G.TILESCALE
    local px, py, how = spot_px()
    local x = px / u - G.ROOM.T.x - G.ROOM_ATTACH.T.x - b.T.w
    local y = py / u - G.ROOM.T.y - G.ROOM_ATTACH.T.y - (how == "right_mid" and b.T.h / 2 or 0)
    local o = b.alignment.offset
    if b.alignment.type == "tli" and o and math.abs(o.x - x) < 0.01 and math.abs(o.y - y) < 0.01 then return end
    b:set_alignment({major = G.ROOM_ATTACH, type = "tli", offset = {x = x, y = y}, bond = "Weak"})
    b:align_to_major()
    if snap then b:hard_set_VT() end
end

local function show_bar(kind)
    if alive(QR.bar) and QR.bar_kind == kind then return place_bar() end
    remove_bar()
    QR.bar = UIBox{definition = bar_def(kind), config = {align = "tli", offset = {x = 0, y = 0}, major = G.ROOM_ATTACH, bond = "Weak", instance_type = "POPUP"}}
    QR.bar_kind = kind
    place_bar(true)
end

local function notice(text, colour)
    pcall(function()
        attention_text({text = text, scale = 0.6, hold = 3, major = G.ROOM_ATTACH, align = "tm", offset = {x = 0, y = 0.6}, backdrop_colour = colour, silent = true})
    end)
end

local function drop_queue(keep_flags)
    local g = G.GAME
    local searching_flag, quick_flag = g and g.mp_searching, g and g.bom_quick_match
    local u = ranked_ui()
    if u and u.queue_cancel then u.queue_cancel(true) end
    if keep_flags and g then g.mp_searching, g.bom_quick_match = searching_flag, quick_flag end
    remove_bar()
end

function QR.update()
    if not (QR.go_at or QR.bar or searching()) then return end
    if QR.go_at then
        local left = math.max(0, math.ceil(QR.go_at - now()))
        QR.view.text = L("Match found!") .. "  " .. string.format(L("Lobby in %d"), left)
        show_bar("found")
        if now() >= QR.go_at then QR.go() end
    elseif searching() then
        if bom_core.is_connected() then
            QR.was_connected = true
        elseif QR.was_connected then
            QR.was_connected = false
            drop_queue()
            return notice(L("Ranked queue lost connection"), G.C.RED)
        end
        local u = ranked_ui()
        QR.view.short = u.clock(now() - (u.Q.since or now()))
        QR.view.text = L("Ranked queue") .. "  " .. QR.view.short
        if QR.confirm_until and now() > QR.confirm_until then QR.confirm_until = nil end
        local kind = G.SETTINGS.mp_queue_bar_folded and "folded" or (QR.confirm_until and "confirm" or "queue")
        if u.ranked_open() then remove_bar() else show_bar(kind) end
    else
        QR.was_connected = false
        remove_bar()
    end
end

function QR.go()
    if not QR.go_at then return end
    QR.go_at = nil
    remove_bar()
    QR.carry = {}
    for _, k in ipairs(LOBBY_KEYS) do QR.carry[k] = G.GAME and G.GAME[k] end
r 32 1825 %20%20%20%20 -
l 142
    G.FUNCS.go_to_menu()
end

local function after_menu()
    if not QR.room then return end
    QR.room = nil
    if G.GAME then
        for k, v in pairs(QR.carry or {}) do G.GAME[k] = v end
        G.GAME.bom_quick_match = true
    end
    QR.carry = nil
    if bom_match.get_phase() == bom_match.PHASE.LOBBY then bom_ui.show_quick_match_lobby() end
end

local function hold_lobby_ui()
    if QR._ui_held then return end
    QR._ui_held = true
    for _, name in ipairs({"show_quick_match_lobby", "show_lobby"}) do
        local f = bom_ui[name]
        if type(f) == "function" then
            bom_ui[name] = function(...)
                if QR.room then return end
                return f(...)
            end
        end
    end
end

local function wrap_room_ready()
    local base = bom_room.on_room_ready
    bom_room.on_room_ready = function(d, ...)
        if type(d) == "table" and d.ranked then
            if G.GAME then G.GAME.bom_quick_match = true end
            if sp_run() then
                hold_lobby_ui()
                QR.room = true
                QR.go_at = now() + FOUND_DELAY
                pcall(play_sound, "timpani")
            end
        end
        return base(d, ...)
    end
end

local function wrap_room_gone()
    local R = rawget(_G, "bom_rejoin")
    if not (R and R.do_exit) then return end
    local base = R.do_exit
    R.do_exit = function(...)
        if not (QR.room and sp_run()) then return base(...) end
        QR.go_at, QR.room, QR.carry = nil, nil, nil
        remove_bar()
        local go_to_menu = G.FUNCS.go_to_menu
        G.FUNCS.go_to_menu = function() end
        local ok, err = pcall(base, ...)
        G.FUNCS.go_to_menu = go_to_menu
        R.exiting, R.menu_popup, R.after_menu = false, nil, nil
        notice(L("Match cancelled, back in the queue"), G.C.GOLD)
        ranked_ui().queue_start()
        if not ok then error(err, 0) end
    end
end

local function wrap_queue_start()
    local u = ranked_ui()
    local base = u.queue_start
    u.queue_start = function(...)
        local r = base(...)
        QR.was_connected = false
        return r
    end
end

local function guard_core()
    local send, disconnect = bom_core.send, bom_core.disconnect
    bom_core.send = function(data, opts)
        if type(data) == "table" and searching() then
            local quick = data.type == "find_match" and data.ranked ~= true
            if quick or LEAVES_QUEUE[data.type] then drop_queue(quick) end
        end
        return send(data, opts)
    end
    bom_core.disconnect = function(...)
        if searching() then drop_queue() end
        return disconnect(...)
    end
end

local function hook_main_menu()
    local base = Game.main_menu
    Game.main_menu = function(self, ...)
        local r = base(self, ...)
        if QR.room then
            G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.6, blocking = false, blockable = false, func = function()
                pcall(after_menu)
                return true
            end}))
        end
        return r
    end
end

local function register_strings()
    if not mod_loc_register then return end
    mod_loc_register{
        fr = {["Ranked queue"] = "File classée", ["Match found!"] = "Adversaire trouvé !", ["Lobby in %d"] = "Salon dans %d", ["GO"] = "Y ALLER",
            ["Ranked queue lost connection"] = "File classée : connexion perdue", ["Match cancelled, back in the queue"] = "Match annulé, retour dans la file",
            ["Back, stay in queue"] = "Retour, rester dans la file", ["Leave queue?"] = "Quitter la file ?", ["YES"] = "OUI", ["NO"] = "NON", ["Leave queue & back"] = "Quitter la file et revenir"},
        es = {["Ranked queue"] = "Cola clasificatoria", ["Match found!"] = "¡Rival encontrado!", ["Lobby in %d"] = "Sala en %d", ["GO"] = "IR",
            ["Ranked queue lost connection"] = "Cola clasificatoria: conexión perdida", ["Match cancelled, back in the queue"] = "Partida cancelada, de vuelta en la cola",
            ["Back, stay in queue"] = "Volver, seguir en la cola", ["Leave queue?"] = "¿Salir de la cola?", ["YES"] = "SÍ", ["NO"] = "NO", ["Leave queue & back"] = "Salir de la cola y volver"},
    }
end

function QR.init()
    if QR.installed or not (ranked_ui() and bom_core and bom_room and bom_ui and bom_match and Game) then return end
    QR.installed = true
    wrap_room_ready()
    wrap_room_gone()
    wrap_queue_start()
    guard_core()
    hook_main_menu()
    register_strings()
    G.FUNCS.mp_queue_go = function() QR.go() end
    G.FUNCS.mp_queue_fold = function()
        QR.confirm_until = nil
        G.SETTINGS.mp_queue_bar_folded = not G.SETTINGS.mp_queue_bar_folded or nil
        G:save_settings()
    end
    G.FUNCS.mp_queue_cancel = function() QR.confirm_until = now() + 4 end
    G.FUNCS.mp_queue_cancel_no = function() QR.confirm_until = nil end
    G.FUNCS.mp_queue_cancel_yes = function()
        QR.confirm_until = nil
        drop_queue()
        local m, so = rawget(_G, "mpm_menu"), rawget(_G, "social_online")
        if bom_match.get_phase() == bom_match.PHASE.NONE and not (m and m.active) and not (so and so.keep and so.keep()) then
            bom_core.disconnect()
        end
    end
end

return QR
end
