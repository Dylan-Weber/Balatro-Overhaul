local W = {}

W.S = W.S or {ctx = nil, me = nil, away = false, prompt = nil, others = {}, note = nil, note_until = 0, stash = {}, sent_at = 0}
W.view = W.view or {title = "", detail = "", detail2 = ""}
W.KEEPALIVE = 300
W.RETRY_FOR = 180
W.RETRY_GAP = 3
W.NOTE_HOLD = 8
W.HELD_MAX = 200

local S = W.S

local function L(s) return mod_loc and mod_loc(s) or s end
local function now() return love.timer.getTime() end
local function touch() return UIK and UIK.touch and UIK.touch() end
local function alive(o) return o and not o.REMOVED end
local function U() return rawget(_G, "bom_ranked_ui") end
local function PB() return rawget(_G, "bom_playback") end

local function clock(sec)
    sec = math.max(0, math.floor(sec or 0))
    return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
end
W.clock = clock

function W.searching()
    local u = U()
    return u and u.searching and u.searching() or false
end

local function phase()
    local ok, p = pcall(function() return bom_match.get_phase() end)
    return ok and p or "none"
end

local function in_lobby_phase()
    return phase() == "lobby"
end

function W.watching()
    local P = PB()
    return P and P.active and P.active() or false
end

function W.practising()
    local B = rawget(_G, "BO_PRACTICE")
    return B and B.active and B.active() or false
end

function W.keeps_queue()
    return W.blocks_single()
end

function W.solo_run()
    return G and G.STAGES and G.STAGE == G.STAGES.RUN and not W.mp_run and not (G.GAME and G.GAME.multiplayer) or false
end

function W.lobby_open()
    if not (G and G.OVERLAY_MENU) then return false end
    if G.BOM_LOBBY_OVERLAY and G.OVERLAY_MENU == G.BOM_LOBBY_OVERLAY then return true end
    local P = rawget(_G, "bom_party")
    if P and P._box and G.OVERLAY_MENU == P._box and UIK and UIK._win and UIK._win.id == "party" then return true end
    return false
end

function W.ranked_open()
    local u = U()
    return u and u.ranked_open and u.ranked_open() or false
end

function W.blocks_single()
    return W.searching() or S.ctx ~= nil
end

function W.has_save()
    if not (G and G.SETTINGS and G.FUNCS and G.FUNCS.can_continue) then return false end
    local ok, yes = pcall(G.FUNCS.can_continue, {config = {func = true}})
    return ok and yes and true or false
end

function W.flush_save()
    if W.mp_run or not (G and G.GAME) or G.GAME.multiplayer then return false end
    local FH = G.FILE_HANDLER
    if not (FH and FH.run and G.ARGS and G.ARGS.save_run and G.SAVE_MANAGER and G.SAVE_MANAGER.channel) then return false end
    G.SAVE_MANAGER.channel:push({type = "save_run", save_table = G.ARGS.save_run, profile_num = G.SETTINGS.profile})
    FH.run = nil
    G.SAVED_GAME = nil
    return true
end

function W.install_save_rules()
    if W._save_rules then return end
    W._save_rules = true
    if Game and Game.start_run then
        local start_run = Game.start_run
        Game.start_run = function(self, args, ...)
            local mp = type(args) == "table" and args.mp_start and true or false
            if mp and not W.mp_run then pcall(W.flush_save) end
            if not mp then pcall(W.keep_bits) end
            W.mp_run = mp
            local r = start_run(self, args, ...)
            if not mp then pcall(W.on_solo_start) end
            return r
        end
    end
    local save_run_ref = rawget(_G, "save_run")
    if type(save_run_ref) == "function" then
        _G.save_run = function(...)
            local r = save_run_ref(...)
            if W.mp_run and G and G.FILE_HANDLER then G.FILE_HANDLER.run = nil end
            return r
        end
    end
    local remove_ref = rawget(_G, "remove_save")
    if type(remove_ref) == "function" then
        _G.remove_save = function(...)
            if W.mp_run then
                if G and G.FILE_HANDLER then G.FILE_HANDLER.run = nil end
                return
            end
            return remove_ref(...)
        end
    end
end

local function send(msg)
    pcall(function()
        if bom_core and bom_core.is_connected and bom_core.is_connected() then bom_core.send(msg) end
    end)
end

function W.set_me(status)
    S.me = status
    S.sent_at = now()
    send({type = "wait_status", status = status})
end

function W.note(text)
    S.note = text
    S.note_until = now() + W.NOTE_HOLD
end

local function party_room()
    local P = rawget(_G, "bom_party")
    return P and P.S and P.S.room or nil
end

local function in_party()
    local P = rawget(_G, "bom_party")
    return P and P.active and P.active() or false
end

local function opp_name()
    if S.held then return S.found_name end
    local st = bom_match and bom_match.get_state and bom_match.get_state()
    local n = st and st.opp_name
    if st and st.waiting_guest then return nil end
    if n and n ~= "" and n ~= "Opponent" then return n end
    return nil
end

function W.other_status(pid)
    local o = S.others[pid or "opp"]
    return o and o.status or nil
end

function W.status_label(status, upper)
    if status == "solo" then return L(upper and "PLAYING SOLO" or "Playing solo") end
    if status == "wait" then return L(upper and "JOINS LATER" or "Joins later") end
    return nil
end

function W.opp_status_label(upper)
    if not S.ctx or S.ctx == "party" then return nil end
    local o
    for _, v in pairs(S.others) do o = v end
    return o and W.status_label(o.status, upper) or nil
end

function W.party_status(p)
    if type(p) ~= "table" then return nil end
    if p.pid == (rawget(_G, "bom_party") and bom_party.S.me) then return nil end
    return W.status_label(p.wait, false)
end

local function stash_game_bits(before)
    if not (G and G.GAME) then return end
    for k, v in pairs(G.GAME) do
        if type(k) == "string" and (k:sub(1, 3) == "mp_" or k:sub(1, 4) == "bom_") and before[k] ~= v then
            S.stash[k] = v
            G.GAME[k] = before[k]
        end
    end
end

local function game_bits()
    local t = {}
    if G and G.GAME then
        for k, v in pairs(G.GAME) do
            if type(k) == "string" and (k:sub(1, 3) == "mp_" or k:sub(1, 4) == "bom_") then t[k] = v end
        end
    end
    return t
end

function W.wrap_dispatch()
    if W._dispatch or not (bom_events and bom_events.dispatch) then return end
    W._dispatch = true
    local dispatch = bom_events.dispatch
    bom_events.dispatch = function(data, ...)
        local guard = W.solo_run() and (S.ctx ~= nil or W.searching())
        local before = guard and game_bits() or nil
        local r = dispatch(data, ...)
        if before then pcall(stash_game_bits, before) end
        return r
    end
end

function W.keep_bits()
    if not S.ctx or W.solo_run() or not (G and G.STAGE == G.STAGES.MAIN_MENU) then return end
    for k, v in pairs(game_bits()) do
        if S.stash[k] == nil then S.stash[k] = v end
    end
end

local function apply_stash()
    if not (G and G.GAME) then return end
    for k, v in pairs(S.stash) do G.GAME[k] = v end
    S.stash = {}
end

function W.reset_ctx()
    S.ctx, S.me, S.away, S.prompt, S.others = nil, nil, false, nil, {}
    S.held, S.opp_pid = nil, nil
    S.stash = {}
    S.pending_open = nil
end

function W.wrap_lobby_views()
    if W._views then return end
    W._views = true
    local function guard(tbl, name)
        local f = tbl and tbl[name]
        if type(f) ~= "function" then return end
        tbl[name] = function(...)
            if S.ctx and S.away then return end
            return f(...)
        end
    end
    guard(bom_ui, "show_lobby")
    guard(bom_ui, "show_quick_match_lobby")
    guard(rawget(_G, "bom_party"), "show_lobby")
end

function W.open_lobby()
    local m = rawget(_G, "mpm_menu")
    if m then m.casino = nil end
    S.away = false
    S.prompt = nil
    apply_stash()
    if G.OVERLAY_MENU then pcall(G.FUNCS.exit_overlay_menu) end
    if S.ctx == "party" then
        pcall(bom_party.show_lobby)
    elseif S.ctx == "ranked" then
        if G.GAME then G.GAME.bom_quick_match = true end
        pcall(bom_ui.show_quick_match_lobby)
    else
        if G.GAME then G.GAME.bom_quick_match = nil end
        pcall(bom_ui.show_lobby)
    end
    W.remove_box()
end

function W.join()
    if not S.ctx then return end
    W.set_me("lobby")
    S.prompt = nil
    if W.watching() then
        S.pending_open = true
        S.away = true
        W.remove_box()
        pcall(PB().leave)
        return
    end
    if W.solo_run() then
        pcall(W.flush_save)
        S.pending_open = true
        S.away = true
        W.remove_box()
        G.FUNCS.go_to_menu()
        return
    end
    W.open_lobby()
end

function W.wait()
    if not S.ctx then return end
    S.prompt = nil
    W.set_me("wait")
    W.refresh_box(true)
end

function W.cancel_queue()
    local u = U()
    if u and u.queue_cancel then u.queue_cancel() end
    W.refresh_box(true)
end

function W.unready()
    if S.ctx == "party" then
        local P = rawget(_G, "bom_party")
        local room = party_room()
        for _, p in ipairs(room and room.players or {}) do
            if p.pid == (P and P.S.me) and p.ready then send({type = "party_ready", ready = false}) end
        end
        return
    end
    local st = bom_match.get_state()
    if st and st.my_ready then bom_match.set_ready(false) end
end

local function lobby_kind()
    if in_party() then return "party" end
    local st = bom_match.get_state()
    if (st and st.ranked == true) or (G.GAME and G.GAME.bom_quick_match) then return "ranked" end
    return "room"
end

function W.ensure_ctx()
    if S.ctx or not in_lobby_phase() then return end
    S.ctx, S.away = lobby_kind(), false
end

function W.go_solo()
    if not in_lobby_phase() then return false end
    W.ensure_ctx()
    S.away = true
    S.prompt = nil
    pcall(W.unready)
    S.stash = game_bits()
    return true
end

function W.on_solo_start()
    if S.ctx and S.away and S.me ~= "wait" then W.set_me("solo") end
end

function W.continue_run()
    local u = U()
    local from_ranked = W.ranked_open()
    if not from_ranked and W.lobby_open() then W.go_solo() end
