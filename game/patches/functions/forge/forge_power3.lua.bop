function P.sync(card, off)
  local c = P.item(card)
  if not c then return end
  local info = P.passive_of(c)
  local have = type(card.ability.forge_passive) == "table" and card.ability.forge_passive or {}
  if not info.any and not next(have) then return end
  local want = {}
  if not off then
    if info.var then rules_mod().vars_state(card, rules_mod().clean_vars(c.vars)) end
    want = P.want(card, info)
  end
  local keys = {}
  for k in pairs(have) do keys[k] = true end
  for k in pairs(want) do keys[k] = true end
  for k in pairs(keys) do
    if k == "chances" then
      local a, b = tonumber(have[k]) or 1, tonumber(want[k]) or 1
      if a ~= b then
        for key, v in pairs(G.GAME.probabilities) do G.GAME.probabilities[key] = v / a * b end
      end
    else
      apply(k, (tonumber(want[k]) or 0) - (tonumber(have[k]) or 0))
    end
  end
  card.ability.forge_passive = next(want) and want or nil
  if info.flags.free_planets and (off or not card.forge_planets) then refresh_costs() end
  card.forge_planets = not off and info.flags.free_planets or nil
end

function P.target(card, v)
  local list = G.jokers and G.jokers.cards or {}
  local at
  for i, j in ipairs(list) do if j == card then at = i break end end
  if not at then return nil end
  local t
  if v == "right" then t = list[at + 1]
  elseif v == "left" then t = list[at - 1]
  elseif v == "leftmost" then t = list[1]
  else t = list[#list] end
  if t == card then return nil end
  return t
end

local SUM = {"chip_mod", "mult_mod", "chips", "mult", "h_mult", "dollars", "p_dollars", "repetitions", "h_chips"}
local PROD = {"Xmult_mod", "x_mult", "xmult"}
function P.merge(a, b)
  if not a then return b end
  if not b then return a end
  for _, k in ipairs(SUM) do
    if a[k] or b[k] then a[k] = (a[k] or 0) + (b[k] or 0) end
  end
  for _, k in ipairs(PROD) do
    if a[k] or b[k] then a[k] = (a[k] or 1) * (b[k] or 1) end
  end
  if b.saved then a.saved = true end
  a.message = a.message or b.message
  return a
end

function P.copy(card, context, info)
  local t = P.target(card, info.copy)
  if not t then return nil end
r 3 2310 %20%20 -
l 107
  context.blueprint_card = context.blueprint_card or card
  if context.blueprint > #G.jokers.cards + 1 then return nil end
  local r = t:calculate_joker(context)
  context.blueprint = nil
  local eff = context.blueprint_card or card
  context.blueprint_card = nil
  if r then
    r.card = eff
    r.colour = G.C.BLUE
    return r
  end
  return nil
end

local function wrap(obj, name, make)
  if obj and type(obj[name]) == "function" then obj[name] = make(obj[name]) end
end
P.wrap = wrap

local function log(key, err)
  P.logged = P.logged or {}
  if P.logged[key] then return end
  P.logged[key] = true
  print("[FORGE] " .. key .. " failed: " .. tostring(err))
end

