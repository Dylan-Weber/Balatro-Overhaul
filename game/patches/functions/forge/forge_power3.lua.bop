}
P.LOC = LOC

local function lt(lang) return TEXT[lang] or TEXT.en end

local function signed(n)
  n = tonumber(n) or 0
  local T = package.loaded["functions/forge/forge_text"]
  local s = T and T.fmt_n and T.fmt_n(math.abs(n)) or tostring(math.abs(n))
  return (n < 0 and "-" or "+") .. s
end

function P.rules(R)
  local T = require("functions/forge/forge_text")
  local function add_ids(list, ids)
    for _, id in ipairs(ids) do
      if not R.member(list, id) then list[#list + 1] = id end
      R.V8_IDS[id] = true
    end
  end
  for _, w in ipairs(P.WHEN) do
    if not R.member(R.WHEN, w) then R.WHEN[#R.WHEN + 1] = w end
    if not R.member(R.JOKER_WHEN, w) then R.JOKER_WHEN[#R.JOKER_WHEN + 1] = w end
    R.V8_IDS[w] = true
  end
  add_ids(R.GIVE, P.PASSIVE)
  add_ids(R.GIVE, P.GIVES)
  add_ids(R.ONLY, P.ONLY)
  local NUM = {
    p_hand_size = {def = 1, lo = -10, hi = 100, step = 1, big = 5}, p_hand_size_var = {def = 1, lo = -10, hi = 100, step = 1, big = 5},
    p_hands = {def = 1, lo = -10, hi = 100, step = 1, big = 5}, p_discards = {def = 1, lo = -10, hi = 100, step = 1, big = 5},
    p_joker_slots = {def = 1, lo = -10, hi = 100, step = 1, big = 5}, p_consumable_slots = {def = 1, lo = -10, hi = 100, step = 1, big = 5},
    p_interest = {def = 1, lo = 1, hi = 1e6, step = 1, big = 5}, p_free_rerolls = {def = 1, lo = 1, hi = 100, step = 1, big = 5},
    p_chances = {def = 2, lo = 1, hi = 1000, step = 1, big = 5}, p_debt = {def = 20, lo = 1, hi = 1e6, step = 5, big = 50},
    dagger = {def = 2, lo = 1, hi = 1e6, step = 1, big = 5}, sell_all = {def = 1, lo = 1, hi = 1e6, step = 1, big = 5},
    blind_percent = {def = 25, lo = 1, hi = 1000, step = 5, big = 25},
  }
  for k, v in pairs(NUM) do R.NUM[k] = v end
  R.VAR_GIVE.p_hand_size_var = true
  local JOKER = {joker = true}
  for _, id in ipairs(P.PASSIVE) do R.HOST_GIVE[id] = JOKER end
  for _, id in ipairs(P.GIVES) do R.HOST_GIVE[id] = JOKER end
  for _, id in ipairs(P.ONLY) do R.HOST_ONLY[id] = JOKER end
  R.ONLY_WHEN.other_rarity = {other_joker = true}
  R.ONLY_WHEN.blind_percent = {would_lose = true, round_end = true, hand_played = true, after = true}
  if R.ONLY_WHEN.boss_triggered then
    local t = {}
    for k, v in pairs(R.ONLY_WHEN.boss_triggered) do t[k] = v end
    t.hand_debuffed = true
    R.ONLY_WHEN.boss_triggered = t
  end
  local OUTSIDE = {blind_selected = true, first_hand = true, round_end = true, shop_end = true, blind_skipped = true, after = true, reroll = true}
  R.GIVE_WHEN.save_run = {would_lose = true}
  R.GIVE_WHEN.dagger = OUTSIDE
  R.GIVE_WHEN.sell_all = OUTSIDE
  R.GIVE_WHEN.dup_joker = {self_sold = true, blind_selected = true, round_end = true, shop_end = true, blind_skipped = true}
  R.GIVE_WHEN.copy_consumable = {shop_end = true, blind_selected = true, round_end = true, blind_skipped = true, reroll = true}

  local PASS = set(P.PASSIVE)
  P.PASS = PASS
  local OTHER_OK = set({"chips", "mult", "xmult", "money", "var_add", "var_set", "var_chips", "var_mult", "gain_chips", "gain_mult", "gain_xmult"})
  local LOSE_OK = set({"save_run", "destroy_self", "money", "var_add", "var_set", "create", "tag", "reset_gains", "create_rarity", "make_card"})
  local DEBUFF_OK = set({"money", "var_add", "var_set", "gain_chips", "gain_mult", "gain_xmult", "create", "tag", "make_card", "reset_gains"})
  local base_give, base_only = R.allowed_give, R.allowed_only
  function R.allowed_give(when, give, host)
    host = host or "joker"
    if PASS[give] then return host == "joker" and when == "passive" end
    if when == "passive" then return false end
    if when == "would_lose" then return host == "joker" and LOSE_OK[give] or false end
    if when == "other_joker" then return host == "joker" and OTHER_OK[give] or false end
    if when == "hand_debuffed" then return host == "joker" and DEBUFF_OK[give] or false end
    return base_give(when, give, host)
  end
  function R.allowed_only(when, only, host)
    if when == "passive" then return false end
    if (when == "other_joker" or when == "would_lose" or when == "hand_debuffed") and (host or "joker") ~= "joker" then return false end
    return base_only(when, only, host)
  end

  local function fix(list, def) return function(c) if not R.member(list, c.v) then c.v = def end end end
  R.DEFAULT_GIVE.p_rule = function() return {id = "p_rule", v = "four_fingers"} end
  R.DEFAULT_GIVE.copy_ability = function() return {id = "copy_ability", v = "right"} end
  R.DEFAULT_GIVE.dagger = function() return {id = "dagger", v = "right", n = 2} end
  R.DEFAULT_GIVE.copy_consumable = function() return {id = "copy_consumable", v = "negative"} end
  R.DEFAULT_GIVE.save_run = function() return {id = "save_run"} end
  R.DEFAULT_GIVE.dup_joker = function() return {id = "dup_joker"} end
  R.DEFAULT_ONLY.other_rarity = function() return {id = "other_rarity", v = "Uncommon"} end
  R.DEFAULT_ONLY.blind_percent = function() return {id = "blind_percent", op = "at_least", n = 25} end
  R.CLEAN_GIVE.p_rule = function(e) fix(P.RULES, "four_fingers")(e); e.n = nil end
  R.CLEAN_GIVE.copy_ability = function(e) fix(P.COPY, "right")(e); e.n = nil end
  R.CLEAN_GIVE.dagger = fix(P.SIDES, "right")
  R.CLEAN_GIVE.copy_consumable = function(e) fix(P.COPY_KINDS, "negative")(e); e.n = nil end
  R.CLEAN_GIVE.save_run = function(e) e.v, e.n = nil, nil end
  R.CLEAN_GIVE.dup_joker = function(e) e.v, e.n = nil, nil end
  R.CLEAN_GIVE.copy_card = function(e) if e.v ~= "hand" then e.v = nil end e.n = nil end
  for id in pairs(P.KEY) do
    if not R.CLEAN_GIVE[id] then R.CLEAN_GIVE[id] = function(e) e.v = nil end end
  end
  R.CLEAN_ONLY.other_rarity = function(c) fix(R.RARITIES or {"Common", "Uncommon", "Rare", "Legendary"}, "Uncommon")(c); c.op, c.n = nil, nil end
  R.CLEAN_ONLY.blind_percent = function(c) c.v = nil; c.op = c.op or "at_least" end

  R.CHECKS.other_rarity = function(o, context, card)
    local j = context.other_joker
    local c = j and j.config and j.config.center
    return c ~= nil and j ~= card and c.rarity == P.RARITY_N[o.v]
  end
  R.CHECKS.blind_percent = function(o)
    local b = G.GAME and G.GAME.blind
    local need = b and tonumber(b.chips) or 0
    if need <= 0 then return false end
    return R.compare(o.op, (tonumber(G.GAME.chips) or 0) / need * 100, o.n)
  end

  local D = R.DOS
  D.save_run = function(g, card, src, context, other, acc) acc.saved = true end
  D.dagger = function(g, card, src, context)
    if context.blueprint then return end
    local list = G.jokers and G.jokers.cards or {}
    local at
    for i, j in ipairs(list) do if j == card then at = i end end
    if not at then return end
    local t = list[at + (g.v == "left" and -1 or 1)]
    if not t or (t.ability and t.ability.eternal) or t.getting_sliced then return end
    local x = R.state(card)
    x.mult = x.mult + (tonumber(g.n) or 2) * (tonumber(t.sell_cost) or 0)
    t.getting_sliced = true
    G.GAME.joker_buffer = (G.GAME.joker_buffer or 0) - 1
r 3 617 %20%20%20%20 -
r 3 2539 %20%20%20%20%20%20 -
l 40
      if card.juice_up then card:juice_up(0.8, 0.8) end
      if t.start_dissolve then t:start_dissolve({HEX and HEX("57ecab") or G.C.RED}, nil, 1.6) end
      play_sound("slice1", 0.96 + math.random() * 0.08)
      return true
    end}))
    R.status(src, localize{type = "variable", key = "a_mult", vars = {x.mult}}, G.C.RED)
  end
  D.sell_all = function(g, card, src)
    for _, area in ipairs({G.jokers, G.consumeables}) do
      for _, j in ipairs(area and area.cards or {}) do
        if j.set_cost then
          j.ability.extra_value = (j.ability.extra_value or 0) + (tonumber(g.n) or 1)
          j:set_cost()
        end
      end
    end
    R.status(src, localize("k_val_up"), G.C.MONEY)
  end
  D.dup_joker = function(g, card, src, context, other, acc)
    if context.blueprint then return end
    local pool = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do if j ~= card then pool[#pool + 1] = j end end
    if #pool == 0 then R.status(src, localize("k_no_other_jokers"), G.C.FILTER) return end
    local used = #G.jokers.cards + (G.GAME.joker_buffer or 0) - (acc and acc.when == "self_sold" and 1 or 0)
    if used >= G.jokers.config.card_limit then R.status(src, localize("k_no_room_ex"), G.C.FILTER) return end
    local chosen = pseudorandom_element(pool, pseudoseed("forge_invisible"))
    local c = copy_card(chosen, nil, nil, nil, chosen.edition and chosen.edition.negative)
    if c.ability and c.ability.invis_rounds then c.ability.invis_rounds = 0 end
    c:add_to_deck()
    G.jokers:emplace(c)
    R.status(src, localize("k_duplicated_ex"), G.C.FILTER)
  end
  D.copy_consumable = function(g, card, src)
    local area = G.consumeables
    if not (area and area.cards and area.cards[1]) then return end
    local neg = g.v ~= "normal"
    if not neg then
      if #area.cards + (G.GAME.consumeable_buffer or 0) >= area.config.card_limit then return end
      G.GAME.consumeable_buffer = (G.GAME.consumeable_buffer or 0) + 1
    end
r 3 617 %20%20%20%20 -
l 167
      local pick = pseudorandom_element(area.cards, pseudoseed("forge_perkeo"))
      if pick then
        local c = copy_card(pick, nil)
        if neg then c:set_edition({negative = true}, true) end
        c:add_to_deck()
        area:emplace(c)
      end
      if not neg then G.GAME.consumeable_buffer = 0 end
      return true
    end}))
    R.status(src, localize("k_duplicated_ex"), G.C.FILTER)
  end

  local TG, TO = R.TEXT_GIVE, R.TEXT_ONLY
  for id in pairs(P.KEY) do
    TG[id] = function(g, s, lang, vars)
      local l = lt(lang)
      if id == "p_chances" and tonumber(g.n) == 2 then return l.p_chances2 end
      if id == "p_chances" then return string.format(l.p_chances, T.fmt_n(tonumber(g.n) or 2)) end
      if id == "p_interest" or id == "p_debt" then return string.format(l[id], T.fmt_n(tonumber(g.n) or 1)) end
      if id == "p_free_rerolls" then return string.format(l[id], T.fmt_n(tonumber(g.n) or 1)) end
      if id == "p_hand_size_var" then return string.format(l[id], signed(g.n), T.var_name(vars, g.var)) end
      return string.format(l[id], signed(g.n))
    end
  end
  TG.p_rule = function(g, s, lang) return lt(lang).rules[g.v] or lt(lang).rules.four_fingers end
  TG.copy_ability = function(g, s, lang) return lt(lang).copy[g.v] or lt(lang).copy.right end
  TG.save_run = function(g, s, lang) return lt(lang).save_run end
  TG.dagger = function(g, s, lang) return string.format(lt(lang).dagger[g.v] or lt(lang).dagger.right, T.fmt_n(tonumber(g.n) or 2)) end
  TG.sell_all = function(g, s, lang) return string.format(lt(lang).sell_all, T.fmt_n(tonumber(g.n) or 1)) end
  TG.dup_joker = function(g, s, lang) return lt(lang).dup_joker end
  TG.copy_consumable = function(g, s, lang) return lt(lang).copy_consumable[g.v] or lt(lang).copy_consumable.negative end
  local RCOL = {Common = "blue", Uncommon = "green", Rare = "red", Legendary = "legendary"}
  TO.other_rarity = function(o, s, lang) return string.format(lt(lang).other_rarity, RCOL[o.v] or "green", lt(lang).rarity[o.v] or o.v) end
  TO.blind_percent = function(o, s, lang) return string.format(lt(lang).blind_percent, s[o.op or "at_least"] or s.at_least, T.fmt_n(tonumber(o.n) or 25)) end

  for lang, t in pairs(TEXT) do
    if T.W and T.W[lang] then
      for _, w in ipairs(P.WHEN) do T.W[lang][w] = t[w] end
    end
  end
  for id, l in pairs(P.LABEL_GIVE) do R.LABEL_GIVE[id] = l end
  for id, l in pairs(P.LABEL_ONLY) do R.LABEL_ONLY[id] = l end
  for _, id in ipairs({"p_hand_size", "p_joker_slots", "p_rule", "copy_ability", "p_discards", "p_hands"}) do R.SIMPLE_GIVE[id] = true end

  R.VALUES_GIVE = R.VALUES_GIVE or {}
  R.VALUES_ONLY = R.VALUES_ONLY or {}
  local function opts(list)
    return function()
      local out = {}
      for _, v in ipairs(list) do out[#out + 1] = {label = mod_loc and mod_loc(P.LABEL_VALUE[v] or v) or (P.LABEL_VALUE[v] or v), value = v} end
      return out
    end
  end
  R.VALUES_GIVE.p_rule = opts(P.RULES)
  R.VALUES_GIVE.copy_ability = opts(P.COPY)
  R.VALUES_GIVE.dagger = opts(P.SIDES)
  R.VALUES_GIVE.copy_consumable = opts(P.COPY_KINDS)
  R.VALUES_GIVE.copy_card = opts(P.COPY_TO)
  R.VALUES_ONLY.other_rarity = function()
    local out = {}
    for _, v in ipairs({"Common", "Uncommon", "Rare", "Legendary"}) do out[#out + 1] = {label = mod_loc and mod_loc(v) or v, value = v} end
    return out
  end
  if R.COUNTS and R.COUNT and R.PER_GIVE and not R.member(R.COUNTS, "tarots_used") then
    R.COUNTS[#R.COUNTS + 1] = "tarots_used"
    R.V8_IDS.tarots_used = true
    R.COUNT.tarots_used = function()
      local u = G.GAME and G.GAME.consumeable_usage_total
      return u and tonumber(u.tarot) or 0
    end
    if R.LABEL_COUNT then R.LABEL_COUNT.tarots_used = "Tarot used this run" end
    local SWAP = {
      en = {"different {C:planet}Planet{} card used this run", "{C:tarot}Tarot{} card used this run"},
      fr = {"carte {C:planet}Planète{} différente utilisée dans la partie", "carte {C:tarot}Tarot{} utilisée dans la partie"},
      es = {"carta de {C:planet}Planeta{} distinta usada en la partida", "carta de {C:tarot}Tarot{} usada en la partida"},
    }
    for id in pairs(R.PER_GIVE) do
      local base = R.TEXT_GIVE[id]
      if base then
        R.TEXT_GIVE[id] = function(gv, s, lang, ...)
          if gv.per ~= "tarots_used" then return base(gv, s, lang, ...) end
          local x = {}
          for k, v in pairs(gv) do x[k] = v end
          x.per = "planets_used"
          local t = base(x, s, lang, ...)
          local sw = SWAP[lang] or SWAP.en
          local a, b = t:find(sw[1], 1, true)
          if a then t = t:sub(1, a - 1) .. sw[2] .. t:sub(b + 1) end
          return t
        end
      end
    end
  end
  if mod_loc_register then mod_loc_register(LOC) end
end

local function is_forge(card)
  local c = card and card.config and card.config.center
  if c and c.forge and c.forge_id and not c.forge_lost then return c end
  return nil
end
P.is_forge = is_forge

function P.item(card)
  local cen = is_forge(card)
  local S = store()
  if not (cen and S and S.get) then return nil end
  return S.get(cen.forge_id)
end

P.cache = {}
function P.passive_of(c)
  local hit = P.cache[c.id]
  if hit and hit.rules == c.rules and hit.vars == c.vars then return hit.info end
  local R = rules_mod()
  local info = {list = {}, flags = {}, copy = nil, any = false, var = false}
  for _, r in ipairs(R.clean_rules(c.rules)) do
    if r.when == "passive" then
      for _, g in ipairs(r.give) do
        info.any = true
        if g.id == "p_rule" then info.flags[g.v] = true
        elseif g.id == "copy_ability" then info.copy = g.v
        elseif P.KEY[g.id] then
          info.list[#info.list + 1] = g
          if g.var then info.var = true end
        end
      end
    end
  end
  P.cache[c.id] = {rules = c.rules, vars = c.vars, info = info}
  return info
end

function P.want(card, info)
  local R = rules_mod()
  local w = {}
  for _, g in ipairs(info.list) do
    local k = P.KEY[g.id]
    local n = tonumber(g.n) or 0
    if g.var then n = n * (tonumber(R.var_val(card, g.var)) or 0) end
    if k == "chances" then w[k] = (w[k] or 1) * math.max(1, n)
    else w[k] = (w[k] or 0) + math.floor(n) end
  end
  for k, v in pairs(w) do if v == 0 or (k == "chances" and v == 1) then w[k] = nil end end
  return w
end

local function apply(k, d)
  if d == 0 then return end
  local g = G.GAME
  if k == "hand_size" then if G.hand then G.hand:change_size(d) end
  elseif k == "hands" then g.round_resets.hands = g.round_resets.hands + d
  elseif k == "discards" then
    g.round_resets.discards = g.round_resets.discards + d
    ease_discard(d)
  elseif k == "joker_slots" then G.jokers.config.card_limit = G.jokers.config.card_limit + d
  elseif k == "consumable_slots" then if G.consumeables then G.consumeables.config.card_limit = G.consumeables.config.card_limit + d end
  elseif k == "interest" then g.interest_amount = (g.interest_amount or 1) + d
  elseif k == "free_rerolls" then
    g.current_round.free_rerolls = (g.current_round.free_rerolls or 0) + d
    if calculate_reroll_cost then calculate_reroll_cost(true) end
  elseif k == "debt" then g.bankrupt_at = (g.bankrupt_at or 0) - d
  end
end

