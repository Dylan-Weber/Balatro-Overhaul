function P.others(c, skip)
  local out = {}
  for _, e in ipairs(c.effects or {}) do if e.id ~= skip then out[#out + 1] = e end end
  return out
end

function P.cat(Cat)
  local function n(lo, hi, def, step, unit) return {lo = lo, hi = hi, def = def, step = step or 1, unit = unit} end
  local boss = {
    {id = "discard_held", label = "Discard random held cards", num = n(1, 1000, 2), line = "Discards {C:attention}%d{} random cards held in hand after every played hand", simple = true},
    {id = "most_played_zero", label = "Most played hand costs all money", line = "Playing your most played {C:attention}poker hand{} sets money to {C:money}$0{}"},
    {id = "face_down_chance", label = "Cards drawn face down by chance", num = n(2, 1000, 7), line = "{C:green}#P# in %d{} cards get drawn face down"},
    {id = "face_down_faces", label = "Face cards drawn face down", line = "All face cards are drawn face down", simple = true},
    {id = "face_down_after", label = "Face down after each hand", line = "Cards are drawn face down after each hand played"},
    {id = "level_down", label = "Level down the played hand", line = "Decrease level of played {C:attention}poker hand{}", simple = true},
    {id = "no_repeat", label = "No repeated hand types", line = "No repeat hand types this round"},
    {id = "one_type", label = "Only one hand type", line = "Play only {C:attention}1{} hand type this round"},
    {id = "draw_three", label = "Always draw 3", line = "Always draw {C:attention}3{} cards after playing or discarding"},
    {id = "debuff_played_ante", label = "Debuff cards played this ante", line = "Cards played previously this Ante are debuffed"},
    {id = "shuffle_jokers", label = "Flip and shuffle Jokers", line = "Flips and shuffles all {C:attention}Joker{} cards"},
    {id = "debuff_until_sell", label = "Debuff until a Joker is sold", line = "All cards debuffed until {C:attention}1{} Joker sold"},
    {id = "disable_joker", label = "Disable a random Joker", line = "One random {C:attention}Joker{} disabled every hand"},
    {id = "force_select", label = "Force a selected card", line = "Forces {C:attention}1{} card to always be selected"},
  }
  local tag = {
    {id = "next_edition", label = "Edition on the next shop Joker", v = "shader", line = "Next base edition shop {C:attention}Joker{} is free and becomes {C:dark_edition}%s{}", simple = true},
    {id = "boss_money", label = "Money after the Boss Blind", num = n(1, 1e6, 25, 1, "$"), line = "After defeating the {C:attention}Boss Blind{}, gain {C:money}$%d{}"},
    {id = "shop_voucher", label = "Voucher in the next shop", line = "Adds one {C:attention}Voucher{} to the next shop"},
    {id = "reroll_boss", label = "Reroll the Boss Blind", line = "Rerolls the {C:attention}Boss Blind{}"},
    {id = "double_money", label = "Double your money", num = n(1, 1e6, 40, 5, "$"), line = "Doubles your money (max {C:money}$%d{})"},
    {id = "free_shop_reroll", label = "Free rerolls start at $0", line = "Rerolls in the next shop start at {C:money}$0{}"},
  }
  local voucher = {
    {id = "omen", label = "Spectrals in Arcana packs", line = "{C:spectral}Spectral{} cards may appear in any of the {C:attention}Arcana Packs{}"},
    {id = "telescope", label = "Most played Planet in Celestial packs", line = "{C:attention}Celestial Packs{} always contain the {C:planet}Planet{} card for your most played {C:attention}poker hand{}"},
    {id = "observatory", label = "Held Planets give XMult", num = n(1.05, 1e6, 1.5, 0.05, "x"), line = "{C:planet}Planet{} cards in your {C:attention}consumable{} area give {X:red,C:white}X%s{} Mult for their {C:attention}poker hand{}", args = {"n"}},
    {id = "illusion", label = "Shop cards get enhancements", line = "{C:attention}Playing cards{} in the shop may have an {C:enhanced}Enhancement{} or an {C:dark_edition}Edition{}"},
    {id = "boss_reroll", label = "Reroll the Boss once per ante", line = "Reroll the {C:attention}Boss Blind{} {C:attention}1{} time per Ante, {C:money}$10{} per roll"},
    {id = "boss_reroll_any", label = "Reroll the Boss any time", line = "Reroll the {C:attention}Boss Blind{} {C:attention}unlimited{} times, {C:money}$10{} per roll"},
  }
  local function add(list, items)
    if not list then return end
    for _, e in ipairs(items) do
      local have = false
      for _, x in ipairs(list) do if x.id == e.id then have = true end end
      if not have then
        e.new, e.need = true, 8
        list[#list + 1] = e
      end
    end
  end
  add(Cat.EFFECTS.boss, boss)
  add(Cat.EFFECTS.tag, tag)
  add(Cat.EFFECTS.voucher, voucher)
  local enh = Cat.BY_ID and Cat.BY_ID.enhancement
  if enh and enh.adv_fields then
    local have = false
    for _, f in ipairs(enh.adv_fields) do if f.id == "any_suit" then have = true end end
    if not have then enh.adv_fields[#enh.adv_fields + 1] = {id = "any_suit", label = "Counts as every suit", type = "toggle", def = false, new = true} end
  end
  local base_need = Cat.need_v
  Cat.need_v = function(c)
    local need = base_need(c)
    if type(c) == "table" and c.kind == "enhancement" and type(c.fields) == "table" and c.fields.any_suit then need = math.max(need, 8) end
    return need
  end
  local base_line = Cat.effect_line
  Cat.effect_line = function(kind_id, e)
    local s = base_line(kind_id, e)
    if type(s) == "string" and s:find("#P#", 1, true) then s = s:gsub("#P#", P.prob()) end
    return s
  end
  if mod_loc_register then mod_loc_register(LOC) end
end

function P.install_text()
  if type(generate_card_ui) ~= "function" then return end
  local orig = generate_card_ui
  generate_card_ui = function(...)
    pcall(P.check_prob)
    return orig(...)
  end
end

function P.check_prob()
  local p = G and G.GAME and G.GAME.probabilities and G.GAME.probabilities.normal or 1
  if P.last_p == p then return end
  P.last_p = p
  local K = package.loaded["functions/forge/forge_kinds"]
  local M = package.loaded["functions/forge/forge_kinds_more"]
  if K and K.inject_loc then pcall(K.inject_loc) end
  if M and M.inject_loc then pcall(M.inject_loc) end
end

function P.install()
  if P.hooked then return end
  P.hooked = true
  for _, f in ipairs({P.install_jokers, P.install_blinds, P.install_shop, P.install_text}) do
    local ok, err = pcall(f)
    if not ok then log("install", err) end
  end
end

return P
end
