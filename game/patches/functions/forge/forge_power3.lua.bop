local function rules_mod() return package.loaded["functions/forge/forge_rules"] end
local function store() return package.loaded["functions/forge/forge_store"] end
local function run_mod() return package.loaded["functions/forge/forge_run"] end

function P.prob()
  local p = G and G.GAME and G.GAME.probabilities and G.GAME.probabilities.normal or 1
  local T = package.loaded["functions/forge/forge_text"]
  return T and T.fmt_n and T.fmt_n(p) or tostring(p)
end

