local function blind_item(b)
  local p = b and b.config and b.config.blind
  local S = store()
  if not (p and p.forge_kind == "blind" and S and S.get_item) then return nil end
  return S.get_item(p.forge_id)
end

function P.boss_flags(b)
  local c = blind_item(b)
  if not c then return nil end
  local f = {}
  for _, e in ipairs(c.effects or {}) do
    for _, id in ipairs(P.BOSS) do if e.id == id then f[id] = tonumber(e.n) or true end end
  end
  return next(f) and f or nil
end

local function flip_back()
  for _, c in ipairs(G.hand and G.hand.cards or {}) do if c.facing == "back" then c:flip() end end
  for _, v in pairs(G.playing_cards or {}) do v.ability.wheel_flipped = nil end
end

