    ["Level down the played hand"] = "Baja el nivel de la mano jugada", ["Decrease level of played {C:attention}poker hand{}"] = "Baja el nivel de la {C:attention}mano de póker{} jugada",
    ["No repeated hand types"] = "Sin tipos de mano repetidos", ["No repeat hand types this round"] = "No se repiten tipos de mano en esta ronda",
    ["Only one hand type"] = "Un solo tipo de mano", ["Play only {C:attention}1{} hand type this round"] = "Juega solo {C:attention}1{} tipo de mano en esta ronda",
    ["Always draw 3"] = "Robar siempre 3", ["Always draw {C:attention}3{} cards after playing or discarding"] = "Roba siempre {C:attention}3{} cartas tras jugar o descartar",
    ["Debuff cards played this ante"] = "Debilitar cartas jugadas en la apuesta", ["Cards played previously this Ante are debuffed"] = "Las cartas ya jugadas en esta apuesta quedan debilitadas",
    ["Flip and shuffle Jokers"] = "Voltear y barajar jokers", ["Flips and shuffles all {C:attention}Joker{} cards"] = "Voltea y baraja todos los {C:attention}jokers{}",
    ["Debuff until a Joker is sold"] = "Debilitar hasta vender un joker", ["All cards debuffed until {C:attention}1{} Joker sold"] = "Todas las cartas quedan debilitadas hasta vender {C:attention}1{} joker",
    ["Disable a random Joker"] = "Desactivar un joker al azar", ["One random {C:attention}Joker{} disabled every hand"] = "Un {C:attention}joker{} al azar queda desactivado en cada mano",
    ["Force a selected card"] = "Forzar una carta seleccionada", ["Forces {C:attention}1{} card to always be selected"] = "Obliga a tener siempre {C:attention}1{} carta seleccionada",
    ["Edition on the next shop Joker"] = "Edición en el próximo joker de la tienda", ["Next base edition shop {C:attention}Joker{} is free and becomes {C:dark_edition}%s{}"] = "El próximo {C:attention}joker{} base de la tienda es gratis y se vuelve {C:dark_edition}%s{}",
    ["Money after the Boss Blind"] = "Dinero tras la ciega jefe", ["After defeating the {C:attention}Boss Blind{}, gain {C:money}$%d{}"] = "Tras vencer a la {C:attention}ciega jefe{}, gana {C:money}$%d{}",
    ["Voucher in the next shop"] = "Vale en la próxima tienda", ["Adds one {C:attention}Voucher{} to the next shop"] = "Añade un {C:attention}vale{} a la próxima tienda",
    ["Reroll the Boss Blind"] = "Cambiar la ciega jefe", ["Rerolls the {C:attention}Boss Blind{}"] = "Cambia la {C:attention}ciega jefe{}",
    ["Double your money"] = "Duplicar tu dinero", ["Doubles your money (max {C:money}$%d{})"] = "Duplica tu dinero (máx. {C:money}$%d{})",
    ["Free rerolls start at $0"] = "Renovaciones desde $0", ["Rerolls in the next shop start at {C:money}$0{}"] = "Las renovaciones de la próxima tienda empiezan en {C:money}$0{}",
    ["Spectrals in Arcana packs"] = "Espectrales en sobres arcanos", ["{C:spectral}Spectral{} cards may appear in any of the {C:attention}Arcana Packs{}"] = "Pueden aparecer cartas {C:spectral}espectrales{} en los {C:attention}sobres arcanos{}",
    ["Most played Planet in Celestial packs"] = "Planeta más jugado en sobres celestiales", ["{C:attention}Celestial Packs{} always contain the {C:planet}Planet{} card for your most played {C:attention}poker hand{}"] = "Los {C:attention}sobres celestiales{} siempre traen el {C:planet}planeta{} de tu {C:attention}mano de póker{} más jugada",
    ["Held Planets give XMult"] = "Planetas guardados dan XMulti", ["{C:planet}Planet{} cards in your {C:attention}consumable{} area give {X:red,C:white}X%s{} Mult for their {C:attention}poker hand{}"] = "Las cartas de {C:planet}planeta{} en tus {C:attention}consumibles{} dan {X:red,C:white}X%s{} multi para su {C:attention}mano de póker{}",
    ["Shop cards get enhancements"] = "Cartas de la tienda mejoradas", ["{C:attention}Playing cards{} in the shop may have an {C:enhanced}Enhancement{} or an {C:dark_edition}Edition{}"] = "Las {C:attention}cartas de juego{} de la tienda pueden tener una {C:enhanced}mejora{} o una {C:dark_edition}edición{}",
    ["Reroll the Boss once per ante"] = "Cambiar el jefe una vez por apuesta", ["Reroll the {C:attention}Boss Blind{} {C:attention}1{} time per Ante, {C:money}$10{} per roll"] = "Cambia la {C:attention}ciega jefe{} {C:attention}1{} vez por apuesta, {C:money}$10{} cada vez",
    ["Reroll the Boss any time"] = "Cambiar el jefe sin límite", ["Reroll the {C:attention}Boss Blind{} {C:attention}unlimited{} times, {C:money}$10{} per roll"] = "Cambia la {C:attention}ciega jefe{} {C:attention}sin límite{}, {C:money}$10{} cada vez",
    ["Counts as every suit"] = "Cuenta como todos los palos", ["Tarot used this run"] = "Tarot usado en la partida", ["Can be used as any suit"] = "Puede usarse como cualquier palo",
