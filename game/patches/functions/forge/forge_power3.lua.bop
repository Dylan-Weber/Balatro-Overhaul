function P.run_flag(id)
  local Run = run_mod()
  if not (Run and Run.sources) then return nil end
  local hit
  for _, s in ipairs(Run.sources()) do
    if not s.blind then
      for _, e in ipairs(s.c.effects or {}) do
        if e.id == id then hit = e end
      end
    end
  end
  return hit
end

function P.observatory()
  if G.GAME.used_vouchers and G.GAME.used_vouchers.v_observatory then return nil end
  local e = P.run_flag("observatory")
  return e and (tonumber(e.n) or 1.5) or nil
end

local function boss_reroll_grant()
  local uv = G.GAME and G.GAME.used_vouchers
  if not uv or uv.v_retcon then return nil end
  if P.run_flag("boss_reroll_any") then return "v_retcon" end
  if not uv.v_directors_cut and P.run_flag("boss_reroll") then return "v_directors_cut" end
  return nil
end

local function with_grant(fn, ...)
  local key = boss_reroll_grant()
  if not key then return fn(...) end
  G.GAME.used_vouchers[key] = true
  local ok, r = pcall(fn, ...)
  G.GAME.used_vouchers[key] = nil
  if not ok then error(r) end
  return r
end

function P.install_shop()
  if type(create_card) == "function" then
    local orig = create_card
    create_card = function(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append, ...)
      if G.pack_cards and area == G.pack_cards and not forced_key and G.GAME and G.GAME.used_vouchers then
        local ok, nt, nk, nka = pcall(function()
          if _type == "Tarot" and key_append == "ar1" and not G.GAME.used_vouchers.v_omen_globe and P.run_flag("omen") and pseudorandom("omen_globe") > 0.8 then
            return "Spectral", nil, "ar2"
          end
          if _type == "Planet" and key_append == "pl1" and not G.GAME.used_vouchers.v_telescope and #G.pack_cards.cards == 0 and P.run_flag("telescope") then
            local hand, tally = nil, 0
            for _, v in ipairs(G.handlist or {}) do
              if G.GAME.hands[v].visible and G.GAME.hands[v].played > tally then hand = v; tally = G.GAME.hands[v].played end
            end
            if hand then
              for _, v in pairs(G.P_CENTER_POOLS.Planet) do
                if v.config and v.config.hand_type == hand then return nil, v.key, nil end
              end
            end
          end
          return nil
        end)
        if ok and nt then _type, key_append = nt, nka end
        if ok and nk then forced_key = nk end
      end
      return orig(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append, ...)
    end
  end
  if type(create_card_for_shop) == "function" then
    local orig = create_card_for_shop
    create_card_for_shop = function(area, ...)
      local card = orig(area, ...)
      pcall(function()
        if not (card and card.ability and (card.ability.set == "Default" or card.ability.set == "Enhanced")) then return end
        if G.GAME.used_vouchers.v_illusion or not P.run_flag("illusion") then return end
        if card.ability.set == "Default" and pseudorandom(pseudoseed("illusion")) > 0.6 then
          local pool = {}
          for _, v in ipairs(G.P_CENTER_POOLS.Enhanced or {}) do pool[#pool + 1] = v end
          if #pool > 0 then card:set_ability(pseudorandom_element(pool, pseudoseed("illusion_e")), nil, true) end
        end
        if pseudorandom(pseudoseed("illusion")) > 0.8 then
          local poll = pseudorandom(pseudoseed("illusion"))
          local ed = poll > 1 - 0.15 and {polychrome = true} or poll > 0.5 and {holo = true} or {foil = true}
          card:set_edition(ed)
          card:set_cost()
        end
      end)
      return card
    end
  end
  if G and G.FUNCS then
    wrap(G.FUNCS, "reroll_boss_button", function(orig) return function(e) return with_grant(orig, e) end end)
  end
  if type(create_UIBox_blind_select) == "function" then
    local orig = create_UIBox_blind_select
    create_UIBox_blind_select = function(...) return with_grant(orig, ...) end
  end
  local M = package.loaded["functions/forge/forge_kinds_more"]
  if M and M.TAG_CTX then
    for _, pair in ipairs(P.TAG_CTX) do
      local have = false
      for _, x in ipairs(M.TAG_CTX) do if x[1] == pair[1] then have = true end end
      if not have then M.TAG_CTX[#M.TAG_CTX + 1] = pair end
    end
  end
  if M and M.tag_apply then
    local base = M.tag_apply
    M.tag_apply = function(tag, ctx, p)
      local r, handled = P.tag_apply(tag, ctx, p)
      if handled then return r end
      return base(tag, ctx, p)
    end
  end
end

function P.tag_apply(tag, ctx, p)
  local S = store()
  local c = S and S.get_item and S.get_item(p.forge_id)
  if not c then return nil, false end
  local has = {}
  for _, e in ipairs(c.effects or {}) do has[e.id] = e end
  local t = ctx.type
  if t == "eval" and has.boss_money then
    if not (G.GAME.last_blind and G.GAME.last_blind.boss) then return nil, true end
    tag:yep("+", G.C.GOLD, function() return true end)
    tag.triggered = true
    return {dollars = math.floor(tonumber(has.boss_money.n) or 25), condition = localize("ph_defeat_the_boss"), pos = tag.pos, tag = tag}, true
  end
  if t == "store_joker_modify" and has.next_edition then
    local card = ctx.card
    if not card or card.edition or card.temp_edition or card.ability.set ~= "Joker" then return nil, true end
    local R = rules_mod()
    local ed = R.edition_arg(has.next_edition.v or "foil") or {foil = true}
    local lock = tag.ID
