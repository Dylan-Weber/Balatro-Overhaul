l 2
    elseif v == "perishable" then
      if ab.eternal or not card.set_perishable then return false end
r 31 2142 %20%20%20%20%20%20 -
l 1
    elseif card.set_rental then
r 31 2145 %20%20%20%20%20%20 -
l 435
    end
    return ab[v] == true
  end
  local R = Rules()
  local sid = R and R.own_id("sticker", v)
  if not sid or St().has(card, sid) then return false end
  return St().apply(card, sid)
end

function X.held(card)
  local ab = type(card) == "table" and card.ability
  local out = {}
  if not ab then return out end
  for _, k in ipairs(X.VANILLA) do
    if ab[k] then out[#out + 1] = k end
  end
  for _, id in ipairs(St().ids(card)) do out[#out + 1] = {own = id} end
  return out
end

function X.take(card, v, seed)
  local ab = type(card) == "table" and card.ability
  if not ab then return false end
  if v == "any" then
    local held = X.held(card)
    if #held == 0 then return false end
    local one = pick(held, 1, seed or "forge_unstick")[1]
    if type(one) == "table" then
      if not St().remove(card, one.own) then return false end
      if card.set_cost then pcall(card.set_cost, card) end
      return true
    end
    v = one
  end
  local done = false
  for _, k in ipairs(X.VANILLA) do
    if v == k and ab[k] then
      local dead = k == "perishable" and (tonumber(ab.perish_tally) or 1) <= 0
      if k == "rental" and card.set_rental then card:set_rental(false) else ab[k] = nil end
      if k == "perishable" then ab.perish_tally = nil end
      if dead and card.set_debuff then card:set_debuff(false) end
      done = true
    end
  end
  local R = Rules()
  local sid = R and R.own_id("sticker", v)
  if sid and St().remove(card, sid) then
    if card.set_cost then pcall(card.set_cost, card) end
    done = true
  end
  return done
end

local function juice(list)
  for _, c in ipairs(list) do
    if c.juice_up then G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.1, func = function() c:juice_up(0.3, 0.4); return true end})) end
  end
end

function X.put_many(v, area_cards, n, seed)
  local pool = {}
  for _, c in ipairs(area_cards or {}) do
    if not c.removed and not X.has(c, v) and (not member(X.VANILLA, v) or X.card_kind(c) == "Jokers") then pool[#pool + 1] = c end
  end
  local done = {}
  for _, c in ipairs(pick(pool, math.max(1, n), seed)) do
    if X.put(c, v) then done[#done + 1] = c end
  end
  juice(done)
  return done
end

function X.put_random(v, seed)
  return X.put_many(v, G.jokers and G.jokers.cards, 1, seed)[1]
end

function X.take_many(v, area_cards, n, seed)
  local pool = {}
  for _, c in ipairs(area_cards or {}) do
    if not c.removed and X.has(c, v) then pool[#pool + 1] = c end
  end
  local done = {}
  for _, c in ipairs(pick(pool, math.max(1, n), seed)) do
    if X.take(c, v, seed) then done[#done + 1] = c end
  end
  juice(done)
  return done
end

function X.stick_random(id, area_cards, n, seed)
  local pool = {}
  for _, c in ipairs(area_cards or {}) do
    if c.ability and not St().has(c, id) and #St().ids(c) < St().PER_CARD and not c.removed then pool[#pool + 1] = c end
  end
  local done = {}
  for _, c in ipairs(pick(pool, math.max(1, n), seed)) do
    if St().apply(c, id) then done[#done + 1] = c end
  end
  for _, c in ipairs(done) do
    if c.juice_up then G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.1, func = function() c:juice_up(0.3, 0.4); return true end})) end
  end
  return done
end

function X.shop_bonus(id)
  local t = G and G.GAME and G.GAME.forge_stk_shop
  return type(t) == "table" and tonumber(t[id]) or 0
end

function X.apply(e)
  local id = e and e.id
  if not X.RUN[id] then return false end
  local R = Rules()
  local n = math.max(1, math.floor(tonumber(e.n) or 1))
  if id == "unstick_joker" or id == "unstick_deck" or id == "unstick_hand" then
    local area = id == "unstick_joker" and (G.jokers and G.jokers.cards) or id == "unstick_deck" and G.playing_cards or (G.hand and G.hand.cards)
    if X.is_value(e.v) then X.take_many(e.v, area, n, "forge_" .. id) end
    return true
  end
  if id == "stick_joker" and member(X.VANILLA, e.v) then
    X.put_many(e.v, G.jokers and G.jokers.cards, n, "forge_stk_j")
    return true
  end
  local sid = R and R.own_id("sticker", e.v)
  if not (sid and St().by_id[sid]) then return true end
  if id == "stick_joker" then X.stick_random(sid, G.jokers and G.jokers.cards, n, "forge_stk_j")
  elseif id == "stick_deck" then X.stick_random(sid, G.playing_cards, n, "forge_stk_d")
  elseif id == "stick_hand" then X.stick_random(sid, G.hand and G.hand.cards, n, "forge_stk_h")
  elseif id == "stick_shop" and G.GAME then
    G.GAME.forge_stk_shop = type(G.GAME.forge_stk_shop) == "table" and G.GAME.forge_stk_shop or {}
    G.GAME.forge_stk_shop[sid] = math.max(0, math.min(100, X.shop_bonus(sid) + (tonumber(e.n) or 0)))
  end
  return true
end

function X.doc_lines(fields, add)
  local f = X.fields({fields = fields})
  if f.on ~= "Jokers" then add(string.format(ml("Goes on {C:attention}%s{}"), ml(f.on))) end
  if f.life > 0 then add(string.format(ml("Peels off after {C:attention}%d{} rounds"), f.life)) end
end

X.PER = {en = "card with %s", fr = "carte avec %s", es = "carta con %s"}
X.HAVE = {en = "you have %s {C:attention}%d{} Jokers with %s", fr = "vous avez %s {C:attention}%d{} jokers avec %s", es = "tienes %s {C:attention}%d{} comodines con %s"}
X.CARD = {en = "the card has %s", fr = "la carte a %s", es = "la carta tiene %s"}
X.ONE = {en = "card with {C:attention}%s{}", fr = "carte avec {C:attention}%s{}", es = "carta con {C:attention}%s{}"}
X.GIVE_TEXT = {
  en = {stick_card = "put {C:attention}%s{} on the card", stick_self = "put {C:attention}%s{} on this Joker",
    unstick_card = "remove {C:attention}%s{} from the card", unstick_self = "remove {C:attention}%s{} from this Joker"},
  fr = {stick_card = "colle {C:attention}%s{} sur la carte", stick_self = "colle {C:attention}%s{} sur ce Joker",
