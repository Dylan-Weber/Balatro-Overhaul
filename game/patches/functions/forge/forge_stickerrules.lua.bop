}
X.ANY_TEXT = {en = "any sticker", fr = "n'importe quel autocollant", es = "cualquier pegatina"}
X.SELF_OK = {stick_self = true, unstick_card = true, unstick_self = true}

local function first_own()
  local R = Rules()
  local vals = R and R.own_values("sticker") or {}
  return vals[1] or (St().PREFIX .. "x")
end

function X.text()
  local T = package.loaded["functions/forge/forge_text"]
  if not T then return end
  T.KIND_WHEN_TEXT = T.KIND_WHEN_TEXT or {}
  T.KIND_WHEN_TEXT.sticker = X.WHEN_TEXT
end

function X.rules(R)
  X.text()
  R.HOST_OF.sticker = "sticker"
  local whens = {}
  for _, w in ipairs(R.JOKER_WHEN) do whens[#whens + 1] = w end
  whens[#whens + 1] = "used"
  R.KIND_WHEN.sticker = whens
  R.HOST_WHEN.sticker = whens
  R.STICKERS = X
  local base_give = R.allowed_give
  R.allowed_give = function(when, give, host, ...)
    if host == "sticker" then host = "joker" end
    return base_give(when, give, host, ...)
  end
  local base_only = R.allowed_only
  R.allowed_only = function(when, only, host, ...)
    if host == "sticker" then host = "joker" end
    return base_only(when, only, host, ...)
  end

  local function val_ok(id, v)
    if id == "unstick_card" or id == "unstick_self" then return X.is_value(v) end
    if id == "stick_self" and member(X.VANILLA, v) then return true end
    return R.own_id("sticker", v) ~= nil
  end
  X.val_ok = val_ok
  for _, id in ipairs({"stick_card", "stick_self", "unstick_card", "unstick_self"}) do
    if not R.member(R.GIVE, id) then R.GIVE[#R.GIVE + 1] = id end
    local def = id:sub(1, 2) == "un" and function() return "any" end or id == "stick_self" and function() return R.own_values("sticker")[1] or "eternal" end or first_own
    R.DEFAULT_GIVE[id] = function() return {id = id, v = def()} end
    R.CLEAN_GIVE[id] = function(e)
      if not val_ok(id, e.v) then e.v = def() end
      e.n = nil
    end
    R.TEXT_GIVE[id] = function(g, s, lang)
      local name = g.v == "any" and (X.ANY_TEXT[lang] or X.ANY_TEXT.en) or X.label(g.v)
      return string.format((X.GIVE_TEXT[lang] or X.GIVE_TEXT.en)[id], name)
    end
    R.SIMPLE_GIVE[id] = true
  end
  R.GIVE_WHEN.stick_card = {card_scored = true, card_held = true, discard = true}
  R.GIVE_WHEN.unstick_card = {card_scored = true, card_held = true, discard = true}
  R.HOST_GIVE.stick_self = {joker = true}
  R.HOST_GIVE.unstick_self = {joker = true}
  R.LABEL_GIVE.stick_card, R.LABEL_GIVE.stick_self = "Put a sticker on the card", "Put a sticker on this Joker"
  R.LABEL_GIVE.unstick_card, R.LABEL_GIVE.unstick_self = "Remove a sticker from the card", "Remove a sticker from this Joker"
  R.VALUES_GIVE = R.VALUES_GIVE or {}
  local function opts_of(list)
    return function()
      local out = {}
      for _, v in ipairs(list()) do out[#out + 1] = {label = X.label(v), value = v} end
      return out
    end
  end
  R.VALUES_GIVE.stick_card = opts_of(function() return R.own_values("sticker") end)
  R.VALUES_GIVE.stick_self = opts_of(function()
    local out = {}
    for _, v in ipairs(X.VANILLA) do out[#out + 1] = v end
    for _, v in ipairs(R.own_values("sticker")) do out[#out + 1] = v end
    return out
  end)
  R.VALUES_GIVE.unstick_card, R.VALUES_GIVE.unstick_self = opts_of(X.values), opts_of(X.values)
  R.NUM_LABEL = R.NUM_LABEL or {}
  for _, id in ipairs({"stick_card", "stick_self", "unstick_card", "unstick_self"}) do
    R.NUM_LABEL[id] = function(g) return ml(R.LABEL_GIVE[id]) .. ": " .. X.label(g.v) end
  end
  R.DOS.stick_card = function(g, card, src, context, other)
    local target = other or (context and context.other_card)
    local sid = R.own_id("sticker", g.v)
    if not (target and sid and target.ability) or St().has(target, sid) then return end
    if St().apply(target, sid) then
      G.E_MANAGER:add_event(Event({func = function() target:juice_up(0.3, 0.4); return true end}))
      R.status(src, ml("Sticker!"), G.C.FILTER)
    end
  end
  R.DOS.stick_self = function(g, card, src, context)
    if context and context.blueprint then return end
    if not (card and card.ability and val_ok("stick_self", g.v)) then return end
    if X.put(card, g.v) then R.status(src, ml("Sticker!"), G.C.FILTER) end
  end
  R.DOS.unstick_card = function(g, card, src, context, other)
    local target = other or (context and context.other_card)
    if not (target and target.ability and X.is_value(g.v)) then return end
    if X.take(target, g.v) then
      G.E_MANAGER:add_event(Event({func = function() target:juice_up(0.3, 0.4); return true end}))
      R.status(src, ml("Peeled!"), G.C.FILTER)
    end
  end
  R.DOS.unstick_self = function(g, card, src, context)
    if context and context.blueprint then return end
    if not (card and card.ability and X.is_value(g.v)) then return end
    if X.take(card, g.v) then R.status(src, ml("Peeled!"), G.C.FILTER) end
  end

  for _, id in ipairs({"card_sticker", "jokers_sticker"}) do
    if not R.member(R.ONLY, id) then R.ONLY[#R.ONLY + 1] = id end
    R.FILTER_ONLY[id] = true
  end
  R.CARD_ONLY = R.CARD_ONLY or {}
  R.CARD_ONLY.card_sticker = true
  R.NUM.jokers_sticker = {def = 1, lo = 0, hi = 100, step = 1, big = 5}
  R.DEFAULT_ONLY.card_sticker = function() return {id = "card_sticker", v = "any"} end
  R.DEFAULT_ONLY.jokers_sticker = function() return {id = "jokers_sticker", v = "any", op = "at_least", n = 1} end
  R.CLEAN_ONLY.card_sticker = function(c)
    if not X.is_value(c.v) then c.v = "any" end
    c.op, c.n = nil, nil
  end
  R.CLEAN_ONLY.jokers_sticker = function(c)
    if not X.is_value(c.v) then c.v = "any" end
    c.op = c.op or "at_least"
  end
  R.CHECKS.card_sticker = function(o, context, card, other)
    local target = other or (context and (context.other_card or context.consumeable))
    if R.cur_host == "card" and context and context.forge_self then target = context.forge_self end
    return X.has(target, o.v)
  end
  R.CHECKS.jokers_sticker = function(o) return R.compare(o.op, X.count(o.v, true), o.n) end
  R.TEXT_ONLY.card_sticker = function(o, s, lang) return string.format(X.CARD[lang] or X.CARD.en, "{C:attention}" .. X.label(o.v) .. "{}") end
  R.TEXT_ONLY.jokers_sticker = function(o, s, lang)
    local op = (s and (s[o.op or "at_least"] or s.at_least)) or ""
    return string.format(X.HAVE[lang] or X.HAVE.en, op, tonumber(o.n) or 0, "{C:attention}" .. X.label(o.v) .. "{}")
  end
  R.LABEL_ONLY.card_sticker, R.LABEL_ONLY.jokers_sticker = "The card has a sticker", "Jokers with a sticker"
  local base_filter = R.filter_values
  R.filter_values = function(id)
    if id == "card_sticker" or id == "jokers_sticker" then return X.values() end
    return base_filter(id)
  end
  local base_flabel = R.FILTER_LABEL
  R.FILTER_LABEL = function(id, v)
    if (id == "card_sticker" or id == "jokers_sticker" or id == "stickered") and X.is_value(v) then return X.label(v) end
    return base_flabel and base_flabel(id, v) or nil
  end

  if not R.member(R.COUNTS, "stickered") then R.COUNTS[#R.COUNTS + 1] = "stickered" end
  R.COUNT_MATCH.stickered = true
  R.COUNT.stickered = function(g) return X.count(g.m) end
  if R.LABEL_COUNT then R.LABEL_COUNT.stickered = "Card with a sticker" end
  for lang, t in pairs(R.PER_TEXT or {}) do
    if type(t) == "table" and type(t.counts) == "table" then t.counts.stickered = X.PER[lang] or X.PER.en end
  end
  local base_matches = R.count_matches
  R.count_matches = function(per)
    if per == "stickered" then return X.values() end
    return base_matches(per)
  end
  local base_one = R.one_label
  R.one_label = function(v, lang, ...)
    if X.is_value(v) and (v == "any" or X.VANILLA_LABEL[v] or R.own_id("sticker", v)) then return string.format(X.ONE[lang] or X.ONE.en, X.label(v)) end
    return base_one(v, lang, ...)
  end
  local base_m = R.count_m_label
  if base_m then
    R.count_m_label = function(per, m, lang)
      if per == "stickered" then return string.format(X.ONE[lang] or X.ONE.en, X.label(m)) end
      return base_m(per, m, lang)
    end
  end
  for _, id in ipairs({"chips_per", "mult_per", "xmult_per", "money_per", "gain_mult_per", "gain_xmult_per"}) do
    local fn = R.CLEAN_GIVE[id]
    if type(fn) == "function" then
      R.CLEAN_GIVE[id] = function(e, ...)
        local m, per = type(e) == "table" and e.m, type(e) == "table" and e.per
        local r = fn(e, ...)
        if per == "stickered" and X.is_value(m) then e.per, e.m = per, m end
        return r
      end
    end
  end
  local base_need = R.need_v
  R.need_v = function(rules, vars)
    local need = base_need(rules, vars)
    for _, r in ipairs(type(rules) == "table" and rules or {}) do
      for _, k in ipairs({"give", "alt", "only"}) do
        for _, g in ipairs(type(r) == "table" and type(r[k]) == "table" and r[k] or {}) do
          if type(g) == "table" and (g.per == "stickered" or g.id == "card_sticker" or g.id == "jokers_sticker" or g.id == "stick_card" or g.id == "stick_self" or X.RUN[g.id]) then need = math.max(need, X.V) end
          if type(g) == "table" and (g.id == "unstick_card" or g.id == "unstick_self") then need = math.max(need, X.V) end
        end
      end
    end
    return need
  end
end

function X.cat(Cat, n, run)
  local list = {
    run("stick_joker", "Sticker on random Jokers", n(1, 100, 1), "Puts {C:attention}%s{} on {C:attention}%s{} random Jokers", {v = "jsticker", args = {"v", "n"}, line1 = "Puts {C:attention}%s{} on a random Joker", simple = true, need = X.V}),
    run("stick_deck", "Sticker on random deck cards", n(1, 500, 5), "Puts {C:attention}%s{} on {C:attention}%s{} random cards in your deck", {v = "sticker", args = {"v", "n"}, need = X.V}),
    run("stick_hand", "Sticker on random cards in hand", n(1, 100, 1), "Puts {C:attention}%s{} on {C:attention}%s{} random cards in hand", {v = "sticker", args = {"v", "n"}, need = X.V}),
    run("unstick_joker", "Remove a sticker from Jokers", n(1, 100, 1), "Removes {C:attention}%s{} from {C:attention}%s{} random Jokers",
      {v = "anysticker", args = {"v", "n"}, line1 = "Removes {C:attention}%s{} from a random Joker", need = X.V}),
    run("unstick_deck", "Remove a sticker from deck cards", n(1, 500, 5), "Removes {C:attention}%s{} from {C:attention}%s{} random cards in your deck",
      {v = "anysticker", args = {"v", "n"}, need = X.V}),
    run("unstick_hand", "Remove a sticker from cards in hand", n(1, 100, 1), "Removes {C:attention}%s{} from {C:attention}%s{} random cards in hand",
      {v = "anysticker", args = {"v", "n"}, need = X.V}),
    run("stick_shop", "Sticker on shop cards", n(1, 100, 20, 5, "%"), "{C:attention}%s{} on {C:attention}%s{} more shop cards", {v = "sticker", args = {"v", "n"}, need = X.V}),
  }
  for _, e in ipairs(list) do Cat.RUN[#Cat.RUN + 1] = e end
  local function add(l, e)
    if not l then return end
    for _, x in ipairs(l) do if x.id == e.id then return end end
    local c = {}
    for k, v in pairs(e) do c[k] = v end
    l[#l + 1] = c
  end
  local function plain(e)
    local c = {}
    for k, v in pairs(e) do c[k] = v end
    c.run = nil
    return c
  end
  for _, e in ipairs(list) do
    for _, k in ipairs({"voucher", "deck", "stake", "challenge"}) do add(Cat.EFFECTS[k], e) end
    if e.id ~= "stick_shop" then
      for _, k in ipairs({"use", "spectral", "tag"}) do add(Cat.EFFECTS[k], plain(e)) end
    end
  end
  add(Cat.EFFECTS.boss, list[3])
  add(Cat.EFFECTS.challenge, {id = "ch_joker_sticker", label = "Sticker on the last starting Joker", v = "sticker", line = "The last starting Joker has {C:attention}%s{}", new = true, need = X.V})
  local k = Cat.BY_ID.sticker
  if k then
    local have = {}
    for _, f in ipairs(k.fields or {}) do have[f.id] = true end
    if not have.on then
      table.insert(k.fields, {id = "on", label = "Goes on", type = "choice", options = X.ON, def = "Jokers"})
      table.insert(k.fields, {id = "life", label = "Lasts rounds", type = "num", num = n(0, 100, 0)})
    end
  end
  for _, e in ipairs(Cat.EFFECTS.sticker or {}) do
    if e.id == "times" then e.label = "Joker scores more" end
  end
end

function X.install()
  if X.hooked then return end
  local okh, Hooks = pcall(require, "overhaul.hooks")
  if not (okh and Hooks) then return end
  X.hooked = true
  X.text()
  local H = Hr() or require("functions/forge/forge_hostrules")
  if H and H.items_on and not H.forge_stk_wrapped then
    H.forge_stk_wrapped = true
    local base = H.items_on
    H.items_on = function(card)
      local out = base(card)
      if card and card.ability and not card.debuff and St().any(card) and (card.ability.set == "Default" or card.ability.set == "Enhanced") then
        local ok, its = pcall(X.card_items, card)
        if ok then for _, it in ipairs(its) do out[#out + 1] = it end end
      end
      return out
    end
  end
  Hooks.wrap("Card", "use_consumeable", function(orig) return function(self, ...)
    local r = orig(self, ...)
    if St().any(self) then
      local ok, err = pcall(X.used, self)
      if not ok then print("[FORGE] sticker use failed: " .. tostring(err)) end
    end
    return r
  end end, {id = "forge_stickerrules.use"})
  Hooks.wrap("Game", "start_run", function(orig) return function(self, args, ...)
    local r = orig(self, args, ...)
    local ch = type(args) == "table" and args.challenge
    if type(ch) == "table" and type(ch.jokers) == "table" then
      for k, v in ipairs(ch.jokers) do
        if type(v) == "table" and v.forge_stk then
r 3 617 %20%20%20%20%20%20%20%20%20%20 -
l 83
            local j = G.jokers and G.jokers.cards[k]
            if j then St().apply(j, v.forge_stk) end
            return true
          end}))
        end
      end
    end
    return r
  end end, {id = "forge_stickerrules.start"})
  if type(end_round) == "function" then
    local orig = end_round
    end_round = function(...)
      pcall(X.round_end_all)
      return orig(...)
    end
  end
end

