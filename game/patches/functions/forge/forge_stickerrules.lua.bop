local X = {}

X.V = 16
X.ON = {"Jokers", "Playing cards", "Consumables", "Any card"}
X.VANILLA = {"eternal", "perishable", "rental"}
X.RUN = {stick_joker = true, stick_deck = true, stick_hand = true, stick_shop = true, unstick_joker = true, unstick_deck = true, unstick_hand = true}
X.WHEN_TEXT = {
  card_scored = "When a card scores (on a card: this card)", card_held = "When a card is held (on a card: this card)",
  discard = "When a card is discarded (on a card: this card)", used = "When this card is used",
}

local function St() return require("functions/forge/forge_stickers") end
local function Rules() return package.loaded["functions/forge/forge_rules"] end
local function Hr() return package.loaded["functions/forge/forge_hostrules"] end
local function ml(s) return mod_loc and mod_loc(s) or s end

local function member(t, v)
  for _, x in ipairs(t or {}) do if x == v then return true end end
  return false
end

function X.fields(c)
  local f = type(c) == "table" and type(c.fields) == "table" and c.fields or {}
  local life = tonumber(f.life)
  if not life or life ~= life then life = 0 end
  return {on = member(X.ON, f.on) and f.on or "Jokers", life = math.max(0, math.min(1000, math.floor(life)))}
end

function X.card_kind(card)
  local ab = type(card) == "table" and card.ability
  if not ab then return nil end
  if ab.set == "Joker" then return "Jokers" end
  if ab.set == "Default" or ab.set == "Enhanced" then return "Playing cards" end
  if ab.consumeable or ab.set == "Tarot" or ab.set == "Planet" or ab.set == "Spectral" then return "Consumables" end
  return nil
end

function X.fits(c, card)
  local kind = X.card_kind(card)
  if not kind then return false end
  local on = X.fields(c).on
  return on == "Any card" or on == kind
end

function X.own_value(id) return St().PREFIX .. tostring(id) end

function X.is_value(v)
  if v == "any" or member(X.VANILLA, v) then return true end
  local R = Rules()
  return R and R.own_id("sticker", v) ~= nil or false
end

function X.values()
  local out = {"any"}
  for _, v in ipairs(X.VANILLA) do out[#out + 1] = v end
  local R = Rules()
  for _, v in ipairs(R and R.own_values("sticker") or {}) do out[#out + 1] = v end
  return out
end

X.VANILLA_LABEL = {eternal = "Eternal", perishable = "Perishable", rental = "Rental"}

function X.label(v)
  if v == "any" then return ml("Any sticker") end
  if X.VANILLA_LABEL[v] then
    local L = G and G.localization and G.localization.descriptions and G.localization.descriptions.Other
    local e = L and L[v]
    return e and e.name or ml(X.VANILLA_LABEL[v])
  end
  local R = Rules()
  return R and R.own_label("sticker", v) or tostring(v)
end

function X.has(card, v)
  local ab = type(card) == "table" and card.ability
  if not ab then return false end
  if v == "any" then return St().any(card) or ab.eternal == true or ab.perishable == true or ab.rental == true end
  if member(X.VANILLA, v) then return ab[v] == true end
  local R = Rules()
  local id = R and R.own_id("sticker", v)
  return id ~= nil and St().has(card, id)
end

local function all_cards()
  local out = {}
  for _, area in ipairs({G.jokers, G.consumeables}) do
    for _, c in ipairs(area and area.cards or {}) do out[#out + 1] = c end
  end
  for _, c in ipairs(G.playing_cards or {}) do out[#out + 1] = c end
  return out
end

function X.count(v, only_jokers)
  local n = 0
  for _, c in ipairs(only_jokers and (G.jokers and G.jokers.cards or {}) or all_cards()) do
    if X.has(c, v) then n = n + 1 end
  end
  return n
end

function X.fixed_rules(c)
  local fx = St().effects(c)
  local out = {}
  local give = {}
  if fx.chips and fx.chips ~= 0 then give[#give + 1] = {id = "chips", n = fx.chips} end
  if fx.mult and fx.mult ~= 0 then give[#give + 1] = {id = "mult", n = fx.mult} end
  if fx.xmult and fx.xmult ~= 1 then give[#give + 1] = {id = "xmult", n = fx.xmult} end
  if #give > 0 then out[#out + 1] = {when = "card_scored", only = {}, give = give} end
  if fx.round_money and fx.round_money ~= 0 then out[#out + 1] = {when = "round_end", only = {}, give = {{id = "money", n = fx.round_money}}} end
  return out
end

function X.rules_of(c)
  return type(c) == "table" and type(c.rules) == "table" and #c.rules > 0 and c.rules or nil
end

function X.card_items(card)
  local out = {}
  for _, s in ipairs(St().all_of(card)) do
    local it = X.item_of(s)
    if it then out[#out + 1] = it end
  end
  return out
end

function X.card_item(card)
  local s = St().of_card(card)
  if not s then return nil end
  return X.item_of(s)
end

function X.item_of(s)
  local list = {}
  for _, r in ipairs(X.fixed_rules(s.c)) do list[#list + 1] = r end
  for _, r in ipairs(X.rules_of(s.c) or {}) do list[#list + 1] = r end
  if #list == 0 then return nil end
  return {c = {id = s.id, kind = "sticker", rules = list, vars = s.c.vars, enabled = true}, key = "k_" .. s.id}
end

function X.merge(card, r, s)
  if type(s) ~= "table" then return r end
  if type(r) ~= "table" then return s end
  if s.repetitions then
    r.repetitions = (r.repetitions or 0) + s.repetitions
    r.message, r.card = r.message or s.message, r.card or s.card
    return r
  end
  if rawget(_G, "SMODS") then
    local t, n = r, 0
    while type(t.extra) == "table" and n < 20 do t, n = t.extra, n + 1 end
    t.extra = s
    return r
  end
  for _, k in ipairs({"chip_mod", "mult_mod", "chips", "mult", "h_mult", "h_chips", "dollars", "p_dollars"}) do
    if type(s[k]) == "number" then r[k] = (tonumber(r[k]) or 0) + s[k] end
  end
  for _, k in ipairs({"Xmult_mod", "Xchip_mod", "x_mult", "x_chips"}) do
    if type(s[k]) == "number" then r[k] = (tonumber(r[k]) or 1) * s[k] end
  end
  if s.message ~= nil then
    if r.message ~= nil and card_eval_status_text then
      pcall(card_eval_status_text, s.card or card, "extra", nil, nil, nil, {message = s.message, colour = s.colour})
    else
      r.message, r.colour = s.message, s.colour
    end
  end
  for k, v in pairs(s) do if r[k] == nil then r[k] = v end end
  return r
end

function X.run_rules(card, context, s)
  local R = Rules()
  local H = Hr()
  local rules = R and X.rules_of(s.c)
  if not (rules and H) then return nil end
  local key = "k_" .. s.id
  return R.calculate(card, context, R.clean_rules(rules, "sticker"), R.clean_vars(s.c.vars), {state = H.card_state(card, key), host = "joker", seed = "forge_" .. key})
end

function X.joker(card, context, r)
  if not (card.ability and card.ability.set == "Joker") then return r end
  for _, s in ipairs(St().all_of(card)) do
    if X.rules_of(s.c) then
      local ok, out = pcall(X.run_rules, card, context, s)
      if not ok then print("[FORGE] sticker rules failed: " .. tostring(out)) else r = X.merge(card, r, out) end
    end
  end
  return r
end

function X.used(card)
  for _, s in ipairs(St().all_of(card)) do
    if X.rules_of(s.c) then X.run_rules(card, {forge_when = "used", consumeable = card}, s) end
  end
end

local function status(card, msg, colour)
  if card and card_eval_status_text then pcall(card_eval_status_text, card, "extra", nil, nil, nil, {message = msg, colour = colour or G.C.FILTER}) end
end

function X.peel(card, id)
  St().remove(card, id or card.ability.forge_stk)
  if card.set_cost then pcall(card.set_cost, card) end
  status(card, ml("Peeled!"))
end

function X.tick(card)
  if not (card and card.ability) then return false end
  local peeled = false
  for _, id in ipairs(St().ids(card)) do
    local life = tonumber(St().get(card, id, "life"))
    if life then
      life = life - 1
      if life <= 0 then
        X.peel(card, id)
        peeled = true
      else
        St().set(card, id, "life", life)
      end
    end
  end
  return peeled
end

function X.round_end_other(card)
  local list = St().all_of(card)
  if #list == 0 or not G.GAME then return end
  local round = G.GAME.round or 0
  if card.ability.forge_stk_round == round then return end
  card.ability.forge_stk_round = round
  local fx = St().effects_on(card)
  local kind = X.card_kind(card)
  if kind == "Consumables" then
    local R = Rules()
    local pay = fx.round_money and R and R.money_cut and R.money_cut(fx.round_money) or fx.round_money
    if pay and pay ~= 0 then
      ease_dollars(pay)
      status(card, (pay > 0 and "$" or "-$") .. math.abs(pay), pay > 0 and G.C.MONEY or G.C.RED)
    end
    if fx.sell_gain and fx.sell_gain ~= 0 then
      card.ability.extra_value = (card.ability.extra_value or 0) + fx.sell_gain
      card:set_cost()
      status(card, localize("k_val_up"), G.C.MONEY)
    end
    for _, s in ipairs(list) do
      if X.rules_of(s.c) then pcall(X.run_rules, card, {end_of_round = true}, s) end
    end
  end
  for _, s in ipairs(list) do
    local rl = St().effects(s.c).rounds_left
    local left = rl and (tonumber(St().get(card, s.id, "left")) or rl) - 1
    if left then St().set(card, s.id, "left", left) end
    if left and left <= 0 then
      status(card, localize("k_extinct_ex"))
      G.E_MANAGER:add_event(Event({trigger = "after", delay = 0.3, func = function()
        if not card.removed then
          if kind == "Playing cards" then
            card:start_dissolve()
            local H = Hr()
            if H and H.notify_removed then pcall(H.notify_removed, {card}) end
          else card:start_dissolve() end
        end
        return true
      end}))
      return
    end
  end
  X.tick(card)
end

function X.round_end_all()
  local list = {}
  for _, c in ipairs(G.consumeables and G.consumeables.cards or {}) do list[#list + 1] = c end
  for _, c in ipairs(G.playing_cards or {}) do list[#list + 1] = c end
  for _, c in ipairs(list) do
    if St().any(c) and not c.removed then
      local ok, err = pcall(X.round_end_other, c)
      if not ok then print("[FORGE] sticker round end failed: " .. tostring(err)) end
    end
  end
end

local function pick(pool, n, seed)
  local out = {}
  local left = {}
  for i, c in ipairs(pool) do left[i] = c end
  for _ = 1, math.min(n, #left) do
    local c, i = pseudorandom_element(left, pseudoseed(seed))
    out[#out + 1] = c
    table.remove(left, i)
  end
  return out
end

function X.put(card, v)
  local ab = type(card) == "table" and card.ability
  if not ab or card.removed then return false end
  if member(X.VANILLA, v) then
    if ab[v] or X.card_kind(card) ~= "Jokers" then return false end
    if v == "eternal" then
      if ab.perishable or not card.set_eternal then return false end
