local Mods = require("functions/forge/forge_mods")
local json = require("bot.sim.json")

local O = {}

O.MAX_BYTES = 512 * 1024
O.TIMEOUT = 12
O.OWNERS = "forge/owners.json"
O.MAX_KEYS = 8
O.SETTINGS_FILES = {"settings.jkr", "modded_settings.jkr"}
O.PLAYED = "forge/played.json"
O.SORTS = {featured = "theme", best = "best", played = "played", all = "new"}
O.state = O.state or {status = "idle", page = 1, tab = "all", data = nil, msg = nil, busy = {}}
O.state.want = O.state.want or {}

local function touch() return UIK.touch() end
local function core() return rawget(_G, "bom_core") end

local function fit_scale(label, w, scale)
  local lw = UIK.text_w(label, scale)
  if lw > w - 0.25 then return scale * (w - 0.25) / lw end
  return scale
end

function O.connected()
  local c = core()
  return c and c.is_connected and c.is_connected() or false
end

function O.with_connection(go, fail)
  local m = rawget(_G, "mpm_menu") or (rawget(_G, "MP") and MP.menu)
  if m and m.with_connection then return m.with_connection(go, fail) end
  if O.connected() then return go() end
  local c = core()
  if c and c.connect then return c.connect(go, {silent = true, on_fail = fail}) end
  if fail then fail() end
end

function O.valid_key(k)
  return type(k) == "string" and #k == 24 and k:match("^[A-Za-z0-9]+$") ~= nil
end

function O.merge_keys(cur, ...)
  local out, seen = {}, {}
  if cur then seen[cur] = true end
  for i = 1, select("#", ...) do
    local list = select(i, ...)
    for _, k in ipairs(type(list) == "table" and list or {}) do
      if O.valid_key(k) and not seen[k] and #out < O.MAX_KEYS then
        seen[k] = true
        out[#out + 1] = k
      end
    end
  end
  return out
end

local function sfs() return love.mod_filesystem or love.filesystem end

function O.owner_keys()
  local f = sfs()
  local raw = f and f.getInfo(O.OWNERS) and f.read(O.OWNERS)
  local ok, t = pcall(json.decode, raw or "")
  return ok and type(t) == "table" and type(t.keys) == "table" and t.keys or {}
end

function O.settings_keys()
  local out = {}
  local f = sfs()
  for _, name in ipairs(O.SETTINGS_FILES) do
    local ok, k = pcall(function()
      local raw = f and f.getInfo(name) and f.read(name)
      local unpack_table = rawget(_G, "get_table_from_string")
      local t = raw and unpack_table and unpack_table(raw)
      return type(t) == "table" and t.mp_player_key or nil
    end)
    if ok and O.valid_key(k) then out[#out + 1] = k end
  end
  return out
end

function O.remember(k, more)
  if not O.valid_key(k) then return end
  local list = O.owner_keys()
  local first = {k}
  for _, x in ipairs(list) do if x == k then first = {} end end
  local keys = O.merge_keys(nil, first, list, more)
  local same = #keys == #list
  for i = 1, #keys do same = same and keys[i] == list[i] end
  if same then return end
  local ok, raw = pcall(json.encode, {v = 1, keys = keys})
  local f = sfs()
  if ok and f then
    if not f.getInfo("forge") then pcall(f.createDirectory, "forge") end
    pcall(f.write, O.OWNERS, raw)
  end
end

function O.alt_keys(cur)
  return O.merge_keys(cur, O.owner_keys(), O.settings_keys())
end

function O.send(msg)
  local c = core()
  if not (c and c.send) then return false end
  msg.pkey = c.player_key and c.player_key() or nil
  if msg.pkey then
    local ok, alts = pcall(O.alt_keys, msg.pkey)
    if ok and #alts > 0 then msg.keys = alts end
    pcall(O.remember, msg.pkey, ok and alts or nil)
  end
  return c.send(msg)
end

local function is_open() return G.OVERLAY_MENU and UIK and UIK._win and UIK._win.id == "forge_online" end

local function refresh()
  if is_open() then pcall(UIK.refresh) end
end

local function forged_open()
  return G.OVERLAY_MENU and G.MODS_MENU and G.MODS_MENU.tab == "forge" and G.OVERLAY_MENU:get_UIE_by_ID("forge_mods_forge_mods_import") ~= nil
end

local function say(text, colour) O.state.msg = {text = text, colour = colour} end

local function after(delay, fn)
  G.E_MANAGER:add_event(Event({trigger = "after", delay = delay, timer = "REAL", blockable = false, blocking = false, no_delete = true, func = function() fn() return true end}))
end

O.WHY = {
  not_json = "The server could not read it: the file is damaged.",
  bad_format = "The server could not read it: this is not a Forge mod file.",
  bad_version = "The server does not know this file version yet. Update the game.",
  bad_id = "The server refused it: the mod id is not valid.",
  bad_jokers = "The server refused it: its joker list is damaged.",
  bad_creations = "The server refused it: its creation list is damaged.",
  bad_joker = "The server refused it: one of its jokers is damaged.",
  bad_kind = "The server refused it: one of its creations has an unknown kind.",
  bad_files = "The server refused it: its pictures are damaged.",
  bad_art = "The server refused it: one of its pictures is not a PNG.",
  bad_art_name = "The server refused it: one of its pictures has a bad name.",
  art_too_big = "The server refused it: one of its pictures is too big.",
  too_many_files = "The server refused it: it has too many pictures.",
  empty = "There is nothing in it to publish.",
  too_many = "It has too many cards to publish (60 at most).",
}

function O.err_text(reason, why)
  if type(why) == "string" and O.WHY[why] then return mod_loc(O.WHY[why]) end
  if reason == "empty" or reason == "too_many" then return mod_loc(O.WHY[reason]) end
  if reason == "too_soon" then return mod_loc("Wait a few seconds before publishing again.") end
  if reason == "theme_full" then return mod_loc("You already have 3 mods in this week's theme.") end
  if reason == "taken" then return mod_loc("Someone else already published a mod with this id.") end
  if reason == "too_many_mods" then return mod_loc("You already have 20 mods online.") end
  if reason == "too_big" then return mod_loc("It is too big to publish (512 KB at most).") end
  if reason == "bad_art" then return mod_loc(O.WHY.bad_art) end
  if reason == "not_forge" then return mod_loc("The server did not accept this file.") end
  if reason == "busy" then return mod_loc("The server is busy with this mod. Try again.") end
  if reason == "no_key" or reason == "bot" then return mod_loc("Your profile is not ready to publish yet. Open Multiplayer once, then try again.") end
  if reason == "gone" then return mod_loc("This mod is not online any more.") end
  if reason == "not_played" then return mod_loc("Play a run with it first, then you can rate it.") end
  if reason == "not_yours" or reason == "own" then return mod_loc("You cannot do that with this mod.") end
  return mod_loc("Could not reach the server.")
end

function O.browse(page)
  local S = O.state
  S.status, S.page = "loading", page or S.page or 1
  local token = {}
  S.token = token
  O.with_connection(function()
    if not O.send({type = "forge_browse", page = S.page, mine = S.tab == "mine", sort = O.SORTS[S.tab]}) then S.status = "offline"; refresh() end
    pcall(O.flush_played)
  end, function()
    S.status = "offline"
    refresh()
  end)
  after(O.TIMEOUT, function()
    if S.token == token and S.status == "loading" then S.status = "offline"; refresh() end
  end)
end

function O.on_list(d)
  local S = O.state
  if type(d) ~= "table" then return end
  S.data = {mods = type(d.mods) == "table" and d.mods or {}, page = tonumber(d.page) or 1, pages = tonumber(d.pages) or 1, total = tonumber(d.total) or 0}
  S.data.theme = type(d.theme) == "table" and d.theme or nil
  S.page = S.data.page
  S.status = d.error and "offline" or "ready"
  refresh()
end

function O.get(id)
  O.state.busy[id] = true
  O.with_connection(function() O.send({type = "forge_get", id = id}) end, function()
    O.state.busy[id] = nil
    say(O.err_text("unavailable"), G.C.RED)
    refresh()
  end)
  after(O.TIMEOUT * 2, function()
    if O.state.busy[id] then O.state.busy[id] = nil; say(O.err_text("unavailable"), G.C.RED); refresh() end
  end)
  refresh()
end

function O.on_mod(d)
  if type(d) ~= "table" then return end
  if O.claim and O.claim(d) then return end
  local id = type(d.id) == "string" and d.id or ""
  O.state.busy[id] = nil
  local want = O.state.want[id]
  O.state.want[id] = nil
  if not d.ok or type(d.mod) ~= "string" then
    say(O.err_text(d.reason), G.C.RED)
  else
    local mod, err = Mods.install(d.mod, {mine = d.mine == true or (want and want.mine) or nil})
    if mod and want and want.edit then
      if play_sound then play_sound("card1", 1.1, 0.6) end
      return O.edit(mod.id, want.edit)
    elseif mod and want and want.remix and not mod.mine then
      return O.start_remix(mod.id)
    elseif mod then
      say(string.format(mod_loc("Installed %s. It is in Forged."), mod.name), G.C.GREEN)
      if play_sound then play_sound("card1", 1.1, 0.6) end
      if is_open() then O.browse(O.state.page) end
    else
      local MU = rawget(_G, "ForgeModsUI")
      say(MU and MU.err_text(err) or tostring(err), G.C.RED)
    end
  end
  refresh()
end

function O.publish(mod_id, opts)
  opts = type(opts) == "table" and opts or {}
  local mod = Mods.get(mod_id)
  local MU = rawget(_G, "ForgeModsUI")
  local function tell(text, colour)
    if MU then MU.state.msg = {text = text, colour = colour} end
    if forged_open() and MU and MU.reopen_mods then MU.reopen_mods() end
  end
  if not mod then return end
  local raw = mod.file and love.filesystem.getInfo(mod.file) and love.filesystem.read(mod.file)
  if type(raw) ~= "string" then return tell(mod_loc("Could not read the file."), G.C.RED) end
  if #raw > O.MAX_BYTES then return tell(O.err_text("too_big"), G.C.RED) end
  O.state.publishing = mod_id
  O.state.publish_raw, O.state.publish_retried = raw, false
  O.state.publish_theme = opts.theme and true or nil
  O.with_connection(function()
    if not O.send({type = "forge_publish", mod = raw, theme = opts.theme and true or nil}) then
      O.state.publishing = nil
      tell(O.err_text("unavailable"), G.C.RED)
    end
  end, function()
    O.state.publishing = nil
    tell(O.err_text("unavailable"), G.C.RED)
  end)
  after(O.TIMEOUT * 2, function()
    if O.state.publishing == mod_id then O.state.publishing = nil; tell(O.err_text("unavailable"), G.C.RED) end
  end)
  tell(string.format(mod_loc("Publishing %s..."), mod.name), G.C.UI.TEXT_LIGHT)
end

function O.on_published(d)
  if type(d) ~= "table" then return end
  local id = O.state.publishing
  if id and not d.ok and d.reason == "not_forge" and d.why == nil and not O.state.publish_retried then
    local old = Mods.for_old_server(O.state.publish_raw)
    if old then
      O.state.publish_retried = true
      if O.send({type = "forge_publish", mod = old, theme = O.state.publish_theme}) then return end
    end
  end
  O.state.publishing, O.state.publish_raw, O.state.publish_theme = nil, nil, nil
  local mod = id and Mods.get(id)
  local MU = rawget(_G, "ForgeModsUI")
  local text, colour
  if d.ok and d.theme then
    text, colour = string.format(mod_loc("%s is in this week's theme. Good luck!"), mod and mod.name or tostring(d.id)), G.C.GREEN
    if play_sound then play_sound("card1", 1.1, 0.6) end
  elseif d.ok then
    text, colour = string.format(mod_loc("%s is online. Anyone can get it in Browse online."), mod and mod.name or tostring(d.id)), G.C.GREEN
    if play_sound then play_sound("card1", 1.1, 0.6) end
  else
    text, colour = O.err_text(d.reason, d.why), G.C.RED
  end
  if MU then MU.state.msg = {text = text, colour = colour} end
  if forged_open() and MU and MU.reopen_mods then MU.reopen_mods() end
  if is_open() then
    say(text, colour)
    O.browse(O.state.page)
  end
end

function O.report(id, reason)
  O.with_connection(function() O.send({type = "forge_report", id = id, reason = reason}) end, function()
    say(O.err_text("unavailable"), G.C.RED)
    refresh()
  end)
end

function O.on_reported(d)
  if type(d) ~= "table" then return end
  if d.ok then say(mod_loc("Thanks. The mod is hidden once several players report it."), G.C.GREEN) else say(O.err_text(d.reason), G.C.RED) end
  refresh()
end

function O.unpublish(id)
  O.with_connection(function() O.send({type = "forge_unpublish", id = id}) end, function()
    say(O.err_text("unavailable"), G.C.RED)
    refresh()
  end)
end

function O.edit(id, online_version)
  local MU = rawget(_G, "ForgeModsUI")
  local mod = Mods.get(id)
  if not (MU and MU.open_export and mod) then return end
  MU.open_export(id, "online", {version = tonumber(online_version) or 1, publish = true})
end

function O.update(id, online_version)
  local mod = Mods.get(id)
  if mod and mod.mine then return O.edit(id, online_version) end
  O.state.want[id] = {mine = true, edit = tonumber(online_version) or 1}
  O.state.msg = nil
  O.get(id)
end

function O.on_unpublished(d)
  if type(d) ~= "table" then return end
  if d.ok then say(mod_loc("It is not online any more. Your copy stays in Forged."), G.C.UI.TEXT_LIGHT) else say(O.err_text(d.reason), G.C.RED) end
  O.browse(O.state.page)
end

function O.rate(id, stars)
  O.state.rating = id
  O.with_connection(function()
    if not O.send({type = "forge_rate", id = id, stars = stars}) then O.state.rating = nil; say(O.err_text("unavailable"), G.C.RED); refresh() end
  end, function()
    O.state.rating = nil
    say(O.err_text("unavailable"), G.C.RED)
    refresh()
  end)
  after(O.TIMEOUT, function()
    if O.state.rating == id then O.state.rating = nil; say(O.err_text("unavailable"), G.C.RED); refresh() end
  end)
end

function O.on_rated(d)
  if type(d) ~= "table" then return end
  O.state.rating = nil
  if d.ok then
    for _, m in ipairs(O.state.data and O.state.data.mods or {}) do
      if m.id == d.id then m.my, m.rating, m.votes = tonumber(d.stars), tonumber(d.rating) or m.rating, tonumber(d.votes) or m.votes end
    end
    say(string.format(mod_loc("Thanks! You gave it %d out of 5."), tonumber(d.stars) or 0), G.C.GREEN)
    if play_sound then play_sound("card1", 1.1, 0.6) end
  elseif d.reason == "too_soon" then
    say(mod_loc("Wait a moment before rating again."), G.C.RED)
  else
    say(O.err_text(d.reason), G.C.RED)
  end
  refresh()
end

local function read_played()
  local f = sfs()
  local raw = f and f.getInfo(O.PLAYED) and f.read(O.PLAYED)
  local ok, t = pcall(json.decode, raw or "")
  t = ok and type(t) == "table" and t or {}
  t.sent = type(t.sent) == "table" and t.sent or {}
  t.pending = type(t.pending) == "table" and t.pending or {}
  return t
end

local function write_played(t)
  local f = sfs()
  local ok, raw = pcall(json.encode, t)
  if ok and f then
    if not f.getInfo("forge") then pcall(f.createDirectory, "forge") end
    pcall(f.write, O.PLAYED, raw)
  end
end

function O.note_run()
  local t = read_played()
  local any = false
  for _, m in ipairs(Mods.list or {}) do
    if m.on and not m.mine and Mods.clean_id(m.id) and not t.sent[m.id] and not t.pending[m.id] then
      t.pending[m.id] = true
      any = true
    end
  end
  if any then write_played(t) end
  if next(t.pending) ~= nil and O.connected() then O.flush_played(t) end
end

function O.flush_played(t)
  t = t or read_played()
  local ids = {}
  for id in pairs(t.pending) do
    if Mods.clean_id(id) and #ids < 8 then ids[#ids + 1] = id end
  end
  if #ids == 0 then return end
  table.sort(ids)
  O.state.played_ids = ids
  O.send({type = "forge_played", ids = ids})
end

function O.on_counted(d)
  if type(d) ~= "table" or not d.ok then return end
  local ids = O.state.played_ids
  O.state.played_ids = nil
  if not ids then return end
  local t = read_played()
  local done = {}
  for _, id in ipairs(ids) do t.pending[id] = nil; t.sent[id] = true; done[id] = true end
  write_played(t)
  local any = false
  for _, m in ipairs(O.state.data and O.state.data.mods or {}) do
    if done[m.id] and not m.mine and not m.played then
      m.played = true
      if (tonumber(d.counted) or 0) >= #ids then m.plays = (tonumber(m.plays) or 0) + 1 end
      any = true
    end
  end
  if any then
    local msg = O.state.msg
    if msg and msg.text == O.err_text("not_played") then O.state.msg = nil end
    refresh()
  end
end

function O.start_remix(id)
  if not require("functions/forge/forge_remix").start(id) then
    say(mod_loc("Could not remix it."), G.C.RED)
    refresh()
  end
end

function O.remix(id, version)
  local mod = Mods.get(id)
  if mod and mod.mine then return end
  if mod and (tonumber(mod.version) or 1) >= (tonumber(version) or 1) then return O.start_remix(id) end
  O.state.want[id] = {remix = true}
  O.state.msg = nil
  O.get(id)
end

function O.install_hooks()
  if O.hooked then return end
  O.hooked = true
  local Hooks = require("overhaul.hooks")
  Hooks.wrap("Game", "start_run", function(orig) return function(self, ...)
    local r = orig(self, ...)
    pcall(O.note_run)
    return r
  end end, {id = "forge_online.start_run"})
end

function O.register_events()
  if O.events_done then return end
  local E = rawget(_G, "bom_events")
  if not (E and E.register) then return end
  O.events_done = true
  E.register("forge_list", O.on_list)
  E.register("forge_mod", O.on_mod)
  E.register("forge_published", O.on_published)
  E.register("forge_reported", O.on_reported)
  E.register("forge_unpublished", O.on_unpublished)
  E.register("forge_rated", O.on_rated)
  E.register("forge_counted", O.on_counted)
end

local function summary_text(m)
  local Cat = require("functions/forge/forge_catalog")
  local parts = {}
  for _, k in ipairs(Cat.KINDS) do
    local n = type(m.summary) == "table" and tonumber(m.summary[k.id]) or nil
    if n and n > 0 then parts[#parts + 1] = n .. " " .. mod_loc(n == 1 and k.label or k.plural) end
  end
  return table.concat(parts, ", ")
end

local function btn_h() return touch() and 0.85 or 0.65 end
local BTN_W = 1.9
local BTN_SCALE = 0.45
local function port() return UIK.portrait() end

local function row_button(label, func, ref, colour, disabled, w)
  w = w or BTN_W
  return UIK.button{label = label, button = func, ref_table = ref, colour = colour, w = w, h = btn_h(), scale = fit_scale(label, w, BTN_SCALE), col = true, disabled = disabled}
end

local function gap(w) return {n = G.UIT.C, config = {align = "cm", minw = w or 0.15}, nodes = {}} end

local ROW_LABELS = {"Update", "Remove", "Get", "Installed", "Yours", "Remix", "Report", "Rate", "Play to rate", "Getting..."}

local function row_btn_w()
  local need = 0
  for _, l in ipairs(ROW_LABELS) do need = math.max(need, UIK.text_w(mod_loc(l), BTN_SCALE)) end
  return math.min(math.max(BTN_W, need + 0.3), touch() and 2.9 or 2.6)
end

local function decimal(x)
  local s = string.format("%.1f", tonumber(x) or 0)
  local lang = G.SETTINGS and G.SETTINGS.language or ""
  if lang:sub(1, 2) == "fr" or lang:sub(1, 2) == "es" then s = s:gsub("%.", ",") end
  return s
end

function O.stats_parts(m)
  local downloads = tonumber(m.downloads) or 0
  local votes = tonumber(m.votes) or 0
  local plays = tonumber(m.plays) or 0
  local parts = {string.format(downloads == 1 and mod_loc("%d download") or mod_loc("%d downloads"), downloads)}
  if m.votes ~= nil then
    parts[#parts + 1] = votes > 0 and string.format(mod_loc("rated %s/5 (%d)"), decimal(m.rating), votes) or mod_loc("not rated yet")
    parts[#parts + 1] = string.format(plays == 1 and mod_loc("%d player") or mod_loc("%d players"), plays)
  end
  local rx = tonumber(m.remixes) or 0
  if rx > 0 then parts[#parts + 1] = string.format(rx == 1 and mod_loc("%d remix") or mod_loc("%d remixes"), rx) end
  return parts
end

function O.stats_text(m) return table.concat(O.stats_parts(m), "   ") end

function O.stats_lines(parts, width, scale)
  local sep = "   "
  local all = table.concat(parts, sep)
  if #parts < 2 or UIK.text_w(all, scale) <= width then return {all} end
  local tight = table.concat(parts, "  ")
  if UIK.text_w(tight, scale) <= width then return {tight} end
  local best, best_w
  for k = 1, #parts - 1 do
    local a, b = table.concat(parts, sep, 1, k), table.concat(parts, sep, k + 1)
    local w = math.max(UIK.text_w(a, scale), UIK.text_w(b, scale))
    if not best_w or w < best_w then best, best_w = {a, b}, w end
  end
  return best
end

local function row(m, rw)
  local local_mod = Mods.get(m.id)
  local ver = tonumber(m.version) or 1
  local main
  local bw = row_btn_w()
  if port() then bw = math.max(bw, math.min(3.6, (rw - 0.5) / 2)) end
  if O.state.busy[m.id] then
    main = row_button(mod_loc("Getting..."), nil, nil, G.C.GREEN, true, bw)
  elseif m.mine then
    main = row_button(mod_loc("Update"), "forge_online_update", {id = m.id, version = ver}, G.C.ORANGE, nil, bw)
  elseif local_mod and local_mod.mine then
    main = row_button(mod_loc("Yours"), nil, nil, G.C.GREEN, true, bw)
  elseif local_mod and local_mod.version >= ver then
    main = row_button(mod_loc("Installed"), nil, nil, G.C.GREEN, true, bw)
  elseif local_mod then
    main = row_button(mod_loc("Update"), "forge_online_get", {id = m.id}, G.C.ORANGE, nil, bw)
  else
    main = row_button(mod_loc("Get"), "forge_online_get", {id = m.id}, G.C.GREEN, nil, bw)
  end
  local second = m.mine and row_button(mod_loc("Remove"), "forge_online_remove", {id = m.id, name = m.name}, G.C.RED, nil, bw)
    or row_button(mod_loc("Report"), "forge_online_report", {id = m.id, name = m.name}, G.C.RED, nil, bw)
  local rate, remix
  if not m.mine then
    local my = tonumber(m.my)
    if O.state.rating == m.id then
      rate = row_button(mod_loc("Sending..."), nil, nil, G.C.GOLD, true, bw)
    elseif m.played then
      rate = row_button(my and string.format(mod_loc("Rated %d/5"), my) or mod_loc("Rate"), "forge_online_rate", {id = m.id, name = m.name, my = my}, G.C.GOLD, nil, bw)
    else
      local label = mod_loc("Play to rate")
      rate = UIK.button{label = label, button = "forge_online_rate_locked", ref_table = {id = m.id, locked = true}, colour = UIK.C.inactive, text_colour = UIK.C.inactive_text,
        w = bw, h = btn_h(), scale = fit_scale(label, bw, BTN_SCALE), col = true, id = "forge_rate_locked_" .. m.id}
    end
    if not (local_mod and local_mod.mine) then
      remix = row_button(mod_loc("Remix"), "forge_online_remix", {id = m.id, version = ver}, G.C.PURPLE, O.state.busy[m.id] and true or nil, bw)
    end
  end
  local btns = {main}
  if remix then btns[#btns + 1] = remix end
  if rate then btns[#btns + 1] = rate end
  btns[#btns + 1] = second
  local grid = {}
  for i = 1, #btns, 2 do
    grid[#grid + 1] = {n = G.UIT.R, config = {align = "cr", padding = 0.03}, nodes = {btns[i], btns[i + 1] and gap(0.12) or nil, btns[i + 1]}}
  end
  local gw = 2 * bw + 0.12
  local t = touch()
  local p = port()
  local ls = t and 0.38 or 0.34
  local iw = p and rw - 0.3 or rw - gw - 0.75
  local head = {
    {n = G.UIT.T, config = {text = tostring(m.name), scale = t and 0.55 or 0.5, colour = G.C.WHITE, shadow = true}},
    {n = G.UIT.T, config = {text = "  v" .. ver, scale = ls, colour = G.C.GOLD, shadow = true}},
    m.mine and {n = G.UIT.T, config = {text = "  " .. mod_loc("YOURS"), scale = ls, colour = G.C.GREEN, shadow = true}} or nil,
  }
  local pill = tonumber(m.featured) and string.format(mod_loc("#%d LAST WEEK"), tonumber(m.featured)) or nil
  if pill then head[#head + 1] = {n = G.UIT.T, config = {text = "  " .. pill, scale = ls, colour = G.C.GOLD, shadow = true}} end
  local blv = local_mod and require("functions/forge/forge_balance").worst(Mods.all_of(local_mod))
  if blv then
    head[#head + 1] = {n = G.UIT.C, config = {minw = 0.15}, nodes = {}}
    head[#head + 1] = require("functions/forge/forge_balance").pill(blv, {scale = ls})
  end
  local info = {{n = G.UIT.R, config = {align = "cl", padding = 0.02, maxw = iw}, nodes = head}}
  local function put(text, colour)
    info[#info + 1] = {n = G.UIT.R, config = {align = "cl", padding = 0.02}, nodes = {
      {n = G.UIT.T, config = {text = text, scale = ls, colour = colour or G.C.UI.TEXT_LIGHT, maxw = iw}},
    }}
  end
  local function add(text, colour, lines)
    text = tostring(text or "")
    if text == "" then return end
    if UIK.text_w(text, ls) <= iw - 0.1 then return put(text, colour) end
    if lines == 1 then
      while #text > 1 and UIK.text_w(text .. "...", ls) > iw - 0.1 do text = text:gsub("[%z\1-\127\194-\244][\128-\191]*$", "") end
      return put((text:gsub("%s+$", "")) .. "...", colour)
    end
    local cur, n = "", 0
    for word in text:gmatch("%S+") do
      local try = cur == "" and word or (cur .. " " .. word)
      if cur ~= "" and UIK.text_w(try, ls) > iw - 0.1 then
        n = n + 1
        if n >= (lines or 2) then cur = cur .. "..." break end
        put(cur, colour)
        cur = word
      else
        cur = try
      end
    end
    if cur ~= "" then put(cur, colour) end
  end
  local by = m.author ~= "" and (mod_loc("by") .. " " .. tostring(m.author)) or ""
  local function parts_lines(parts)
    for _, l in ipairs(O.stats_lines(parts, iw - 0.1, ls)) do add(l, nil, 1) end
  end
  local sum = summary_text(m)
  local credit = require("functions/forge/forge_remix").credit_text(m.remix)
  if p then
    if by ~= "" then add(by, nil, 1) end
    parts_lines(O.stats_parts(m))
    if credit then add(credit, G.C.GOLD, 1) end
    add(sum, nil, 1)
  else
    parts_lines(O.stats_parts(m))
    add((by ~= "" and (by .. "   ") or "") .. sum, nil, 1)
    if credit then add(credit, G.C.GOLD, 1) end
  end
  local about = type(m.about) == "table" and m.about[1]
  if type(about) == "string" and about ~= "" and #info < (p and 5 or 3) then add(about, UIK.C.muted, p and 2 or 1) end
  local text_col = {n = G.UIT.C, config = {align = "cl", minw = iw, maxw = iw}, nodes = info}
  local grid_col = {n = G.UIT.C, config = {align = "cr", minw = gw}, nodes = grid}
  if p then
    return {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {
      {n = G.UIT.C, config = {align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.12, minw = rw}, nodes = {
        {n = G.UIT.R, config = {align = "cl"}, nodes = {text_col}},
        {n = G.UIT.R, config = {align = "cr", padding = 0.03}, nodes = {grid_col}},
      }},
    }}
  end
  return {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {
    {n = G.UIT.R, config = {align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = rw, minh = t and 1.2 or 1.05}, nodes = {
      text_col, gap(), grid_col,
    }},
  }}
end

O.THEMES = {
  hearts = "Hearts only", money = "Money makers", faces = "Face cards", grow = "Jokers that grow", bosses = "Boss Blinds", retrigger = "Retriggers",
  suits = "New suits", decks = "Decks and Challenges", luck = "Risk and luck", consumables = "Tarots and Spectrals", fusions = "Fusions", art = "Best art",
}

function O.theme_label(th)
  if type(th) ~= "table" then return "" end
  local en = O.THEMES[th.key]
  if en then return mod_loc(en) end
  return tostring(th.title or th.key or "")
end

function O.left_text(left)
  left = tonumber(left) or 0
  local days = math.floor(left / 86400)
  if days >= 2 then return string.format(mod_loc("%d days left"), days) end
  if days == 1 then return mod_loc("1 day left") end
  local hours = math.max(1, math.ceil(left / 3600))
  return string.format(hours == 1 and mod_loc("%d hour left") or mod_loc("%d hours left"), hours)
end

local function theme_banner(rw)
  local S = O.state
  local th = S.data and S.data.theme
  local t = touch()
  local p = port()
  local bw = t and 3.3 or 3.1
  local label = mod_loc("ENTER A MOD")
  local btn = UIK.button{label = label, button = "forge_online_enter", colour = UIK.C.ok, w = bw, h = btn_h(), scale = fit_scale(label, bw, t and 0.48 or 0.45), col = true,
    id = "forge_online_enter", disabled = th == nil}
  local tw = p and rw - 0.3 or rw - bw - 0.45
  local function line(text, scale, colour)
    return {n = G.UIT.R, config = {align = "cm", padding = 0.01}, nodes = {{n = G.UIT.T, config = {text = text, scale = scale, colour = colour, shadow = true, maxw = tw - 0.1}}}}
  end
  local texts = {line(mod_loc("THEME OF THE WEEK"), t and 0.36 or 0.33, UIK.C.muted)}
  if th then
    texts[#texts + 1] = line(O.theme_label(th), t and 0.62 or 0.58, G.C.GOLD)
    local sub = O.left_text(th.left)
    if type(th.last) == "table" then sub = sub .. "   " .. string.format(mod_loc("Last week: %s"), O.theme_label(th.last)) end
    texts[#texts + 1] = line(sub, t and 0.34 or 0.31, G.C.UI.TEXT_LIGHT)
  else
    texts[#texts + 1] = line(S.status == "loading" and mod_loc("Loading...") or "-", t and 0.62 or 0.58, G.C.GOLD)
    texts[#texts + 1] = line(" ", t and 0.34 or 0.31, G.C.UI.TEXT_LIGHT)
  end
  texts[#texts + 1] = line(mod_loc("The best rated entries are featured here next week."), t and 0.32 or 0.3, UIK.C.muted)
  local col = {n = G.UIT.C, config = {align = "cm", minw = tw}, nodes = texts}
  local inner
  if p then
    inner = {n = G.UIT.C, config = {align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = rw}, nodes = {
      {n = G.UIT.R, config = {align = "cm"}, nodes = {col}},
      {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {btn}},
    }}
  else
    inner = {n = G.UIT.R, config = {align = "cm", r = 0.1, colour = G.C.BLACK, emboss = 0.05, padding = 0.1, minw = rw}, nodes = {col, gap(0.2), btn}}
  end
  return {n = G.UIT.R, config = {align = "cm", padding = 0.05}, nodes = {inner}}
end

function O.body()
  local S = O.state
  local cur = UIK._win and UIK._win._cur or "all"
  if cur ~= S.tab then
    S.tab = cur
    S.data = nil
    O.browse(1)
  end
  local w = UIK.W
  local rw = port() and (w - 0.3) or math.min(w - 0.3, touch() and 14.2 or 13.6)
  local nodes = {}
  local m = S.msg
  nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, minh = 0.42, padding = 0}, nodes = {
    m and {n = G.UIT.T, config = {text = m.text, scale = touch() and 0.4 or 0.36, colour = m.colour or G.C.UI.TEXT_LIGHT, shadow = true, maxw = w - 0.6}} or nil,
  }}
  local featured = S.tab == "featured"
  local per = featured and 3 or 4
  local list_h = port() and per * ((touch() and 2.3 or 2.1) + 0.1) or per * ((touch() and 1.2 or 1.05) + 0.3)
  if featured then nodes[#nodes + 1] = theme_banner(rw) end
  local rows = {}
  local center_text
  if S.status == "loading" and not S.data then
    center_text = mod_loc("Loading...")
  elseif S.status == "offline" and not S.data then
    center_text = mod_loc("Could not reach the server.")
  elseif featured and S.data and not S.data.theme then
    center_text = mod_loc("The weekly theme is not on this server yet.")
  elseif featured and S.data and #S.data.mods == 0 then
    center_text = mod_loc("Nothing has entered this week's theme yet. Be the first!")
  elseif S.data and #S.data.mods == 0 then
    center_text = S.tab == "mine" and mod_loc("You have not published anything yet. Press Publish on one of yours in Forged.") or mod_loc("Nobody has published a mod yet.")
  end
  if center_text then
    rows[1] = {n = G.UIT.R, config = {align = "cm", minh = list_h}, nodes = {UIK.text(center_text, {scale = 0.42, colour = G.C.UI.TEXT_LIGHT})}}
  else
    for _, mod in ipairs(S.data.mods) do rows[#rows + 1] = row(mod, rw) end
  end
  nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "tm", minw = w, minh = list_h, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = rows}}}
  local pages = S.data and S.data.pages or 1
  if pages > 1 then
    nodes[#nodes + 1] = {n = G.UIT.R, config = {align = "cm", minw = w, padding = 0.04}, nodes = {
      UIK.pager{prev = "forge_online_page", next = "forge_online_page", prev_ref = {d = -1}, next_ref = {d = 1},
        text = string.format(mod_loc("Page %d of %d"), S.page or 1, pages), w = w},
    }}
  end
  return {n = G.UIT.R, config = {align = "tm", minw = w, padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm"}, nodes = nodes}}}
end

function O.open(tab)
  O.register_events()
  local S = O.state
  S.msg = nil
  S.tab = tab or S.tab or "all"
  S.data = nil
  O.browse(1)
  O.show()
end

function O.show()
r 32 1381 %20%20 -
l 453
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_online",
    title = mod_loc("FORGED ONLINE"),
    tabs = {
      {key = "featured", label = mod_loc("Featured"), build = O.body},
      {key = "best", label = mod_loc("Best rated"), build = O.body},
      {key = "played", label = mod_loc("Most played"), build = O.body},
      {key = "all", label = mod_loc("Newest"), build = O.body},
      {key = "mine", label = mod_loc("Published by me"), build = O.body},
    },
    tab = O.state.tab,
    back_func = "forge_online_back", back_inline = true,
    footer = {UIK.button{label = mod_loc("REFRESH"), button = "forge_online_refresh", colour = UIK.C.accent, id = "forge_online_refresh"}},
  }}
end

G.FUNCS.forge_online_open = function(e) O.open("featured") end

G.FUNCS.forge_online_back = function(e)
  O.state.msg = nil
  local MU = rawget(_G, "ForgeModsUI")
  if MU and MU.reopen_mods then MU.reopen_mods() else G.FUNCS.exit_overlay_menu() end
end

G.FUNCS.forge_online_refresh = function(e)
  O.state.msg = nil
  O.browse(O.state.page)
  refresh()
end

G.FUNCS.forge_online_page = function(e)
  local d = e and e.config and e.config.ref_table and e.config.ref_table.d or 1
  local pages = O.state.data and O.state.data.pages or 1
  O.state.msg = nil
  O.browse(((O.state.page or 1) - 1 + d) % pages + 1)
  refresh()
end

G.FUNCS.forge_online_get = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  if id then O.state.msg = nil; O.get(id) end
end

G.FUNCS.forge_online_unpublish = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  if id then O.unpublish(id) end
end

G.FUNCS.forge_online_update = function(e)
  local ref = e and e.config and e.config.ref_table
  if ref and ref.id and not O.state.busy[ref.id] then O.update(ref.id, ref.version) end
end

G.FUNCS.forge_online_remove = function(e)
  local ref = e and e.config and e.config.ref_table
  if not (ref and ref.id) then return end
  O.state.removing = {id = ref.id, name = ref.name}
  local bw = touch() and 4.4 or 4.2
  local function b(label, func, colour, id)
    return UIK.button{label = label, button = func, colour = colour, w = bw, scale = fit_scale(label, bw, touch() and 0.46 or 0.42), col = true, id = id}
  end
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_remove", compact = true, w = 9.6,
    title = mod_loc("REMOVE IT FROM ONLINE?"),
    tabs = {{key = "a", label = "", build = function()
      return UIK.stack({
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {UIK.text(tostring(ref.name or ""), {scale = 0.48})}},
        UIK.note({mod_loc("Players who got it keep it."), mod_loc("Your copy stays in Forged.")}, {w = 9.2}),
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {b(mod_loc("Remove"), "forge_online_remove_go", UIK.C.danger, "forge_remove_go")}},
      }, {w = 9.2})
    end}},
    back_func = "forge_online_remove_back", back_inline = false,
  }}
end

G.FUNCS.forge_online_remove_go = function(e)
  local r = O.state.removing
  O.state.removing = nil
  O.show()
  if r then O.unpublish(r.id) end
end

G.FUNCS.forge_online_remove_back = function(e)
  O.state.removing = nil
  O.show()
end

G.FUNCS.forge_mods_publish = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  if id then O.publish(id) end
end

G.FUNCS.forge_online_rate_locked = function(e)
  say(mod_loc("Play a run with it first, then you can rate it."), G.C.UI.TEXT_LIGHT)
  refresh()
end

G.FUNCS.forge_online_remix = function(e)
  local ref = e and e.config and e.config.ref_table
  if ref and ref.id and not O.state.busy[ref.id] then O.remix(ref.id, ref.version) end
end

G.FUNCS.forge_online_rate = function(e)
  local ref = e and e.config and e.config.ref_table
  if not (ref and ref.id) or O.state.rating then return end
  if ref.locked then return G.FUNCS.forge_online_rate_locked(e) end
  O.state.rating_pick = {id = ref.id, name = ref.name}
  local t = touch()
  local bw = port() and 0.95 or (t and 1.25 or 1.15)
  local nodes = {}
  for i = 1, 5 do
    if i > 1 then nodes[#nodes + 1] = gap(port() and 0.12 or 0.18) end
    nodes[#nodes + 1] = UIK.button{label = tostring(i), button = "forge_online_rate_go", ref_table = {stars = i}, colour = ref.my == i and UIK.C.ok or G.C.GOLD,
      w = bw, h = t and 0.95 or 0.8, scale = t and 0.62 or 0.58, col = true, id = "forge_rate_" .. i}
  end
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_rate", compact = true, w = 9.6,
    title = mod_loc("RATE THIS MOD"),
    tabs = {{key = "a", label = "", build = function()
      return UIK.stack({
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {UIK.text(tostring(ref.name or ""), {scale = 0.48})}},
        UIK.note({mod_loc("How much do you like it?"), mod_loc("1 is not for me, 5 is great.")}, {w = 9.2}),
        {n = G.UIT.R, config = {align = "cm", padding = 0.08, portrait_keep = true}, nodes = nodes},
        ref.my and UIK.note({string.format(mod_loc("You gave it %d. Pick again to change it."), ref.my)}, {w = 9.2}) or nil,
      }, {w = 9.2})
    end}},
    back_func = "forge_online_rate_back", back_inline = false,
  }}
end

G.FUNCS.forge_online_rate_go = function(e)
  local r = O.state.rating_pick
  local stars = e and e.config and e.config.ref_table and e.config.ref_table.stars
  O.state.rating_pick = nil
  O.show()
  if r and stars then O.rate(r.id, stars) end
  refresh()
end

G.FUNCS.forge_online_rate_back = function(e)
  O.state.rating_pick = nil
  O.show()
end

O.ENTER_PER = 6

local function my_mods()
  local out = {}
  for _, m in ipairs(Mods.list or {}) do if m.mine then out[#out + 1] = m end end
  return out
end

function O.enter_body()
  local S = O.state
  local list = my_mods()
  local t = touch()
  local bw = t and 4.4 or 4.2
  local w = port() and UIK.W - 0.3 or 9.2
  local th = S.data and S.data.theme
  local rows = {
    {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {UIK.text(O.theme_label(th), {scale = 0.55, colour = G.C.GOLD})}},
  }
  if #list == 0 then
    rows[#rows + 1] = UIK.note({mod_loc("You have no mods yet."), mod_loc("Make creations in The Forge, then press EXPORT A MOD.")}, {w = w})
    return UIK.stack(rows, {w = w})
  end
  rows[#rows + 1] = UIK.note({mod_loc("Pick one of your mods. It goes online and enters the theme.")}, {w = w})
  local pages = math.max(1, math.ceil(#list / O.ENTER_PER))
  S.enter_page = math.min(math.max(1, S.enter_page or 1), pages)
  local first = (S.enter_page - 1) * O.ENTER_PER
  local cols = port() and 1 or 2
  local cur = {}
  for i = first + 1, math.min(first + O.ENTER_PER, #list) do
    local m = list[i]
    if #cur > 0 then cur[#cur + 1] = gap(0.2) end
    cur[#cur + 1] = UIK.button{label = m.name, button = "forge_online_enter_go", ref_table = {id = m.id}, colour = UIK.C.accent, w = bw,
      scale = fit_scale(m.name, bw, t and 0.46 or 0.42), col = true, id = "forge_enter_" .. m.id}
    if #cur >= 2 * cols - 1 then
      rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = cur}
      cur = {}
    end
  end
  if #cur > 0 then rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = cur} end
  if pages > 1 then
    rows[#rows + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
      UIK.pager{prev = "forge_online_enter_page", next = "forge_online_enter_page", prev_ref = {d = -1}, next_ref = {d = 1},
        text = string.format(mod_loc("Page %d of %d"), S.enter_page, pages), w = w},
    }}
  end
  return UIK.stack(rows, {w = w})
end

G.FUNCS.forge_online_enter = function(e)
  O.state.enter_page = 1
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_enter", compact = true, w = 9.6,
    title = mod_loc("ENTER THIS WEEK'S THEME"),
    tabs = {{key = "a", label = "", build = O.enter_body}},
    back_func = "forge_online_enter_back", back_inline = false,
  }}
end

G.FUNCS.forge_online_enter_page = function(e)
  local d = e and e.config and e.config.ref_table and e.config.ref_table.d or 1
  local pages = math.max(1, math.ceil(#my_mods() / O.ENTER_PER))
  O.state.enter_page = ((O.state.enter_page or 1) - 1 + d) % pages + 1
  UIK.refresh()
end

G.FUNCS.forge_online_enter_go = function(e)
  local id = e and e.config and e.config.ref_table and e.config.ref_table.id
  if not id then return end
  O.state.tab = "featured"
  O.show()
  O.publish(id, {theme = true})
  local mod = Mods.get(id)
  say(string.format(mod_loc("Publishing %s..."), mod and mod.name or id), G.C.UI.TEXT_LIGHT)
  refresh()
end

G.FUNCS.forge_online_enter_back = function(e)
  O.show()
end

O.REASONS = {
  {id = "broken", label = "It does not work"},
  {id = "rude", label = "Rude or hateful"},
  {id = "stolen", label = "Stolen work"},
  {id = "other", label = "Something else"},
}

G.FUNCS.forge_online_report = function(e)
  local ref = e and e.config and e.config.ref_table
  if not (ref and ref.id) then return end
  O.state.reporting = {id = ref.id, name = ref.name}
  local bw = touch() and 4.4 or 4.2
  local function b(r)
    local label = mod_loc(r.label)
    return UIK.button{label = label, button = "forge_online_report_go", ref_table = {reason = r.id}, colour = UIK.C.danger, w = bw, scale = fit_scale(label, bw, touch() and 0.46 or 0.42), col = true, id = "forge_report_" .. r.id}
  end
  G.FUNCS.overlay_menu{definition = UIK.window{
    id = "forge_report", compact = true, w = 9.6,
    title = mod_loc("REPORT THIS MOD?"),
    tabs = {{key = "a", label = "", build = function()
      return UIK.stack({
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {UIK.text(tostring(ref.name or ""), {scale = 0.48})}},
        UIK.note({mod_loc("What is wrong with it?")}, {w = 9.2}),
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {b(O.REASONS[1]), gap(0.2), b(O.REASONS[2])}},
        {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {b(O.REASONS[3]), gap(0.2), b(O.REASONS[4])}},
      }, {w = 9.2})
    end}},
    back_func = "forge_online_report_back", back_inline = false,
  }}
end

G.FUNCS.forge_online_report_go = function(e)
  local r = O.state.reporting
  local reason = e and e.config and e.config.ref_table and e.config.ref_table.reason
  O.state.reporting = nil
  if r and reason then O.report(r.id, reason) end
  O.show()
end

G.FUNCS.forge_online_report_back = function(e)
  O.state.reporting = nil
  O.show()
end

