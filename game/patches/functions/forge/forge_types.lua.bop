      local set = G.GAME and G.GAME.forge_type_pack
      if set and area and area == G.pack_cards and not forced_key and (_type == "Tarot" or _type == "Spectral" or _type == "Planet" or _type == "Tarot_Planet") then
        local ok, key = pcall(T.card_key, set, "forge_type_pack" .. (G.GAME.round_resets and G.GAME.round_resets.ante or 1))
        if ok and key then
          _type = set
          soulable = nil
          forced_key = key
