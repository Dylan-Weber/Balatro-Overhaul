      local ok, r = pcall(T.collection_menu, t)
      return ok and r or t
    end
  end
  if Game and Game.start_run then
    local orig = Game.start_run
    Game.start_run = function(self, ...)
      local r = {orig(self, ...)}
      pcall(T.ensure_rates)
      return unpack(r)
    end
  end
end

