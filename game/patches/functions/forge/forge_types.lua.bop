      _G[name] = function(...)
        local dict = G.localization and G.localization.misc and G.localization.misc.dictionary
        local own = G.GAME and G.GAME.forge_type_pack and G.GAME.forge_type_pack_name
        if not (dict and own) then return orig(...) end
        local keep = dict[key]
        dict[key] = own
        local r = {pcall(orig, ...)}
        dict[key] = keep
        if not r[1] then error(r[2], 0) end
        return unpack(r, 2, table.maxn(r))
      end
    end
  end
  if Blind and Blind.set_blind then
    local orig = Blind.set_blind
    Blind.set_blind = function(self, blind, reset, silent, ...)
      local r = {orig(self, blind, reset, silent, ...)}
