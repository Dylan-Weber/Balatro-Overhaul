local function own_cards_button(t, n)
  local low = string.lower(t.set)
  return UIBox_button({button = "forge_collection_type", ref_table = {set = t.set}, label = {T.name(t)}, count = {tally = n, of = n}, minw = 4, id = "your_collection_" .. low, colour = G.C.SECONDARY_SET[t.set]})
end

local function find_parent(node, id)
  if type(node) ~= "table" then return nil end
  for _, child in ipairs(node.nodes or {}) do
    for _, inner in ipairs(type(child) == "table" and child.nodes or {}) do
      if type(inner) == "table" and inner.config and inner.config.id == id then return node end
    end
    local p = find_parent(child, id)
    if p then return p end
  end
  return nil
end

function T.collection_menu(t)
  if smods() then return t end
  local parent = find_parent(t, "your_collection_spectrals")
  if not parent then return t end
  for _, ty in ipairs(T.list) do
    local n = #T.live_cards(ty.set)
    if n > 0 then parent.nodes[#parent.nodes + 1] = own_cards_button(ty, n) end
  end
  return t
end

