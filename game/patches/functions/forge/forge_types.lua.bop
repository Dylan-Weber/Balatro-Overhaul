      elseif not forced_key and type(_type) == "string" and T.by_set[_type] then
        local ok, key = pcall(T.card_key, _type, "forge_type_card" .. (G.GAME and G.GAME.round_resets and G.GAME.round_resets.ante or 1))
        if ok and key then forced_key = key end
      end
      return orig(_type, area, legendary, _rarity, skip_materialize, soulable, forced_key, key_append, ...)
    end
  end
