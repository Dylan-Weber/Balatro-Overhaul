local function text() return package.loaded["functions/forge/forge_text"] or require("functions/forge/forge_text") end
local function lang_t(t, lang) return t[lang] or t.en end
local function ml(s) return mod_loc and mod_loc(s) or s end

function E.rules(R)
  R.V9_IDS = R.V9_IDS or {}
  for _, id in ipairs({"jokers_with", "jokers_match", "make_ed_joker", "draw", "edition_joker", "draw_cards"}) do R.V9_IDS[id] = true end

  function R.ed_match(v)
    if type(v) ~= "string" or v:sub(1, 2) ~= "e_" then return nil end
    return v:sub(3)
  end

  function R.ed_values()
    local out = {"foil", "holo", "polychrome", "negative"}
    for _, v in ipairs(R.own_values and R.own_values("edition") or {}) do out[#out + 1] = v end
    return out
  end

  function R.ed_matches()
    local out = {"e_any"}
    for _, v in ipairs(R.ed_values()) do out[#out + 1] = "e_" .. v end
    return out
  end

  function R.ed_ok(v)
    local ed = R.ed_match(v)
    if not ed then return false end
    if ed == "any" or ed == "foil" or ed == "holo" or ed == "polychrome" or ed == "negative" then return true end
    return R.own_id("edition", ed) ~= nil
  end

  function R.ed_name(ed)
    if ed == "any" then return ml("Any edition") end
    return text().edition_name(ed)
  end

  function R.ed_phrase(v, lang, plural, jokers)
    local l = lang_t(jokers and JOKERS or CARDS, lang)
    local ed = R.ed_match(v) or "any"
    if ed == "any" then return plural and l.any or l.any1 end
    return string.format(plural and l.ed or l.ed1, R.ed_name(ed))
  end

  local base_match = R.card_match
  R.card_match = function(c, v)
    local ed = R.ed_match(v)
    if ed then
      if ed == "any" then return c ~= nil and type(c.edition) == "table" and next(c.edition) ~= nil end
      return R.has_edition(c, ed)
    end
    return base_match(c, v)
  end

  local base_matches = R.matches
  R.matches = function()
    local out = base_matches()
    for _, v in ipairs(R.ed_matches()) do out[#out + 1] = v end
    return out
  end

  function R.filter_values(id)
    if id == "jokers_with" then return R.ed_matches() end
    return R.matches()
  end

  function R.count_matches(per)
    if per == "jokers_match" then return R.ed_matches() end
    return R.matches()
  end

  local base_mlabel = R.match_label
  R.match_label = function(v, lang, plural)
    if R.ed_match(v) then return R.ed_phrase(v, lang, true) end
    return base_mlabel(v, lang, plural)
  end

  local base_one = R.one_label
  R.one_label = function(v, lang)
    if R.ed_match(v) then return R.ed_phrase(v, lang, false) end
    return base_one(v, lang)
  end

  local base_count = R.count_label
  R.count_label = function(g, lang)
    if g.per == "jokers_match" then
      return string.format(lang_t(JOKERS, lang).count, R.ed_phrase(g.m or "e_any", lang, false, true))
    end
    return base_count(g, lang)
  end

  function R.count_m_label(per, m, lang)
    if per == "jokers_match" then return R.ed_phrase(m or "e_any", lang, false, true) end
    return R.one_label(m or "any", lang)
  end

  local function jokers_with(v)
    local n = 0
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do
      if R.card_match(j, v) then n = n + 1 end
    end
    return n
  end
  E.jokers_with = jokers_with

  R.ONLY[#R.ONLY + 1] = "jokers_with"
  R.FILTER_ONLY.jokers_with = true
  R.NUM.jokers_with = {def = 1, lo = 0, hi = 100, step = 1, big = 5}
  R.DEFAULT_ONLY.jokers_with = function() return {id = "jokers_with", v = "e_any", op = "at_least", n = 1} end
  R.CLEAN_ONLY.jokers_with = function(c)
    if not R.ed_ok(c.v) then c.v = "e_any" end
    c.op = c.op or "at_least"
  end
  R.CHECKS.jokers_with = function(o) return R.compare(o.op, jokers_with(o.v), o.n) end
  R.TEXT_ONLY.jokers_with = function(o, s, lang)
    local op = (s and (s[o.op or "at_least"] or s.at_least)) or ""
    return string.format(lang_t(JOKERS, lang).have, op, tonumber(o.n) or 0, R.ed_phrase(o.v, lang, true, true))
  end
  R.LABEL_ONLY.jokers_with = "Jokers with an edition"

  if R.COUNTS and R.COUNT and not R.member(R.COUNTS, "jokers_match") then
    R.COUNTS[#R.COUNTS + 1] = "jokers_match"
    R.COUNT_MATCH.jokers_match = true
    R.COUNT.jokers_match = function(g) return jokers_with(g.m or "e_any") end
    if R.LABEL_COUNT then R.LABEL_COUNT.jokers_match = "Jokers with an edition" end
  end

  R.GIVE[#R.GIVE + 1] = "make_ed_joker"
  R.GIVE[#R.GIVE + 1] = "draw"
  R.NUM.make_ed_joker = {def = 1, lo = 1, hi = 10, step = 1, big = 5}
  R.NUM.draw = {def = 2, lo = 1, hi = 52, step = 1, big = 5}
  R.HOST_GIVE.make_ed_joker = {joker = true}
  R.HOST_GIVE.draw = {joker = true}
  R.DEFAULT_GIVE.make_ed_joker = function() return {id = "make_ed_joker", v = "foil", n = 1} end
  R.DEFAULT_GIVE.draw = function() return {id = "draw", n = 2} end
  R.CLEAN_GIVE.make_ed_joker = function(e)
    if not R.member(R.ed_values(), e.v) then e.v = "foil" end
  end
  R.CLEAN_GIVE.draw = function(e) e.v = nil end
  R.DOS.make_ed_joker = function(g, card, src) R.make_edition_joker(g.v, g.n, src) end
  R.DOS.draw = function(g, card, src, context) R.draw_cards(g.n, context) end
  R.TEXT_GIVE.make_ed_joker = function(g, s, lang)
    local l = lang_t(JOKERS, lang)
    local n = math.floor(tonumber(g.n) or 1)
    if n <= 1 then return string.format(l.make1, R.ed_name(g.v)) end
    return string.format(l.make, n, R.ed_name(g.v))
  end
  R.TEXT_GIVE.draw = function(g, s, lang)
    local l = lang_t(JOKERS, lang)
    local n = math.floor(tonumber(g.n) or 2)
    if n == 1 then return l.draw1 end
    return string.format(l.draw, n)
  end
  R.LABEL_GIVE.make_ed_joker = "Make a Joker with an edition"

  R.GIVE[#R.GIVE + 1] = "ed_joker"
  R.NUM.ed_joker = {def = 1, lo = 1, hi = 5, step = 1, big = 5}
  R.HOST_GIVE.ed_joker = {joker = true}
  R.DEFAULT_GIVE.ed_joker = function() return {id = "ed_joker", v = "foil", n = 1} end
  R.CLEAN_GIVE.ed_joker = function(e)
    if not R.member(R.ed_values(), e.v) then e.v = "foil" end
  end
  R.DOS.ed_joker = function(g, card, src) R.add_edition_jokers(g.v, g.n, src) end
  R.TEXT_GIVE.ed_joker = function(g, s, lang)
    local l = lang_t(JOKERS, lang)
    local n = math.floor(tonumber(g.n) or 1)
    if n <= 1 then return string.format(l.add1, R.ed_name(g.v)) end
    return string.format(l.add, R.ed_name(g.v), n)
  end
  R.LABEL_GIVE.ed_joker = "Edition on a random Joker"

  function R.add_edition_jokers(v, n, src)
    if R.dry or not (G.jokers and G.GAME) then return 0 end
    local ed = R.edition_arg(v)
    if not ed then return 0 end
    local pool = {}
    for _, j in ipairs(G.jokers.cards or {}) do
      if not j.edition and not j.forge_ed_pending and not j.forge_dying and not j.removed then pool[#pool + 1] = j end
    end
    local done = 0
    local rnd, seed = rawget(_G, "pseudorandom"), rawget(_G, "pseudoseed")
    for _ = 1, math.min(math.max(1, math.floor(tonumber(n) or 1)), #pool) do
      local j = table.remove(pool, rnd(seed("forge_ed_add"), 1, #pool))
      j.forge_ed_pending = true
      done = done + 1
r 3 617 %20%20%20%20%20%20 -
l 31
        j.forge_ed_pending = nil
        if not j.edition and not j.removed and j.area == G.jokers then
          j:set_edition(ed, true)
          if src and src.juice_up then src:juice_up(0.3, 0.5) end
        end
        return true
      end}))
    end
    return done
  end
  R.LABEL_GIVE.draw = "Draw cards"

  local function frees_slot(ed)
    if ed.negative then return true end
    if not ed.forge then return false end
    local S = package.loaded["functions/forge/forge_store"]
    local it = S and S.get_item and S.get_item(ed.forge)
    local f = it and it.fields or {}
    return f.shader == "negative" or f.slot == true
  end

  function R.make_edition_joker(v, n, src)
    if R.dry or not (G.jokers and G.GAME) then return 0 end
    local probe = R.edition_arg(v)
    if not probe then return 0 end
    local free = frees_slot(probe)
    local made = 0
    for _ = 1, math.max(1, math.min(math.floor(tonumber(n) or 1), 50)) do
      if not free and not R.has_room(G.jokers, "joker_buffer") then break end
      G.GAME.joker_buffer = (G.GAME.joker_buffer or 0) + 1
      made = made + 1
