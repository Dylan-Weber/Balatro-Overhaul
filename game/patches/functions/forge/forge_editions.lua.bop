  es = {
    ["Jokers with an edition"] = "Comodines con edición", ["Any edition"] = "Cualquier edición", ["WHICH EDITION?"] = "¿QUÉ EDICIÓN?",
    ["Make a Joker with an edition"] = "Crea un comodín con edición", ["Draw cards"] = "Robar cartas",
