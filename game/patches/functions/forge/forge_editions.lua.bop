        local ed = R.edition_arg(v)
        if ed then c:set_edition(ed, true, true) end
        c:add_to_deck()
        G.jokers:emplace(c)
        c:start_materialize()
r 3 2539 %20%20%20%20%20%20%20%20 -
l 50
        return true
      end}))
    end
    if made > 0 and src and R.status then R.status(src, localize("k_plus_joker"), G.C.BLUE) end
    return made
  end

  local function mid_hand(context)
    if type(context) ~= "table" then return false end
    return context.discard or context.pre_discard or context.before or context.after or context.joker_main or context.individual or context.repetition
      or (G.play ~= nil and context.cardarea == G.play) or context.setting_blind or context.end_of_round or false
  end

  function R.draw_cards(n, context)
    if R.dry or not G.GAME then return end
    n = math.max(0, math.min(math.floor(tonumber(n) or 0), 52))
    if n <= 0 then return end
    local function now()
      local k = math.min(n, G.deck and #G.deck.cards or 0)
      if k > 0 and G.hand then E.draw(k) end
    end
    local function later() G.GAME.forge_draw = (G.GAME.forge_draw or 0) + n end
    if mid_hand(context) then return later() end
    if G.STATE == G.STATES.SELECTING_HAND then return now() end
    if G.STATE == G.STATES.PLAY_TAROT then
      G.E_MANAGER:add_event(Event({blocking = false, func = function()
        if G.STATE == G.STATES.SELECTING_HAND then now() return true end
        if G.STATE ~= G.STATES.PLAY_TAROT then later() return true end
        return false
      end}))
      return
    end
    later()
  end

  function E.draw(k, base)
    local S = rawget(_G, "SMODS")
    if type(S) == "table" and type(S.draw_cards) == "function" then return S.draw_cards(k) end
    return (base or G.FUNCS.draw_from_deck_to_hand)(k)
  end

  function E.install_draw()
    if E.draw_hooked or not (G and G.FUNCS and G.FUNCS.draw_from_deck_to_hand) then return end
    E.draw_hooked = true
    local orig = G.FUNCS.draw_from_deck_to_hand
    G.FUNCS.draw_from_deck_to_hand = function(e, ...)
      local res = {orig(e, ...)}
      local extra = G.GAME and tonumber(G.GAME.forge_draw) or 0
      if extra > 0 and e == nil and G.deck and G.hand then
        G.GAME.forge_draw = 0
r 3 617 %20%20%20%20%20%20%20%20 -
l 128
          local k = math.min(extra, #G.deck.cards)
          if k > 0 then E.draw(k, orig) end
          return true
        end}))
      end
      return unpack(res, 1, table.maxn(res))
    end
    if type(end_round) == "function" then
      local orig_end = end_round
      end_round = function(...)
        if G.GAME then G.GAME.forge_draw = 0 end
        return orig_end(...)
      end
    end
  end

  local base_need = R.need_v
  R.need_v = function(rules, vars)
    local need = base_need(rules, vars)
    local top = 0
    local function look(id, v, m)
      if R.V9_IDS[id] or R.ed_match(v) or R.ed_match(m) then top = E.V end
    end
    for _, r in ipairs(type(rules) == "table" and rules or {}) do
      if type(r) == "table" then
        for _, o in ipairs(type(r.only) == "table" and r.only or {}) do
          if type(o) == "table" then look(o.id, o.v) end
        end
        for _, l in ipairs({r.give, r.alt}) do
          for _, g in ipairs(type(l) == "table" and l or {}) do
            if type(g) == "table" then
              look(g.id, nil, g.m)
              if g.per and R.V9_IDS[g.per] then top = E.V end
            end
          end
        end
      end
    end
    for _, r in ipairs(type(rules) == "table" and rules or {}) do
      for _, l in ipairs(type(r) == "table" and {r.give, r.alt} or {}) do
        for _, g in ipairs(type(l) == "table" and l or {}) do
          if type(g) == "table" and g.id == "ed_joker" then top = math.max(top, 13) end
        end
      end
    end
    return math.max(need, top)
  end

  if mod_loc_register then mod_loc_register(LOC) end
end

function E.cat(Cat)
  local R = require("functions/forge/forge_rules")
  local function n(lo, hi, def, step, fmt) return {lo = lo, hi = hi, def = def, step = step or 1, fmt = fmt} end
  local function copy(e, extra)
    local c = {}
    for k, v in pairs(e) do c[k] = v end
    for k, v in pairs(extra or {}) do c[k] = v end
    return c
  end
  local make = copy(E.MAKE, {num = n(1, 10, 1)})
  local draw = copy(E.DRAW, {num = n(1, 52, 2)})
  local function add(list, e)
    for _, x in ipairs(list) do if x.id == e.id then return end end
    list[#list + 1] = copy(e)
  end
  for _, k in ipairs({"use", "spectral", "tag"}) do add(Cat.EFFECTS[k], make) end
  for _, k in ipairs({"use", "spectral"}) do add(Cat.EFFECTS[k], draw) end
  local run_make = copy(make, {run = true, num = n(1, 1e3, 1)})
  local run_draw = copy(draw, {run = true, num = n(1, 52, 2)})
  add(Cat.RUN, run_make)
  add(Cat.RUN, run_draw)
  for _, k in ipairs({"voucher", "deck", "stake", "boss"}) do
    add(Cat.EFFECTS[k], run_make)
    add(Cat.EFFECTS[k], run_draw)
  end

  local pack = Cat.kind("booster")
  local have = false
  for _, f in ipairs(pack.adv_fields or {}) do if f.id == "edition" then have = true end end
  if not have then
    pack.adv_fields[#pack.adv_fields + 1] = {id = "edition", label = "Edition on every card", type = "choice", options = Cat.SHADERS, def = "none", none = true, own = "edition", new = true}
  end

  local base_need = Cat.need_v
  Cat.need_v = function(c)
    local need = base_need(c)
    if type(c) ~= "table" then return need end
    local f = type(c.fields) == "table" and c.fields or {}
    if c.kind == "edition" and f.shader == "none" then need = math.max(need, E.V) end
    if c.kind == "booster" and f.edition ~= nil and f.edition ~= "none" then need = math.max(need, E.V) end
    for _, e in ipairs(type(c.effects) == "table" and c.effects or {}) do
      if type(e) == "table" then
        if R.V9_IDS[e.id] then need = math.max(need, E.V) end
        for _, o in ipairs(type(e.only) == "table" and e.only or {}) do
          if type(o) == "table" and (R.V9_IDS[o.id] or R.ed_match(o.v)) then need = math.max(need, E.V) end
        end
      end
    end
    return need
  end
end

function E.pack_edition(c)
  local f = c and c.fields or {}
  local v = c and c.mode == "advanced" and f.edition or nil
  if v == nil or v == "none" then return nil end
  local R = require("functions/forge/forge_rules")
  if not R.member(R.ed_values(), v) then return nil end
  return v
end

function E.install_pack(M)
  if E.pack_hooked or not (CardArea and CardArea.emplace) then return end
  E.pack_hooked = true
  local orig = CardArea.emplace
  CardArea.emplace = function(self, card, ...)
    local v = G and G.GAME and G.GAME.forge_pack_edition
    if v and self == G.pack_cards and card and card.set_edition then
      local R = require("functions/forge/forge_rules")
      local ed = R.edition_arg(v)
      if ed then pcall(card.set_edition, card, ed, true, true) end
    end
    return orig(self, card, ...)
  end
end

return E
end
