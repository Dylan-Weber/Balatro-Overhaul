local E = {}

E.V = 9
E.MAKE = {id = "edition_joker", label = "Make a Joker with an edition", v = "shader", line = "Makes {C:attention}%d{} random Jokers with {C:dark_edition}%s{}", line1 = "Makes a random {C:dark_edition}%s{} Joker", new = true, need = 9}
E.DRAW = {id = "draw_cards", label = "Draw cards", line = "Draw {C:attention}%d{} cards", line1 = "Draw {C:attention}1{} card", new = true, need = 9}

local CARDS = {
  en = {any = "cards with an edition", any1 = "card with an edition", ed = "{C:dark_edition}%s{} cards", ed1 = "{C:dark_edition}%s{} card"},
  fr = {any = "cartes avec une édition", any1 = "carte avec une édition", ed = "cartes {C:dark_edition}%s{}", ed1 = "carte {C:dark_edition}%s{}"},
  es = {any = "cartas con edición", any1 = "carta con edición", ed = "cartas {C:dark_edition}%s{}", ed1 = "carta {C:dark_edition}%s{}"},
}
local JOKERS = {
  en = {any = "Jokers with an edition", any1 = "Joker with an edition", ed = "{C:dark_edition}%s{} Jokers", ed1 = "{C:dark_edition}%s{} Joker",
    have = "you have %s {C:attention}%d{} %s", count = "%s you have",
    make = "create {C:attention}%d{} random {C:dark_edition}%s{} Jokers", make1 = "create a random {C:dark_edition}%s{} Joker",
    add = "add {C:dark_edition}%s{} to {C:attention}%d{} random Jokers without an edition", add1 = "add {C:dark_edition}%s{} to a random Joker without an edition",
    draw = "draw {C:attention}%d{} cards", draw1 = "draw {C:attention}1{} card"},
  fr = {any = "Jokers avec une édition", any1 = "Joker avec une édition", ed = "Jokers {C:dark_edition}%s{}", ed1 = "Joker {C:dark_edition}%s{}",
    have = "vous avez %s {C:attention}%d{} %s", count = "%s possédé",
    make = "crée {C:attention}%d{} Jokers {C:dark_edition}%s{} au hasard", make1 = "crée un Joker {C:dark_edition}%s{} au hasard",
    add = "ajoute {C:dark_edition}%s{} à {C:attention}%d{} Jokers sans édition au hasard", add1 = "ajoute {C:dark_edition}%s{} à un Joker sans édition au hasard",
    draw = "pioche {C:attention}%d{} cartes", draw1 = "pioche {C:attention}1{} carte"},
  es = {any = "comodines con edición", any1 = "comodín con edición", ed = "comodines {C:dark_edition}%s{}", ed1 = "comodín {C:dark_edition}%s{}",
    have = "tienes %s {C:attention}%d{} %s", count = "%s que tienes",
    make = "crea {C:attention}%d{} comodines {C:dark_edition}%s{} al azar", make1 = "crea un comodín {C:dark_edition}%s{} al azar",
    add = "añade {C:dark_edition}%s{} a {C:attention}%d{} comodines sin edición al azar", add1 = "añade {C:dark_edition}%s{} a un comodín sin edición al azar",
    draw = "roba {C:attention}%d{} cartas", draw1 = "roba {C:attention}1{} carta"},
}

local LOC = {
  fr = {
    ["Jokers with an edition"] = "Jokers avec une édition", ["Any edition"] = "Toute édition", ["WHICH EDITION?"] = "QUELLE ÉDITION ?",
    ["Make a Joker with an edition"] = "Crée un Joker avec une édition", ["Draw cards"] = "Piocher des cartes",
    ["Makes {C:attention}%d{} random Jokers with {C:dark_edition}%s{}"] = "Crée {C:attention}%d{} Jokers {C:dark_edition}%s{} au hasard",
    ["Makes a random {C:dark_edition}%s{} Joker"] = "Crée un Joker {C:dark_edition}%s{} au hasard",
    ["Draw {C:attention}%d{} cards"] = "Piochez {C:attention}%d{} cartes", ["Draw {C:attention}1{} card"] = "Piochez {C:attention}1{} carte",
