R.warned = {}
R.errors = 0

local function log_once(key, msg)
  if R.warned[key] then return end
  R.warned[key] = true
  R.errors = R.errors + 1
  print("[FORGE] " .. tostring(msg))
end

local function num_key(id)
  if id == "money" then return "money_cond" end
  return id
end

function R.num(kind, v, is_cond)
  local spec = R.NUM[is_cond and num_key(kind) or kind]
  if not spec then return tonumber(v) or 0 end
  v = tonumber(v) or spec.def
  if v ~= v then v = spec.def end
  if v < spec.lo then v = spec.lo end
  if v > spec.hi then v = spec.hi end
  if spec.step % 1 == 0 and spec.lo % 1 == 0 then return math.floor(v + 0.5) end
  return math.floor(v * 100 + 0.5) / 100
end

local function member(list, v)
  for _, x in ipairs(list) do if x == v then return true end end
  return false
end

R.TAG_RANDOM = "random"

R.OWN_PREFIX = {enhancement = "m_forge_", seal = "Forge_", edition = "forge_", tag = "tag_forge_", voucher = "v_forge_", pack = "p_forge_"}
R.OWN_KIND = {enhancement = "enhancement", seal = "seal", edition = "edition", tag = "tag", voucher = "voucher", pack = "booster"}
R.OWN_PREFIX.joker = "j_forge_"
R.OWN_PREFIX.consumable = "c_forge_"
R.CARD_SETS = {Joker = true, Tarot = true, Planet = true, Spectral = true}
R.CARD_KINDS = {"Joker", "Tarot", "Planet", "Spectral"}
R.CARD_DEFAULT = "c_fool"

local function store() return package.loaded["functions/forge/forge_store"] end

function R.own_id(what, v)
  if what == "card" then return R.own_id("joker", v) or R.own_id("consumable", v) end
  local p = R.OWN_PREFIX[what]
  if not p or type(v) ~= "string" or v:sub(1, #p) ~= p then return nil end
  local id = v:sub(#p + 1)
  if id == "" or #id > 16 or id:find("[^%w]") then return nil end
  return id
end

local function own_ref(v)
  if type(v) ~= "string" then return nil end
  for what, p in pairs(R.OWN_PREFIX) do
    local id = R.own_id(what, v)
    if id then return p, id end
  end
  return nil
end

