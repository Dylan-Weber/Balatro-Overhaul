function R.usable(what, v)
  if what == "card" then return R.card_usable(v) end
  if not R.own_id(what, v) then return true end
  local c = R.own_item(what, v)
  if not (c and c.enabled ~= false) then return false end
  if what == "enhancement" or what == "voucher" or what == "pack" then return G.P_CENTERS and G.P_CENTERS[v] and G.P_CENTERS[v].forge_on ~= false and true or false end
  if what == "seal" then return G.P_SEALS and G.P_SEALS[v] and G.shared_seals and G.shared_seals[v] and true or false end
  if what == "edition" then return G.P_CENTERS and G.P_CENTERS["e_" .. v] and true or false end
  if what == "tag" then return G.P_TAGS and G.P_TAGS[v] and not G.P_TAGS[v].forge_gone and true or false end
  return false
end

local function with_own(list, what)
  local out = {}
  for _, v in ipairs(list) do out[#out + 1] = v end
  for _, v in ipairs(R.own_values(what)) do out[#out + 1] = v end
  return out
end

function R.enhancements() return with_own(R.ENHANCEMENTS, "enhancement") end
function R.seals() return with_own(R.SEALS, "seal") end
function R.editions() return with_own(R.EDITIONS, "edition") end
function R.tags() return with_own(R.TAGS, "tag") end
function R.add_cards() return with_own(R.ADD_CARDS, "enhancement") end

function R.edition_arg(v)
  local id = R.own_id("edition", v)
  if id then return R.usable("edition", v) and {forge = id} or nil end
  if member(R.EDITIONS, v) or v == "negative" then return {[v] = true} end
  return nil
end

function R.has_edition(card, v)
  local ed = card and card.edition
  if not ed then return false end
  local id = R.own_id("edition", v)
  if id then return tostring(ed.forge) == id end
  return ed[v] and not ed.forge and true or false
end

function R.value_ok(what, v)
  if R.own_id(what, v) then return true end
  if what == "enhancement" then return member(R.ENHANCEMENTS, v) end
  if what == "seal" then return member(R.SEALS, v) end
  if what == "edition" then return member(R.EDITIONS, v) end
  if what == "tag" then return member(R.TAGS, v) end
  return false
end

function R.tag_ok(v)
  return v == R.TAG_RANDOM or member(R.TAGS, v) or R.own_id("tag", v) ~= nil
end

function R.tag_pool()
  local out = {}
  for _, v in ipairs(R.tags()) do
    if G.P_TAGS and G.P_TAGS[v] and R.usable("tag", v) then out[#out + 1] = v end
  end
  return out
end

function R.roll_tag()
  local pool = R.tag_pool()
  if #pool == 0 then return nil end
  return pseudorandom_element(pool, pseudoseed("forge_tag"))
end

function R.host_of(kind) return R.HOST_OF[kind] or "joker" end

R.KIND_WHEN = {blind = {"blind_selected", "hand_played", "card_scored", "discard", "round_end"}}

function R.whens(kind)
  return kind and R.KIND_WHEN[kind] or R.HOST_WHEN[R.host_of(kind)] or R.JOKER_WHEN
end

function R.when_ok(host, when, kind)
  if kind and R.KIND_WHEN[kind] then return member(R.KIND_WHEN[kind], when) end
  return member(R.HOST_WHEN[host or "joker"] or R.JOKER_WHEN, when)
end

function R.allowed_give(when, give, host)
  host = host or "joker"
  local hg = R.HOST_GIVE[give]
  if hg and not hg[host] then return false end
  if host == "joker" and R.V8_WHEN[give] and R.V8_WHEN[give][when] then return true end
  if R.GIVE_WHEN[give] then return R.GIVE_WHEN[give][when] or false end
  if host == "card" then
    if give == "level_up" then return when == "card_scored" end
    if give == "perma_chips" or give == "copy_card" then return when ~= "round_end" end
  end
  if host == "run" and (give == "perma_chips" or give == "copy_card") then return when == "card_scored" end
  if give == "var_chips" then give = "chips" elseif give == "var_mult" then give = "mult" end
  if give == "chips" then return when == "card_scored" or when == "hand_played" end
  if give == "mult" or give == "xmult" then return when == "card_scored" or when == "card_held" or when == "hand_played" end
  if give == "retrigger" then return when == "card_scored" or when == "card_held" end
  if give == "level_up" then return when == "before" or when == "hand_played" or when == "after" end
  if give == "change" then return when == "card_scored" end
  if give == "hand" or give == "discard" then return R.ROUND_WHEN[when] or false end
  if give == "destroy_card" or give == "copy_card" then return when == "card_scored" or when == "discard" end
  if give == "perma_chips" then return when == "card_scored" end
  if give == "disable_boss" then return R.ROUND_WHEN[when] or false end
  return member(R.GIVE, give)
end

function R.allowed_only(when, only, host)
  host = host or "joker"
  local ho = R.HOST_ONLY[only]
  if ho and not ho[host] then return false end
  if R.ONLY_WHEN[only] then return R.ONLY_WHEN[only][when] or false end
  if R.CARD_ONLY[only] then
    if host == "card" then return true end
    if host == "use" then return false end
    if host == "run" then return when == "card_scored" end
    return R.CARD_WHEN[when] or false
  end
  if only == "hand" or only == "cards_played" then return R.HAND_WHEN[when] or when == "discard" end
  if only == "first_hand" or only == "last_hand" or only == "hands_left" or only == "discards_left" then return R.ROUND_WHEN[when] or when == "round_end" end
  if only == "hand_level" then return R.HAND_WHEN[when] or false end
  return member(R.ONLY, only)
end

function R.default_only(id)
  if R.DEFAULT_ONLY[id] then return R.DEFAULT_ONLY[id]() end
  if id == "hand" then return {id = "hand", v = "Pair", mode = "contains"} end
  if id == "suit" then return {id = "suit", v = "Hearts"} end
  if id == "rank" then return {id = "rank", v = "face"} end
  if id == "enhancement" then return {id = "enhancement", v = "m_gold"} end
  if id == "seal" then return {id = "seal", v = "Red"} end
  if id == "edition" then return {id = "edition", v = "foil"} end
  if id == "chance" then return {id = "chance", n = R.NUM.chance.def} end
  if id == "var" then return {id = "var", var = 1, op = "at_least", n = R.NUM.var.def} end
  if id == "blind" then return {id = "blind", v = "Small"} end
  if id == "money" then return {id = "money", op = "at_least", n = R.NUM.money_cond.def} end
  if R.NUM[id] then return {id = id, op = "at_least", n = R.NUM[id].def} end
  return {id = id}
end

function R.default_give(id)
  if R.DEFAULT_GIVE[id] then return R.DEFAULT_GIVE[id]() end
  if id == "create" then return {id = "create", v = "Tarot"} end
  if id == "change" then return {id = "change", what = "enhancement", v = "m_gold"} end
  if id == "add_card" then return {id = "add_card", v = "m_stone"} end
  if id == "tag" then return {id = "tag", v = "tag_double"} end
  if id == "make_card" then return {id = "make_card", v = R.CARD_DEFAULT} end
  if id == "level_up" or id == "destroy_self" or id == "destroy_card" or id == "copy_card" or id == "disable_boss" or id == "destroy_joker" then return {id = id} end
  if R.VAR_GIVE[id] then return {id = id, var = 1, n = R.NUM[id].def} end
  return {id = id, n = R.NUM[id] and R.NUM[id].def or 1}
end

function R.change_values(what)
  if what == "suit" then return {"Hearts", "Diamonds", "Spades", "Clubs"} end
  if what == "rank" then return {14, 13, 12, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2} end
  if what == "seal" then return R.seals() end
  if what == "edition" then return R.editions() end
  return R.enhancements()
end

local function var_index(v)
  v = math.floor(tonumber(v) or 1)
  if v < 1 then v = 1 end
  if v > R.MAX_VARS then v = R.MAX_VARS end
  return v
end

function R.clean_name(str)
  str = tostring(str or ""):gsub("[%c{}#%%\\]", ""):gsub("^%s+", ""):gsub("%s+$", "")
  if #str > R.VAR_NAME then
    str = str:sub(1, R.VAR_NAME)
    while #str > 0 and str:byte(#str) >= 128 do
      local b = str:byte(#str)
      str = str:sub(1, -2)
      if b >= 192 then break end
    end
  end
  return str
end

function R.clean_vars(list)
  local out = {}
  for _, v in ipairs(type(list) == "table" and list or {}) do
    if type(v) == "table" and #out < R.MAX_VARS then
      local name = R.clean_name(v.name)
      if name == "" then name = "V" .. (#out + 1) end
      local o = {name = name}
      if not (R.clean_typed and R.clean_typed(v, o)) then o.start = R.num("var_start", v.start) end
      out[#out + 1] = o
    end
  end
  return out
end

function R.keep_nv(src, e)
  local i = tonumber(src.nv)
  if e.n ~= nil and i and i % 1 == 0 and i >= 1 and i <= R.MAX_VARS then e.nv = i else e.nv = nil end
  return e
end

function R.extra_give(kind, g)
  local fn = R.extra_give_fn
  if not (kind and fn and type(g) == "table") then return nil end
  local ok, e = pcall(fn, kind, g)
  return ok and e or nil
end

function R.clean_rule(r, kind)
  local host = kind and R.host_of(kind) or "joker"
  if type(r) ~= "table" or not member(R.WHEN, r.when) or not R.when_ok(host, r.when, kind) then return nil end
  local out = {when = r.when, only = {}, give = {}}
  for _, o in ipairs(type(r.only) == "table" and r.only or {}) do
    if type(o) == "table" and member(R.ONLY, o.id) and R.allowed_only(r.when, o.id, host) then
      local c = {id = o.id, v = o.v, mode = o.mode, op = o.op, n = o.n, neg = o.neg == true and o.id ~= "chance" or nil, var = (o.id == "var" or (o.id == "every" and o.v == "var")) and var_index(o.var) or nil}
      if c.n ~= nil then c.n = R.num(o.id, c.n, true) end
      if c.op and not member(R.OPS, c.op) then c.op = "at_least" end
      if c.id == "blind" and not member(R.BLINDS, c.v) then c.v = "Small" end
      if R.CLEAN_ONLY[c.id] then R.CLEAN_ONLY[c.id](c) end
      R.keep_nv(o, c)
      out.only[#out.only + 1] = c
    end
  end
  for _, g in ipairs(type(r.give) == "table" and r.give or {}) do
    local x = host ~= "joker" and type(g) == "table" and not member(R.GIVE, g.id) and R.extra_give(kind, g)
    if x then
      x.run = true
      out.give[#out.give + 1] = x
    elseif type(g) == "table" and member(R.GIVE, g.id) and R.allowed_give(r.when, g.id, host) then
      local e = {id = g.id, v = g.v, what = g.what, n = g.n, var = R.VAR_GIVE[g.id] and var_index(g.var) or nil, per = R.PER_GIVE[g.id] and g.per or nil, m = R.PER_GIVE[g.id] and g.m or nil}
      if R.NUM[g.id] then e.n = R.num(g.id, g.n) end
      if e.id == "add_card" and not member(R.ADD_CARDS, e.v) and not R.own_id("enhancement", e.v) then e.v = "c_base" end
      if e.id == "tag" and not R.tag_ok(e.v) then e.v = "tag_double" end
      if e.id == "make_card" and not R.card_ok(e.v) then e.v = R.CARD_DEFAULT end
      if R.CLEAN_GIVE[e.id] then R.CLEAN_GIVE[e.id](e, r.when) end
      R.keep_nv(g, e)
      out.give[#out.give + 1] = e
    end
  end
  if #out.only > 0 and type(r.alt) == "table" then
    for _, g in ipairs(r.alt) do
      local x = host ~= "joker" and type(g) == "table" and not member(R.GIVE, g.id) and #(out.alt or {}) < 4 and R.extra_give(kind, g)
      if x then
        x.run = true
        out.alt = out.alt or {}
        out.alt[#out.alt + 1] = x
      elseif type(g) == "table" and g.id ~= "change" and member(R.GIVE, g.id) and R.allowed_give(r.when, g.id, host) and #(out.alt or {}) < 4 then
        local e = {id = g.id, v = g.v, what = g.what, n = g.n, var = R.VAR_GIVE[g.id] and var_index(g.var) or nil, per = R.PER_GIVE[g.id] and g.per or nil, m = R.PER_GIVE[g.id] and g.m or nil}
        if R.NUM[g.id] then e.n = R.num(g.id, g.n) end
        if e.id == "add_card" and not member(R.ADD_CARDS, e.v) and not R.own_id("enhancement", e.v) then e.v = "c_base" end
        if e.id == "tag" and not R.tag_ok(e.v) then e.v = "tag_double" end
        if e.id == "make_card" and not R.card_ok(e.v) then e.v = R.CARD_DEFAULT end
        if R.CLEAN_GIVE[e.id] then R.CLEAN_GIVE[e.id](e, r.when) end
        R.keep_nv(g, e)
        out.alt = out.alt or {}
        out.alt[#out.alt + 1] = e
      end
    end
  end
  return out
end

function R.clean_rules(list, kind)
  local out = {}
  for _, r in ipairs(type(list) == "table" and list or {}) do
    local c = R.clean_rule(r, kind)
    if c then out[#out + 1] = c end
    if #out >= R.MAX_RULES then break end
  end
  return out
end

