      c.states = c.states or {}
      c.states.visible = nil
r 3 617 %20%20%20%20%20%20 -
l 14
        if c.start_materialize then c:start_materialize() end
        return true
      end}))
    else
      G.deck:emplace(c)
    end
    if playing_card_joker_effects then
      G.E_MANAGER:add_event(Event({func = function() playing_card_joker_effects({c}); return true end}))
    end
    status(src, localize("k_copied_ex"), G.C.CHIPS)
  elseif id == "tag" then
    local key = R.tag_ok(g.v) and g.v or "tag_double"
    if g.v == R.TAG_RANDOM then key = R.roll_tag() end
    if not key or not G.P_TAGS or not G.P_TAGS[key] or not R.usable("tag", key) then return end
