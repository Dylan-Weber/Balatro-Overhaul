      return true
    end}))
    status(src, "+1", G.C.FILTER)
  elseif id == "disable_boss" then
    local b = G.GAME and G.GAME.blind
    if b and b.boss and not b.disabled then
      b:disable()
      status(src, localize("ph_boss_disabled"), G.C.RED)
    end
  elseif id == "destroy_joker" then
    local list = {}
    for _, j in ipairs(G.jokers and G.jokers.cards or {}) do
      if j ~= card and not (j.ability and j.ability.eternal) and not j.getting_sliced and not j.forge_dying then list[#list + 1] = j end
    end
    if #list == 0 then return end
    local j = pseudorandom_element(list, pseudoseed("forge_dj"))
    j.getting_sliced = true
    destroy(j)
    status(src, "-1", G.C.RED)
  elseif id == "sell_value" then
    if context.blueprint then return end
    card.ability.extra_value = (tonumber(card.ability.extra_value) or 0) + g.n
    if card.set_cost then card:set_cost() end
    status(src, localize("k_val_up"), G.C.MONEY)
  elseif id == "var_add" or id == "var_set" then
    if context.blueprint then return end
    local vars = R.state(card).vars
    if type(vars) ~= "table" then vars = {}; R.state(card).vars = vars end
    local i = g.var or 1
    local nv = id == "var_set" and g.n or (tonumber(vars[i]) or 0) + g.n
    vars[i] = math.max(0, math.min(R.VAR_CAP, nv))
    if id == "var_set" then status(src, localize("k_reset"), G.C.FILTER)
    else status(src, (g.n >= 0 and "+" or "") .. tostring(g.n), G.C.FILTER) end
  end
end

local function seed_of(card, i)
  if R.cur_seed then return R.cur_seed .. "_" .. i end
  local c = card.config and card.config.center
  return "forge_" .. tostring(c and c.forge_id or "x") .. "_" .. i
end

local function apply_card(rule, i, card, src, context, other, phase, acc)
  if phase == "repeat" then
    for _, g in ipairs(rule.give) do
      if g.id == "retrigger" then acc.reps = math.min(R.MANY, (acc.reps or 0) + g.n) end
    end
    return
  end
  local held = context.cardarea == G.hand
  for _, g in ipairs(rule.give) do
    local n = g.n
    if g.id == "var_chips" or g.id == "var_mult" then n = g.n * var_val(card, g.var) end
    if R.SCORE_GIVE[g.id] then
      local kind = R.SCORE_GIVE[g.id]
      n = tonumber(R.AMOUNT[g.id](g, card, context, other)) or 0
      g = {id = kind, n = n, neg = R.NEG_GIVE and R.NEG_GIVE[g.id]}
    end
    if (g.id == "chips" or g.id == "var_chips") and not held then
      if n > 0 or (g.neg and n < 0) then acc.ret.chips = (acc.ret.chips or 0) + n end
    elseif g.id == "mult" or g.id == "var_mult" then
      if n > 0 or (g.neg and n < 0) then
        if held then acc.ret.h_mult = (acc.ret.h_mult or 0) + n else acc.ret.mult = (acc.ret.mult or 0) + n end
      end
    elseif g.id == "xmult" then
      if g.n ~= 1 then acc.ret.x_mult = (acc.ret.x_mult or 1) * g.n end
    elseif g.id == "xchips" then
      if g.n ~= 1 and not held then acc.forge_xchips = (acc.forge_xchips or 1) * g.n end
    elseif g.id ~= "retrigger" and g.id ~= "change" and g.id ~= "chips" and g.id ~= "var_chips" then side_effect(g, card, src, context, other, acc) end
  end
end

local function apply_main(rule, card, src, context, acc)
  for _, g in ipairs(rule.give) do
    if R.SCORE_GIVE[g.id] then g = {id = R.SCORE_GIVE[g.id], n = tonumber(R.AMOUNT[g.id](g, card, context, nil)) or 0, neg = R.NEG_GIVE and R.NEG_GIVE[g.id]} end
    if g.id == "chips" and (g.n == 0 or g.n < 0 and not g.neg) or g.id == "mult" and (g.n == 0 or g.n < 0 and not g.neg) or (g.id == "xmult" or g.id == "xchips") and g.n == 1 then
    elseif g.id == "chips" then acc.ret.chip_mod = (acc.ret.chip_mod or 0) + g.n
    elseif g.id == "mult" then acc.ret.mult_mod = (acc.ret.mult_mod or 0) + g.n
    elseif g.id == "var_chips" then
      local n = g.n * var_val(card, g.var)
      if n > 0 then acc.ret.chip_mod = (acc.ret.chip_mod or 0) + n end
    elseif g.id == "var_mult" then
      local n = g.n * var_val(card, g.var)
      if n > 0 then acc.ret.mult_mod = (acc.ret.mult_mod or 0) + n end
    elseif g.id == "xmult" then acc.ret.Xmult_mod = (acc.ret.Xmult_mod or 1) * g.n
    elseif g.id == "xchips" then acc.ret.Xchip_mod = (acc.ret.Xchip_mod or 1) * g.n
    else side_effect(g, card, src, context, nil, acc) end
  end
end

local function run_changes(rules, card, context)
  local hand = context.scoring_hand
  if not hand then return false end
  local any = false
  for i, rule in ipairs(rules) do
    if rule.when == "card_scored" then
      local changes = {}
      for _, g in ipairs(rule.give) do if g.id == "change" then changes[#changes + 1] = g end end
      if #changes > 0 then
        local ok, err = pcall(function()
          for _, other in ipairs(hand) do
            if not other.debuff and all_ok(rule, context, card, other, seed_of(card, i)) then
              for _, g in ipairs(changes) do R.change_card(other, g) end
              any = true
              G.E_MANAGER:add_event(Event({func = function() other:juice_up(); return true end}))
            end
          end
        end)
        if not ok then log_once(seed_of(card, i) .. "_change", "rule " .. i .. " failed: " .. tostring(err)) end
      end
    end
  end
  return any
end

local function destroy_phase(card, context, rules)
  local other = context.destroying_card
  local ctx = {scoring_name = G.GAME and G.GAME.last_hand_played, full_hand = context.full_hand}
  for i, rule in ipairs(rules) do
    if rule.when == "card_scored" then
      local wants = false
      for _, g in ipairs(rule.give or {}) do if g.id == "destroy_card" then wants = true end end
      if wants then
        local ok, r = pcall(all_ok, rule, ctx, card, other, seed_of(card, i))
        if ok and r then return true end
        if not ok then log_once(seed_of(card, i) .. "_destroy", "rule " .. i .. " failed: " .. tostring(r)) end
      end
    end
  end
  return nil
end

local calc

function R.calculate(card, context, rules, vars, opts)
  if type(opts) ~= "table" then return calc(card, context, rules, vars) end
  local ps, ph, pd, pz = R.cur_state, R.cur_host, R.cur_seed, R.dry
  R.cur_state, R.cur_host, R.cur_seed, R.dry = opts.state, opts.host, opts.seed, opts.dry or pz
  local ok, r = pcall(calc, card, context, rules, vars)
  R.cur_state, R.cur_host, R.cur_seed, R.dry = ps, ph, pd, pz
  if not ok then log_once("calc_" .. tostring(opts.seed), "rules of " .. tostring(opts.seed) .. " failed: " .. tostring(r)) return nil end
  return r
end

calc = function(card, context, rules, vars)
  local when, phase = R.trigger_of(context)
  if not when then return nil end
  if R.rule_refs and R.rule_refs(rules) then
    if type(vars) == "table" and #vars > 0 then R.vars_state(card, vars) end
    rules = R.resolve_refs(rules, card)
  end
  if phase == "destroy" then
    if context.blueprint then return nil end
    return destroy_phase(card, context, rules)
  end
  if when == "card_bought" and context.card == card then return nil end
  if when == "other_joker" and context.other_joker == card then return nil end
  local lose = when == "round_end" and context.game_over and not context.blueprint
  if R.cur_host == "card" and (context.forge_self or context.other_card) then
    if when == "card_scored" or when == "card_held" or when == "discard" or when == "round_end" then context.other_card = context.forge_self or context.other_card end
  end
  if type(vars) == "table" and #vars > 0 then R.vars_state(card, vars) end
  local src = context.blueprint_card or card
  local other = (R.CARD_WHEN[when] or R.cur_host == "card") and context.other_card or nil
  local acc = {ret = {}, when = when, card_ctx = R.CARD_WHEN[when]}
  if when == "self_sold" or when == "card_sold" then other = nil end
  if when == "before" and not context.blueprint then
    if run_changes(rules, card, context) then acc.changed = true end
  end
  for i, rule in ipairs(rules) do
    if rule.when == when or (lose and rule.when == "would_lose") then
      local ok, err = pcall(function()
        local list = rule
        if not all_ok(rule, context, card, other, seed_of(card, i)) then
          if not (rule.alt and #rule.alt > 0) then return end
          list = {give = rule.alt}
        end
        acc.fired = true
        if when == "card_scored" or when == "card_held" then
          apply_card(list, i, card, src, context, other, phase, acc)
        elseif when == "hand_played" or when == "other_joker" then
          apply_main(list, card, src, context, acc)
        else
          for _, g in ipairs(list.give) do side_effect(g, card, src, context, other, acc) end
        end
      end)
      if not ok then log_once(seed_of(card, i), "rule " .. i .. " of " .. tostring(card.config and card.config.center and card.config.center.key) .. " failed: " .. tostring(err)) end
    end
  end
  if when == "card_scored" and R.cur_host == "card" and phase ~= "repeat" then
    local x = R.state(card)
    if x.chips > 0 then acc.ret.chips = (acc.ret.chips or 0) + x.chips end
    if x.mult > 0 then acc.ret.mult = (acc.ret.mult or 0) + x.mult end
    if x.xmult > 1 then acc.ret.x_mult = (acc.ret.x_mult or 1) * x.xmult end
    if (tonumber(x.xchips) or 1) > 1 then acc.forge_xchips = (acc.forge_xchips or 1) * x.xchips end
  end
  if when == "hand_played" then
    local x = R.state(card)
    if x.chips > 0 then acc.ret.chip_mod = (acc.ret.chip_mod or 0) + x.chips end
    if x.mult > 0 then acc.ret.mult_mod = (acc.ret.mult_mod or 0) + x.mult end
    if x.xmult > 1 then acc.ret.Xmult_mod = (acc.ret.Xmult_mod or 1) * x.xmult end
    if x.xchips > 1 and R.cur_host ~= "card" then acc.ret.Xchip_mod = (acc.ret.Xchip_mod or 1) * x.xchips end
  end
  if phase == "repeat" then
    if acc.reps and acc.reps > 0 then return {message = localize("k_again_ex"), repetitions = acc.reps, card = src} end
    return nil
  end
  local ret = acc.ret
  if when == "card_scored" or when == "card_held" then
    if acc.forge_xchips and R.xchips_ret then R.xchips_ret(ret, acc.forge_xchips, src) end
    if next(ret) then ret.card = src; return ret end
    return nil
  end
  if when == "hand_played" or when == "other_joker" then
    if type(card_eval_status_text) == "function" then
      local main = ret.Xmult_mod and "x" or ret.Xchip_mod and "xc" or ret.mult_mod and "m" or ret.chip_mod and "c"
      if main ~= "xc" and ret.Xchip_mod then pcall(card_eval_status_text, src, "extra", nil, nil, nil, {message = msg_var("a_xmult", ret.Xchip_mod), colour = G.C.CHIPS}) end
      if main ~= "c" and ret.chip_mod then pcall(card_eval_status_text, src, "chips", ret.chip_mod) end
      if main ~= "m" and ret.mult_mod then pcall(card_eval_status_text, src, "mult", ret.mult_mod) end
    end
    if ret.Xmult_mod then ret.message = msg_var("a_xmult", ret.Xmult_mod)
    elseif ret.Xchip_mod then ret.message = msg_var("a_xmult", ret.Xchip_mod)
    elseif ret.mult_mod then ret.message = msg_var("a_mult", ret.mult_mod)
    elseif ret.chip_mod then ret.message = msg_var("a_chips", ret.chip_mod) end
    if ret.Xmult_mod or ret.mult_mod then ret.colour = G.C.MULT elseif ret.chip_mod or ret.Xchip_mod then ret.colour = G.C.CHIPS end
    if next(ret) then return ret end
    return nil
  end
  if acc.saved then return {message = localize("k_saved_ex"), saved = true, colour = G.C.RED, card = src} end
  if acc.remove then return {message = localize("k_extinct_ex"), colour = G.C.RED, remove = true, card = src} end
  if acc.changed then return {message = localize("k_upgrade_ex"), colour = G.C.MONEY, card = src} end
  return nil
end

function R.need_v(rules, vars)
  local need = 1
  local top = 0
  local function num(id, n)
    n = tonumber(n)
    if not n then return end
    if (R.V2_HI[id] and n > R.V2_HI[id]) or (R.V2_LO[id] and n < R.V2_LO[id]) then need = 3 return end
    if (R.OLD_HI[id] and n > R.OLD_HI[id]) or (R.OLD_LO[id] and n < R.OLD_LO[id]) then need = math.max(need, 2) end
  end
  local function id_of(id)
    if R.V8_IDS[id] then top = math.max(top, 8) end
    if R.V3_IDS[id] then need = 3 elseif R.NEW_IDS[id] then need = math.max(need, 2) end
  end
  for _, v in ipairs(type(vars) == "table" and vars or {}) do
    if type(v) == "table" then num("var_start", v.start) end
  end
  local list = type(rules) == "table" and rules or {}
  if #list > 6 then need = 3 end
  for _, r in ipairs(list) do
    if type(r) == "table" then
      id_of(r.when)
      for _, o in ipairs(type(r.only) == "table" and r.only or {}) do
        id_of(o.id)
        if R.own_id(o.id, o.v) then top = math.max(top, 6) end
        num(o.id == "money" and "money_cond" or o.id, o.n)
      end
      for _, l in ipairs({r.give, r.alt}) do
        for _, g in ipairs(type(l) == "table" and l or {}) do
          id_of(g.id)
          if R.V8_WHEN[g.id] and R.V8_WHEN[g.id][r.when] then top = math.max(top, 8) end
          if g.run then top = math.max(top, 8) end
          num(g.id, g.n)
          if g.id == "change" and g.what == "edition" then need = 3 end
          if g.id == "tag" and g.v == R.TAG_RANDOM then top = math.max(top, 5) end
          if g.id == "make_card" then top = math.max(top, 7) end
          if g.id == "copy_card" and g.v == "hand" then top = math.max(top, 8) end
          if R.own_id("tag", g.v) or R.own_id("enhancement", g.v) or R.own_id("seal", g.v) or R.own_id("edition", g.v) then top = math.max(top, 6) end
        end
      end
    end
  end
  return math.max(need, top)
end

R.member, R.compare, R.rank_ok, R.suit_ok, R.round_info, R.count_area, R.status, R.destroy, R.log_once = member, compare, card_rank_ok, card_suit_ok, round, count, status, destroy, log_once

R.NV_V = 14
R.MULT_NUM = {xmult = true, xchips = true, div_mult = true, blind_mult = true}

function R.num_ref(e)
  local i = type(e) == "table" and e.n ~= nil and tonumber(e.nv)
  if i and i % 1 == 0 and i >= 1 and i <= R.MAX_VARS then return i end
  return nil
end

function R.num_spec(e, cond)
  if type(e) ~= "table" then return nil end
  if e.run then return R.run_num and R.run_num(e.id) or nil end
  return R.NUM[cond and num_key(e.id) or e.id]
end

function R.live_num(e, raw, cond)
  local v = tonumber(raw)
  if not v or v ~= v then return e.n end
  local spec = R.num_spec(e, cond)
  local lo = 0
  if e.id == "chance" or e.id == "every" or R.MULT_NUM[e.id] or (spec and spec.fmt == "x") then lo = 1 end
  v = math.max(lo, math.min(spec and spec.hi or R.BIG, v))
  if spec and spec.step % 1 == 0 and spec.lo % 1 == 0 then return math.floor(v + 0.5) end
  return math.floor(v * 100 + 0.5) / 100
end

function R.nv_used(rules)
  for _, r in ipairs(type(rules) == "table" and rules or {}) do
    if type(r) == "table" then
      for _, k in ipairs({"only", "give", "alt"}) do
        for _, e in ipairs(type(r[k]) == "table" and r[k] or {}) do if R.num_ref(e) then return true end end
      end
    end
  end
  return false
end

function R.uses_new(rules, vars)
  return R.need_v(rules, vars) > 1
end

require("functions/forge/forge_blocks")(R)
require("functions/forge/forge_power3").rules(R)
require("functions/forge/forge_editions").rules(R)
require("functions/forge/forge_typedvars")(R)
require("functions/forge/forge_negative")(R)
require("functions/forge/forge_xchips")(R)

return R
end
