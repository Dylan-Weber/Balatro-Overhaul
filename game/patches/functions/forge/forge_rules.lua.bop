function R.own_item(what, v)
  if what == "card" then return R.own_card(v) end
  local id = R.own_id(what, v)
  local S = store()
  local c = id and S and S.get_item and S.get_item(id)
  if c and c.kind == R.OWN_KIND[what] then return c end
  return nil
end

function R.own_values(what)
  local out = {}
  local S = store()
  local kind = R.OWN_KIND[what]
  if not (kind and S and S.live_items) or R.listing then return out end
  R.listing = true
  local ok, all = pcall(S.live_items)
  R.listing = false
  local list = {}
  for _, c in ipairs(ok and type(all) == "table" and all or {}) do
    if c.kind == kind and c.enabled ~= false then list[#list + 1] = c end
  end
  table.sort(list, function(a, b) return tostring(a.id) < tostring(b.id) end)
  for _, c in ipairs(list) do out[#out + 1] = R.OWN_PREFIX[what] .. c.id end
  return out
end

function R.own_label(what, v)
  if not R.own_id(what, v) then return nil end
  local c = R.own_item(what, v)
  if c and c.name and c.name ~= "" then return c.name end
  return mod_loc and mod_loc("Lost card") or "Lost card"
end

function R.card_ok(v)
  return type(v) == "string" and #v <= 40 and v:match("^[jc]_[%w_]+$") ~= nil
end

function R.own_card(v)
  local S = store()
  if not S then return nil end
  local jid = R.own_id("joker", v)
  if jid then return S.get and S.get(jid) or nil end
  local cid = R.own_id("consumable", v)
  local c = cid and S.get_item and S.get_item(cid)
  if c and (c.kind == "tarot" or c.kind == "planet" or c.kind == "spectral") then return c end
  return nil
end

function R.card_usable(v)
  if not R.card_ok(v) then return false end
  local center = G and G.P_CENTERS and G.P_CENTERS[v]
  if not (center and R.CARD_SETS[center.set]) or center.forge_lost or center.forge_on == false then return false end
  if R.own_id("card", v) then
    local c = R.own_card(v)
    if not (c and c.enabled ~= false) then return false end
  end
  return true
end

function R.card_label(v)
  if R.own_id("card", v) then
    local c = R.own_card(v)
    if c and c.name and c.name ~= "" then return c.name end
    return mod_loc and mod_loc("Lost card") or "Lost card"
  end
  local center = G and G.P_CENTERS and G.P_CENTERS[v]
  local d = center and G.localization and G.localization.descriptions and G.localization.descriptions[center.set]
  local t = d and d[v]
  if t and t.name then return type(t.name) == "table" and table.concat(t.name, " ") or t.name end
  return tostring(v)
end

function R.card_values(set)
  local own, base = {}, {}
  local S = store()
  if S and set == "Joker" and S.live_jokers then
    for _, c in ipairs(S.live_jokers() or {}) do
      if c.enabled ~= false then own[#own + 1] = R.OWN_PREFIX.joker .. c.id end
    end
  elseif S and S.live_items and not R.listing then
    R.listing = true
    local ok, all = pcall(S.live_items)
    R.listing = false
    for _, c in ipairs(ok and type(all) == "table" and all or {}) do
      if c.enabled ~= false and (c.kind == "tarot" and set == "Tarot" or c.kind == "planet" and set == "Planet" or c.kind == "spectral" and set == "Spectral") then own[#own + 1] = R.OWN_PREFIX.consumable .. c.id end
    end
  end
  table.sort(own)
  for _, v in ipairs(G and G.P_CENTER_POOLS and G.P_CENTER_POOLS[set] or {}) do
    if type(v) == "table" and v.key and not v.forge and not v.forge_kind and not v.forge_lost and not R.own_id("card", v.key) and not tostring(v.key):find("draft") then base[#base + 1] = v.key end
  end
  for _, v in ipairs(base) do own[#own + 1] = v end
  return own
end

