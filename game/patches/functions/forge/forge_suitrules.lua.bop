l 44
          if type(v) == "table" and v.forge_suit == s.id and not X.rank_ok(s.c, v.value) then held[k] = v; G.P_CARDS[k] = nil end
        end
      end
    end
    local okr, res = pcall(orig, self, args, ...)
    for k, v in pairs(held) do G.P_CARDS[k] = v end
    if not okr then error(res, 0) end
    if fresh then pcall(X.add_copies) end
    return res
  end end, {id = "forge_suitrules.start_run"})
  if type(generate_card_ui) == "function" then
    local base_gen = generate_card_ui
    generate_card_ui = function(center, full, ...)
      local r = base_gen(center, full, ...)
      if full == nil and type(r) == "table" and type(center) == "table" and (center.set == "Default" or center.set == "Enhanced") then
        local card = HR.describing
        local s = card and X.own_of(card)
        local O = G.localization and G.localization.descriptions and G.localization.descriptions.Other
        if s and O and O["forge_suit_" .. s.c.id] then pcall(base_gen, {set = "Other", key = "forge_suit_" .. s.c.id}, r) end
      end
      return r
    end
  end
end

function X.suit_fronts(v)
  local R = Rules()
  local S = Suits()
  local key = R and R.suit_key(v) or v
  local s = S.by_key and S.by_key[key or ""]
  local out = {}
  for k, p in pairs(G.P_CARDS or {}) do
    if type(p) == "table" and p.suit == key and p.value and X.RANK_ID[tostring(p.value)] and (not s or X.rank_ok(s.c, p.value)) then out[#out + 1] = k end
  end
  table.sort(out, function(a, b) return X.RANK_ID[tostring(G.P_CARDS[a].value)] < X.RANK_ID[tostring(G.P_CARDS[b].value)] end)
  return out
end

function X.add_suit(v, copies)
  if not (G.playing_cards and G.deck and G.P_CARDS) then return 0 end
  local fronts = X.suit_fronts(v)
  local made = 0
  for _ = 1, math.max(1, math.min(10, math.floor(tonumber(copies) or 1))) do
    for _, k in ipairs(fronts) do
r 3 1207 %20%20%20%20%20%20 -
l 25
      local card = rawget(_G, "Card")(G.deck.T.x, G.deck.T.y, G.CARD_W, G.CARD_H, G.P_CARDS[k], G.P_CENTERS.c_base, {playing_card = G.playing_card})
      card:add_to_deck()
      G.playing_cards[#G.playing_cards + 1] = card
      G.deck:emplace(card)
      made = made + 1
    end
  end
  if made > 0 then
    G.deck.config.card_limit = #G.playing_cards
    G.GAME.starting_deck_size = #G.playing_cards
  end
  return made
end

function X.add_copies()
  local S = Suits()
  if not (G.playing_cards and G.deck) then return end
  local any = false
  for _, s in ipairs(S.list) do
    local n = X.fields(s.c).copies
    if n > 1 then
      local base = {}
      for _, c in ipairs(G.playing_cards) do if c.base and c.base.suit == s.key then base[#base + 1] = c end end
      for _, c in ipairs(base) do
        for _ = 2, n do
r 3 1207 %20%20%20%20%20%20%20%20%20%20 -
l 46
          local copy = copy_card(c, nil, nil, G.playing_card)
          copy:add_to_deck()
          G.playing_cards[#G.playing_cards + 1] = copy
          G.deck:emplace(copy)
          any = true
        end
      end
    end
  end
  if any then
    G.deck.config.card_limit = #G.playing_cards
    G.GAME.starting_deck_size = #G.playing_cards
  end
end

