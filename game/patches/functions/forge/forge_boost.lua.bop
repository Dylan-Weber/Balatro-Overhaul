    local info = B.info_of(self)
    if info and #info.retrigger > 0 then
      S.optional_features = S.optional_features or {}
      S.optional_features.retrigger_joker = true
    end
    if context.retrigger_joker_check then return B.smods_check(self, context, r) end
  end
