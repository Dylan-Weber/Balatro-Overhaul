local B = {}

B.V = 16
B.TARGETS = {"right", "left", "both", "all"}
B.PASSIVE = {"boost_retrigger", "boost_double"}
B.GAINS = {"boost_mult", "boost_chips", "boost_xmult"}
B.IDS = {boost_retrigger = true, boost_double = true, boost_mult = true, boost_chips = true, boost_xmult = true}
B.STAT = {boost_mult = "mult", boost_chips = "chips", boost_xmult = "xmult"}
B.RETRIGGER_CTX = {"joker_main", "individual", "repetition", "before", "other_joker"}
B.DOUBLE_CTX = {"joker_main", "individual", "repetition", "before", "after", "other_joker", "end_of_round", "discard"}

local ADD_M = {"mult_mod", "mult", "h_mult"}
local X_M = {"Xmult_mod", "x_mult", "xmult", "Xmult"}
local ADD_C = {"chip_mod", "chips", "h_chips"}
local X_C = {"Xchip_mod", "x_chips", "xchips", "Xchips"}
local SUM = {"dollars", "p_dollars", "h_dollars", "repetitions"}
local MONEY = {dollars = true, p_dollars = true, h_dollars = true}
local MSG = {{"Xmult_mod", "a_xmult"}, {"x_mult", "a_xmult"}, {"xmult", "a_xmult"}, {"Xchip_mod", "a_xmult"}, {"mult_mod", "a_mult"}, {"chip_mod", "a_chips"}, {"dollars", "a_dollars"}}

