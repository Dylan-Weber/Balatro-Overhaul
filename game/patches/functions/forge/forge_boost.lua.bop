B.TEXT = TEXT

B.LABEL_GIVE = {boost_retrigger = "Retrigger a Joker", boost_double = "A Joker gives more", boost_mult = "A Joker gains Mult", boost_chips = "A Joker gains Chips", boost_xmult = "A Joker gains XMult"}
B.LABEL_TARGET = {right = "Joker to the right", left = "Joker to the left", both = "Both neighbours", all = "Every other Joker"}
B.SHORT = {right = "(right)", left = "(left)", both = "(sides)", all = "(all)"}
B.CHIP = {boost_retrigger = "Retrigger", boost_double = "Gives more", boost_mult = "Gains Mult", boost_chips = "Gains Chips", boost_xmult = "Gains XMult"}

local LOC = {
  fr = {
    ["Retrigger a Joker"] = "Redéclencher un Joker", ["A Joker gives more"] = "Un Joker donne plus", ["A Joker gains Mult"] = "Un Joker gagne du Multi",
