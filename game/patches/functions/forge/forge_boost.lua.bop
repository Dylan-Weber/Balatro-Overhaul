  r = B.one(self, context, r, k, dbl)
  if reps <= 0 then return r end
  local list = {r}
  for _ = 1, reps do
    local x = orig(self, context, ...)
    list[#list + 1] = B.one(self, context, x, k, dbl)
  end
  local jokerish = context.joker_main or context.other_joker or context.before
  local direct = #list > 1 and B.live(context)
  for i = 1, #list - 1 do
    if list[i + 1] then
      if direct then B.apply(list[i]) end
      if jokerish and list[i] and list[i].message and type(gl("card_eval_status_text")) == "function" then
        pcall(status_text, list[i].card or self, "jokers", nil, nil, nil, list[i])
      end
      B.again(who and who[i])
    end
  end
  local E = exp_mod()
  if direct and E and E.main and E.main(list[#list]) then E.bake(list[#list]) end
  local out = B.merge(list, context)
  if not direct or not out then return out end
  local tail = B.merge({list[#list]}, context) or {}
  for _, l in ipairs({ADD_M, X_M, ADD_C, X_C}) do for _, key in ipairs(l) do out[key] = tail[key] end end
  local done = {}
  for i = 1, #list - 1 do done[i] = list[i] end
  out.forge_applied = done
  return out
end

function B.dollar(self, n)
  if self.debuff or not tonumber(n) or n == 0 then return n end
  local _, k = B.hits(self)
  if k == 1 then return n end
  return math.floor(n * k + 0.5)
end

local function gain(g, card, src, context)
  if context.blueprint then return end
  local stat = B.STAT[g.id]
  local n = tonumber(g.n) or 0
  if not stat or n == 0 then return end
  local R = rules_mod()
  for _, t in ipairs(B.targets(card, g.v)) do
    B.add(t, stat, n)
    if R and R.status then R.status(t, localize_("k_upgrade_ex"), stat == "chips" and G.C.CHIPS or G.C.MULT) end
  end
end

function B.line(card, lang)
  local m, c, x = B.bonus_of(card)
  if not m then return nil end
  local parts = {lt(lang).boosted}
  local L = TEXT[lang] and lang or "en"
  local word = ({en = {"Mult", "Chips"}, fr = {"Multi", "jetons"}, es = {"multi", "fichas"}})[L]
  if m ~= 0 then parts[#parts + 1] = "{C:mult}" .. (m < 0 and "-" or "+") .. fmt(math.abs(m)) .. "{} " .. word[1] end
  if c ~= 0 then parts[#parts + 1] = "{C:chips}" .. (c < 0 and "-" or "+") .. fmt(math.abs(c)) .. "{} " .. word[2] end
  if x ~= 1 then parts[#parts + 1] = "{X:mult,C:white} X" .. fmt(x) .. " {} " .. word[1] end
  return table.concat(parts, " ")
end

function B.add_line(card, r)
  if type(r) ~= "table" or type(r.main) ~= "table" then return end
  local lang = G.SETTINGS and G.SETTINGS.language or "en"
  lang = lang:sub(1, 2)
  local line = B.line(card, lang)
  local parse = gl("loc_parse_string")
  if not (line and parse and G.localization and G.localization.descriptions) then return end
  local O = G.localization.descriptions.Other
  if not O then return end
  O.forge_boosted = {name = "", text = {line}, text_parsed = {parse(line)}, name_parsed = {}}
  local nodes = {}
  gl("localize"){type = "other", key = "forge_boosted", nodes = nodes, vars = {}}
  for _, l in ipairs(nodes) do r.main[#r.main + 1] = l end
end

function B.rules(R)
  for _, id in ipairs(B.PASSIVE) do if not member(R.GIVE, id) then R.GIVE[#R.GIVE + 1] = id end end
  for _, id in ipairs(B.GAINS) do if not member(R.GIVE, id) then R.GIVE[#R.GIVE + 1] = id end end
  local JOKER = {joker = true}
  for id in pairs(B.IDS) do R.HOST_GIVE[id] = JOKER end
  local P = require("functions/forge/forge_power3")
  if P.PASS then for _, id in ipairs(B.PASSIVE) do P.PASS[id] = true end end
  R.NUM.boost_retrigger = {def = 1, lo = 1, hi = 10, step = 1, big = 5}
  R.NUM.boost_double = {def = 2, lo = 1.1, hi = 100, step = 0.1, big = 1}
  R.NUM.boost_mult = {def = 2, lo = 1, hi = R.BIG, step = 1, big = 5}
  R.NUM.boost_chips = {def = 10, lo = 1, hi = R.BIG, step = 1, big = 10}
  R.NUM.boost_xmult = {def = 0.1, lo = 0.05, hi = R.BIG, step = 0.05, big = 0.5}
  for id in pairs(B.IDS) do
    R.DEFAULT_GIVE[id] = function() return {id = id, v = "right", n = R.NUM[id].def} end
    R.CLEAN_GIVE[id] = function(e) if not member(B.TARGETS, e.v) then e.v = "right" end end
    R.TEXT_GIVE[id] = function(g, s, lang) return B.text(g, lang) end
    R.LABEL_GIVE[id] = B.LABEL_GIVE[id]
    R.SIMPLE_GIVE[id] = true
  end
  for _, id in ipairs(B.GAINS) do R.DOS[id] = gain end
  R.VALUES_GIVE = R.VALUES_GIVE or {}
  local function targets()
    local out = {}
    for _, v in ipairs(B.TARGETS) do out[#out + 1] = {label = loc(B.LABEL_TARGET[v]), value = v} end
    return out
  end
  for id in pairs(B.IDS) do R.VALUES_GIVE[id] = targets end
  R.NUM_LABEL = R.NUM_LABEL or {}
  for id in pairs(B.IDS) do
    R.NUM_LABEL[id] = function(g) return loc(B.CHIP[id]) .. " " .. loc(B.SHORT[g.v] or B.SHORT.right) end
  end
  R.NUM_FMT = R.NUM_FMT or {}
  R.NUM_FMT.boost_double = function(v) return "X" .. fmt(v) end
  local base_need = R.need_v
  function R.need_v(rules, vars)
    local need = base_need(rules, vars)
    for _, r in ipairs(type(rules) == "table" and rules or {}) do
      for _, l in ipairs(type(r) == "table" and {r.give, r.alt} or {}) do
        for _, g in ipairs(type(l) == "table" and l or {}) do
          if type(g) == "table" and B.IDS[g.id] then need = math.max(need, B.V) end
        end
      end
    end
    return need
  end
  if gl("mod_loc_register") then gl("mod_loc_register")(LOC) end
end

local function wrap(obj, name, make)
  if obj and type(obj[name]) == "function" then obj[name] = make(obj[name]) end
end

local function log(key, err)
  B.logged = B.logged or {}
  if B.logged[key] then return end
  B.logged[key] = true
  print("[FORGE] boost " .. key .. " failed: " .. tostring(err))
end

function B.install()
  local Card = gl("Card")
  if B.hooked or not Card then return end
  B.hooked = true
  wrap(Card, "calculate_joker", function(orig) return function(self, context, ...)
    local r, r2 = orig(self, context, ...)
    if type(context) ~= "table" or not (self.ability and self.ability.set == "Joker") then return r, r2 end
    local ok, nr = pcall(B.after, orig, self, context, r, ...)
    if ok then return nr, r2 end
    log("calc", nr)
    return r, r2
  end end)
  wrap(Card, "calculate_dollar_bonus", function(orig) return function(self, ...)
    local n = orig(self, ...)
    if not (self.ability and self.ability.set == "Joker") then return n end
    local ok, v = pcall(B.dollar, self, n)
    if ok then return v end
    log("dollars", v)
    return n
  end end)
  wrap(Card, "generate_UIBox_ability_table", function(orig) return function(self, ...)
    local r = orig(self, ...)
    if self.ability and self.ability.forge_boost then
      local ok, err = pcall(B.add_line, self, r)
      if not ok then log("text", err) end
    end
    return r
  end end)
end

return B
end
