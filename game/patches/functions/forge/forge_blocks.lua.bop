      played_rank = "la mano tiene un {C:attention}%s{} que anota", played_suit = "la mano tiene una carta de {C:%s}%s{} que anota", played_colour = "la mano tiene una carta {C:%s}%s{} que anota", colour = {red = "roja", black = "negra"},
      all_suits = "la mano tiene una carta de {C:diamonds}Diamantes{}, {C:clubs}Tréboles{}, {C:hearts}Corazones{} y {C:spades}Picas{}",
      suit_and_other = "la mano tiene una carta de {C:%s}%s{} que anota y una carta de otro palo que anota",
      held_all = "todas las cartas en la mano son %s",
      played_this_round = "esta {C:attention}mano de póker{} ya se jugó en esta ronda",
      most_played = "es tu mano de póker {C:attention}más jugada{}",
      first_discard = "es el {C:attention}primer descarte{} de la ronda",
      once_per_discard = "es la {C:attention}última{} carta del descarte",
      discarded = "el descarte tiene %s {C:attention}%d{} %s", deck_count = "tu baraja completa tiene %s {C:attention}%d{} %s",
      used_kind = "es una carta de {C:%s}%s{}", enhanced = "tiene una {C:attention}mejora{}",
      no_discard = "no se usó ningún {C:red}descarte{} en esta ronda", lowest_held = "es la carta de {C:attention}menor{} valor en la mano",
      reset_gains = "las ganancias de este joker se reinician", var_xmult = "{X:mult,C:white} X%s {} multi por cada {C:attention}%s{}",
      var_money = "gana {C:money}$%s{} por cada {C:attention}%s{}", rand_mult = "de {C:mult}+0{} a {C:mult}+%s{} multi",
      rank_mult = "suma {C:attention}%s{} veces su valor al multi", lose_discards = "pierdes todos los {C:red}descartes{}",
      create_rarity1 = "crea un joker {C:%s}%s{}", create_rarity = "crea {C:attention}%s{} jokers {C:%s}%s{}",
      add_to_hand_random = "añade a tu mano una carta al azar con un {C:attention}sello{} al azar", add_to_hand = "añade a tu mano una carta al azar con un {C:attention}%s{}",
      level_up_discard = "sube de nivel la {C:attention}mano de póker{} descartada",
      rarity = {Common = "común", Uncommon = "poco común", Rare = "raro", Legendary = "legendario"},
      rarities = {Common = "comunes", Uncommon = "poco comunes", Rare = "raros", Legendary = "legendarios"},
      kinds = {Tarot = "Tarot", Planet = "Planeta", Spectral = "Espectral"},
      match = {any = "cartas", enhanced = "cartas mejoradas", face = "figuras", number = "cartas numéricas", even = "cartas pares", odd = "cartas impares", red = "cartas rojas", black = "cartas negras"},
      rank_cards = "cartas de valor %s", suit_cards = "%s", enh_cards = "%s",
      red_held = "{C:hearts}Corazones{} o {C:diamonds}Diamantes{}", black_held = "{C:spades}Picas{} o {C:clubs}Tréboles{}",
      face = "figura", number = "carta numérica", even = "carta par", odd = "carta impar",
    },
  }
  R.BLOCK_TEXT = L
  for lang, t in pairs(L) do
    if T.S[lang] then T.S[lang].level_up_discard = t.level_up_discard end
  end

  local SUIT_COL = {Hearts = "hearts", Diamonds = "diamonds", Spades = "spades", Clubs = "clubs", red = "red", black = "spades"}
  local KIND_COL = {Tarot = "tarot", Planet = "planet", Spectral = "spectral"}
  local RARITY_COL = {Common = "blue", Uncommon = "green", Rare = "red", Legendary = "legendary"}

  local function lt(lang) return L[lang] or L.en end
  local function op_word(s, o) return s[o.op or "at_least"] or s.at_least end

  function R.match_label(v, lang, plural)
    local l = lt(lang)
    if l.match[v] then return l.match[v] end
    if tonumber(v) then return string.format(l.rank_cards, T.rank_name(v, lang)) end
    if R.member(R.FOUR_SUITS, v) then return string.format(l.suit_cards, T.suit_name(v, true)) end
    return string.format(l.enh_cards, T.enh_name(v))
  end

  local TO = R.TEXT_ONLY
  for _, id in ipairs({"first_scored", "all_suits", "played_this_round", "most_played", "first_discard", "once_per_discard", "enhanced", "no_discard", "lowest_held"}) do
    TO[id] = function(o, s, lang) return lt(lang)[id] end
  end
  TO.played_rank = function(o, s, lang)
    local l = lt(lang)
    local name = l[o.v] or T.rank_name(o.v, lang)
    return string.format(l.played_rank, name)
  end
  TO.played_suit = function(o, s, lang)
    local l = lt(lang)
    if o.v == "red" or o.v == "black" then return string.format(l.played_colour, SUIT_COL[o.v], l.colour[o.v]) end
    return string.format(l.played_suit, SUIT_COL[o.v] or "attention", T.suit_name(o.v))
  end
  TO.suit_and_other = function(o, s, lang) return string.format(lt(lang).suit_and_other, SUIT_COL[o.v] or "attention", T.suit_name(o.v)) end
  TO.held_all = function(o, s, lang)
    local l = lt(lang)
    local what = o.v == "red" and l.red_held or o.v == "black" and l.black_held or string.format("{C:%s}%s{}", SUIT_COL[o.v] or "attention", T.suit_name(o.v, true))
    return string.format(l.held_all, what)
  end
  TO.discarded = function(o, s, lang) return string.format(lt(lang).discarded, op_word(s, o), tonumber(o.n) or 0, R.match_label(o.v, lang)) end
  TO.deck_count = function(o, s, lang) return string.format(lt(lang).deck_count, op_word(s, o), tonumber(o.n) or 0, R.match_label(o.v, lang)) end
  TO.used_kind = function(o, s, lang) return string.format(lt(lang).used_kind, KIND_COL[o.v] or "tarot", lt(lang).kinds[o.v] or o.v) end

  local TG = R.TEXT_GIVE
  TG.reset_gains = function(g, s, lang) return lt(lang).reset_gains end
  TG.lose_discards = function(g, s, lang) return lt(lang).lose_discards end
  TG.var_xmult = function(g, s, lang, vars) return string.format(lt(lang).var_xmult, T.fmt_n(g.n), T.var_name(vars, g.var)) end
  TG.var_money = function(g, s, lang, vars) return string.format(lt(lang).var_money, T.fmt_n(g.n), T.var_name(vars, g.var)) end
  TG.rand_mult = function(g, s, lang) return string.format(lt(lang).rand_mult, T.fmt_n(g.n)) end
  TG.rank_mult = function(g, s, lang) return string.format(lt(lang).rank_mult, T.fmt_n(g.n)) end
  TG.create_rarity = function(g, s, lang)
    local l = lt(lang)
    local n = math.floor(tonumber(g.n) or 1)
    if n <= 1 then return string.format(l.create_rarity1, RARITY_COL[g.v] or "blue", l.rarity[g.v] or g.v) end
    return string.format(l.create_rarity, n, RARITY_COL[g.v] or "blue", l.rarities[g.v] or g.v)
  end
  TG.add_to_hand = function(g, s, lang)
    local l = lt(lang)
    if g.v == "random" then return l.add_to_hand_random end
    return string.format(l.add_to_hand, T.seal_name(g.v))
  end

  local LO, LG = R.LABEL_ONLY, R.LABEL_GIVE
  LO.first_scored, LO.played_rank, LO.played_suit, LO.all_suits = "First to score", "Hand has a rank", "Hand has a suit", "Hand has every suit"
  LO.suit_and_other, LO.held_all, LO.played_this_round, LO.most_played = "A suit and another suit", "All held cards are", "Hand already played", "Most played hand"
  LO.first_discard, LO.once_per_discard, LO.discarded, LO.used_kind = "First discard", "Once per discard", "Cards discarded", "Consumable type"
  LO.enhanced, LO.deck_count, LO.no_discard, LO.lowest_held = "Has an enhancement", "Cards in full deck", "No discard used", "Lowest held card"
  LG.reset_gains, LG.var_xmult, LG.var_money, LG.rand_mult = "Reset its gains", "XMult for each point", "Money for each point", "Random Mult"
  LG.rank_mult, LG.lose_discards, LG.create_rarity, LG.add_to_hand = "Mult from its rank", "Lose all discards", "Create a Joker by rarity", "Add a card to hand"
  R.FILTER_ONLY.discarded = true
  R.FILTER_ONLY.deck_count = true
  R.SIMPLE_ONLY.played_suit = true
  R.SIMPLE_ONLY.played_rank = true
  R.SIMPLE_GIVE.rand_mult = true
  R.SIMPLE_GIVE.create_rarity = true

  if mod_loc_register then
    mod_loc_register{
      fr = {
        ["First to score"] = "Première à marquer", ["Hand has a rank"] = "La main a une valeur", ["Hand has a suit"] = "La main a une couleur", ["Hand has every suit"] = "La main a toutes les couleurs",
        ["A suit and another suit"] = "Une couleur et une autre", ["All held cards are"] = "Toutes les cartes en main", ["Hand already played"] = "Main déjà jouée", ["Most played hand"] = "Main la plus jouée",
        ["First discard"] = "Première défausse", ["Once per discard"] = "Une fois par défausse", ["Cards discarded"] = "Cartes défaussées", ["Consumable type"] = "Type de consommable",
        ["Has an enhancement"] = "A une amélioration", ["Cards in full deck"] = "Cartes du jeu complet", ["No discard used"] = "Aucune défausse utilisée", ["Lowest held card"] = "Plus faible carte en main",
        ["Reset its gains"] = "Remet ses gains à zéro", ["XMult for each point"] = "XMulti par point", ["Money for each point"] = "Argent par point", ["Random Mult"] = "Multi au hasard",
        ["Mult from its rank"] = "Multi selon sa valeur", ["Lose all discards"] = "Perd toutes les défausses", ["Create a Joker by rarity"] = "Crée un Joker d'une rareté", ["Add a card to hand"] = "Ajoute une carte en main",
        ["XMult for each %s"] = "XMulti par %s", ["Money for each %s"] = "Argent par %s", ["WHICH CARDS?"] = "QUELLES CARTES ?", ["Random seal"] = "Sceau au hasard",
        ["Any card"] = "N'importe quelle carte", ["Enhanced card"] = "Carte améliorée", ["Common"] = "Commun", ["Uncommon"] = "Peu commun", ["Rare"] = "Rare", ["Legendary"] = "Légendaire",
      },
      es = {
        ["First to score"] = "Primera en anotar", ["Hand has a rank"] = "La mano tiene un valor", ["Hand has a suit"] = "La mano tiene un palo", ["Hand has every suit"] = "La mano tiene todos los palos",
        ["A suit and another suit"] = "Un palo y otro palo", ["All held cards are"] = "Todas las cartas en mano", ["Hand already played"] = "Mano ya jugada", ["Most played hand"] = "Mano más jugada",
        ["First discard"] = "Primer descarte", ["Once per discard"] = "Una vez por descarte", ["Cards discarded"] = "Cartas descartadas", ["Consumable type"] = "Tipo de consumible",
        ["Has an enhancement"] = "Tiene una mejora", ["Cards in full deck"] = "Cartas de la baraja completa", ["No discard used"] = "Ningún descarte usado", ["Lowest held card"] = "Carta más baja en mano",
        ["Reset its gains"] = "Reinicia sus ganancias", ["XMult for each point"] = "XMulti por punto", ["Money for each point"] = "Dinero por punto", ["Random Mult"] = "Multi al azar",
        ["Mult from its rank"] = "Multi según su valor", ["Lose all discards"] = "Pierde todos los descartes", ["Create a Joker by rarity"] = "Crea un joker por rareza", ["Add a card to hand"] = "Añade una carta a la mano",
        ["XMult for each %s"] = "XMulti por cada %s", ["Money for each %s"] = "Dinero por cada %s", ["WHICH CARDS?"] = "¿QUÉ CARTAS?", ["Random seal"] = "Sello al azar",
        ["Any card"] = "Cualquier carta", ["Enhanced card"] = "Carta mejorada", ["Common"] = "Común", ["Uncommon"] = "Poco común", ["Rare"] = "Raro", ["Legendary"] = "Legendario",
      },
    }
  end
  R.COUNTS = {"jokers", "empty_slots", "consumables", "deck_left", "deck_match", "held_match", "scoring_match", "destroyed_match", "discards_left", "hands_left", "money", "money_5", "sell_others", "times_played", "planets_used", "hands_run", "discards_unused", "below_deck"}
  R.COUNT_MATCH = {deck_match = true, held_match = true, scoring_match = true, destroyed_match = true}
  R.COUNT_WHEN = {scoring_match = HAND, times_played = HAND, destroyed_match = {cards_destroyed = true}}
  R.PER_GIVE = {chips_per = "chips", mult_per = "mult", xmult_per = "xmult", money_per = "money", gain_mult_per = "gain_mult", gain_xmult_per = "gain_xmult"}

  function R.count_ok(when, per)
    if not R.member(R.COUNTS, per) then return false end
    return not R.COUNT_WHEN[per] or R.COUNT_WHEN[per][when] or false
  end

  local function each(list, v, skip_debuff)
    local n = 0
    for _, c in ipairs(list or {}) do
      if not (skip_debuff and c.debuff) and R.card_match(c, v) then n = n + 1 end
    end
    return n
  end

  local function dollars() return math.max(0, (G.GAME and G.GAME.dollars or 0) + (G.GAME and G.GAME.dollar_buffer or 0)) end

  local COUNT = {
    jokers = function() return R.count_area(G.jokers) end,
    empty_slots = function() return math.max(0, (G.jokers and G.jokers.config and G.jokers.config.card_limit or 0) - R.count_area(G.jokers)) end,
    consumables = function() return R.count_area(G.consumeables) end,
    deck_left = function() return R.count_area(G.deck) end,
    deck_match = function(g) return each(G.playing_cards, g.m) end,
    held_match = function(g) return each(G.hand and G.hand.cards, g.m) end,
    scoring_match = function(g, card, context) return each(context.scoring_hand, g.m, true) end,
    destroyed_match = function(g, card, context) return each(type(context.removed) == "table" and context.removed, g.m) end,
    discards_left = function() return tonumber(R.round_info().discards_left) or 0 end,
    hands_left = function() return tonumber(R.round_info().hands_left) or 0 end,
    money = function() return dollars() end,
    money_5 = function() return math.floor(dollars() / 5) end,
    sell_others = function(g, card)
      local n = 0
      for _, j in ipairs(G.jokers and G.jokers.cards or {}) do
        if j ~= card then n = n + (tonumber(j.sell_cost) or 0) end
      end
      return n
    end,
    times_played = function(g, card, context)
      local h = context.scoring_name and G.GAME.hands and G.GAME.hands[context.scoring_name]
      return h and tonumber(h.played) or 0
    end,
    planets_used = function()
      local n = 0
      for _, v in pairs(G.GAME and G.GAME.consumeable_usage or {}) do
        if type(v) == "table" and v.set == "Planet" then n = n + 1 end
      end
      return n
    end,
    hands_run = function() return tonumber(G.GAME and G.GAME.hands_played) or 0 end,
    discards_unused = function() return tonumber(G.GAME and G.GAME.unused_discards) or 0 end,
    below_deck = function() return math.max(0, (tonumber(G.GAME and G.GAME.starting_deck_size) or 52) - #(G.playing_cards or {})) end,
  }
  R.COUNT = COUNT

  function R.count_of(g, card, context)
    local f = COUNT[g.per]
    if not f then return 0 end
    local ok, n = pcall(f, g, card, context or {})
    return ok and tonumber(n) or 0
  end

  local NUM2 = {
    chips_per = {def = 2, lo = 1, hi = R.BIG, step = 1, big = 10},
    mult_per = {def = 1, lo = 1, hi = R.BIG, step = 1, big = 5},
    xmult_per = {def = 0.2, lo = 0.01, hi = R.BIG, step = 0.01, big = 1},
    money_per = {def = 1, lo = 1, hi = R.BIG, step = 1, big = 5},
    gain_mult_per = {def = 1, lo = 1, hi = R.BIG, step = 1, big = 5},
    gain_xmult_per = {def = 0.1, lo = 0.01, hi = R.BIG, step = 0.01, big = 1},
  }
  for k, v in pairs(NUM2) do R.NUM[k] = v end
  add_ids(R.GIVE, {"chips_per", "mult_per", "xmult_per", "money_per", "gain_mult_per", "gain_xmult_per", "strip_enh"})
  R.GIVE_WHEN.chips_per = {card_scored = true, hand_played = true}
  R.GIVE_WHEN.mult_per = SCORE
  R.GIVE_WHEN.xmult_per = SCORE
  R.GIVE_WHEN.strip_enh = {before = true}
  for _, id in ipairs({"chips_per", "mult_per", "xmult_per", "gain_mult_per", "gain_xmult_per"}) do R.HOST_GIVE[id] = ALL3 end
  R.HOST_GIVE.strip_enh = {joker = true, run = true}

  local DEF_PER = {chips_per = "discards_left", mult_per = "jokers", xmult_per = "deck_match", money_per = "discards_left", gain_mult_per = "jokers", gain_xmult_per = "destroyed_match"}
  for id, per in pairs(DEF_PER) do
    R.DEFAULT_GIVE[id] = function()
      local g = {id = id, n = NUM2[id].def, per = per}
      if R.COUNT_MATCH[per] then g.m = id == "gain_xmult_per" and "m_glass" or "m_steel" end
      return g
    end
    R.CLEAN_GIVE[id] = function(e, when)
      e.per = R.member(R.COUNTS, e.per) and e.per or "jokers"
      if when and not R.count_ok(when, e.per) then e.per = "jokers" end
      if R.COUNT_MATCH[e.per] then
        if not match_ok(e.m) then e.m = "any" end
      else
        e.m = nil
      end
    end
  end
  R.DEFAULT_GIVE.strip_enh = function() return {id = "strip_enh"} end

  for id, kind in pairs({chips_per = "chips", mult_per = "mult"}) do
    R.SCORE_GIVE[id] = kind
    R.AMOUNT[id] = function(g, card, context) return g.n * R.count_of(g, card, context) end
  end
  R.SCORE_GIVE.xmult_per = "xmult"
  R.AMOUNT.xmult_per = function(g, card, context) return 1 + g.n * R.count_of(g, card, context) end

  D.money_per = function(g, card, src, context, other, out)
    local n = g.n * R.count_of(g, card, context)
    if n <= 0 then return end
    if out.card_ctx and out.when == "card_scored" then
      out.ret.dollars = (out.ret.dollars or 0) + n
    else
      ease_dollars(n)
      R.status(src, localize("$") .. T.fmt_n(n), G.C.MONEY)
    end
  end
  local function gain_per(field)
    return function(g, card, src, context)
      if context.blueprint then return end
      local n = g.n * R.count_of(g, card, context)
      if n <= 0 then return end
      local x = R.state(card)
      if field == "xmult" then x.xmult = math.floor((x.xmult + n) * 100 + 0.5) / 100 else x.mult = x.mult + n end
      R.status(src, localize("k_upgrade_ex"), G.C.MULT)
    end
  end
  D.gain_mult_per = gain_per("mult")
  D.gain_xmult_per = gain_per("xmult")
  D.strip_enh = function(g, card, src, context)
    if context.blueprint then return end
    local any = false
    for _, c in ipairs(context.scoring_hand or {}) do
      if not c.debuff and enhanced(c) and not c.forge_stripped then
        c.forge_stripped = true
        any = true
        c:set_ability(G.P_CENTERS.c_base, nil, true)
        G.E_MANAGER:add_event(Event({func = function() c:juice_up(); c.forge_stripped = nil; return true end}))
      end
    end
    if any then R.status(src, localize("k_upgrade_ex"), G.C.MULT) end
  end

  local P = {
    en = {
      chips_per = "{C:chips}+%s{} Chips for each %s", mult_per = "{C:mult}+%s{} Mult for each %s", xmult_per = "{X:mult,C:white} X%s {} Mult for each %s",
      money_per = "earn {C:money}$%s{} for each %s", gain_mult_per = "this joker gains {C:mult}+%s{} Mult for each %s", gain_xmult_per = "this joker gains {X:mult,C:white} X%s {} Mult for each %s",
      strip_enh = "scoring cards lose their {C:attention}enhancement{}",
      counts = {jokers = "{C:attention}Joker{} you have", empty_slots = "empty {C:attention}Joker{} slot", consumables = "{C:attention}consumable{} you have", deck_left = "card left in your {C:attention}deck{}",
        deck_match = "%s in your {C:attention}full deck{}", held_match = "%s held in hand", scoring_match = "scoring %s", destroyed_match = "destroyed %s",
        discards_left = "{C:red}discard{} left", hands_left = "{C:blue}hand{} left", money = "{C:money}$1{} you have", money_5 = "{C:money}$5{} you have",
        sell_others = "{C:money}$1{} of sell value of your other {C:attention}Jokers{}", times_played = "time this {C:attention}poker hand{} was played",
        planets_used = "different {C:planet}Planet{} card used this run", hands_run = "hand played this run", discards_unused = "{C:red}discard{} left unused this run",
        below_deck = "card below your starting deck size"},
      one = {any = "card", enhanced = "{C:attention}enhanced{} card", face = "{C:attention}face{} card", number = "{C:attention}number{} card", even = "{C:attention}even{} card", odd = "{C:attention}odd{} card", red = "{C:red}red{} card", black = "{C:spades}black{} card"},
      one_rank = "{C:attention}%s{}", one_suit = "{C:%s}%s{} card", one_enh = "{C:attention}%s{}",
    },
    fr = {
      chips_per = "{C:chips}+%s{} jetons par %s", mult_per = "{C:mult}+%s{} Multi par %s", xmult_per = "{X:mult,C:white} X%s {} Multi par %s",
      money_per = "gagnez {C:money}%s ${} par %s", gain_mult_per = "ce joker gagne {C:mult}+%s{} Multi par %s", gain_xmult_per = "ce joker gagne {X:mult,C:white} X%s {} Multi par %s",
      strip_enh = "les cartes qui marquent perdent leur {C:attention}amélioration{}",
      counts = {jokers = "{C:attention}Joker{} possédé", empty_slots = "emplacement de {C:attention}Joker{} vide", consumables = "{C:attention}consommable{} possédé", deck_left = "carte restante dans votre {C:attention}jeu{}",
        deck_match = "%s de votre {C:attention}jeu complet{}", held_match = "%s en main", scoring_match = "%s qui marque", destroyed_match = "%s détruite",
        discards_left = "{C:red}défausse{} restante", hands_left = "{C:blue}main{} restante", money = "{C:money}1 ${} possédé", money_5 = "tranche de {C:money}5 ${} possédée",
        sell_others = "{C:money}1 ${} de valeur de vente de vos autres {C:attention}Jokers{}", times_played = "fois où cette {C:attention}main de poker{} a été jouée",
        planets_used = "carte {C:planet}Planète{} différente utilisée dans la partie", hands_run = "main jouée dans la partie", discards_unused = "{C:red}défausse{} non utilisée dans la partie",
        below_deck = "carte en dessous de la taille de départ du jeu"},
      one = {any = "carte", enhanced = "carte {C:attention}améliorée{}", face = "{C:attention}figure{}", number = "carte {C:attention}numérotée{}", even = "carte {C:attention}paire{}", odd = "carte {C:attention}impaire{}", red = "carte {C:red}rouge{}", black = "carte {C:spades}noire{}"},
      one_rank = "carte de valeur {C:attention}%s{}", one_suit = "carte de {C:%s}%s{}", one_enh = "{C:attention}%s{}",
    },
    es = {
      chips_per = "{C:chips}+%s{} fichas por cada %s", mult_per = "{C:mult}+%s{} multi por cada %s", xmult_per = "{X:mult,C:white} X%s {} multi por cada %s",
      money_per = "gana {C:money}$%s{} por cada %s", gain_mult_per = "este joker gana {C:mult}+%s{} multi por cada %s", gain_xmult_per = "este joker gana {X:mult,C:white} X%s {} multi por cada %s",
      strip_enh = "las cartas que anotan pierden su {C:attention}mejora{}",
      counts = {jokers = "{C:attention}joker{} que tienes", empty_slots = "espacio de {C:attention}joker{} vacío", consumables = "{C:attention}consumible{} que tienes", deck_left = "carta que queda en tu {C:attention}baraja{}",
        deck_match = "%s de tu {C:attention}baraja completa{}", held_match = "%s en la mano", scoring_match = "%s que anota", destroyed_match = "%s destruida",
        discards_left = "{C:red}descarte{} restante", hands_left = "{C:blue}mano{} restante", money = "{C:money}$1{} que tienes", money_5 = "{C:money}$5{} que tienes",
        sell_others = "{C:money}$1{} de valor de venta de tus otros {C:attention}jokers{}", times_played = "vez que se jugó esta {C:attention}mano de póker{}",
        planets_used = "carta de {C:planet}Planeta{} distinta usada en la partida", hands_run = "mano jugada en la partida", discards_unused = "{C:red}descarte{} sin usar en la partida",
        below_deck = "carta por debajo del tamaño inicial de la baraja"},
      one = {any = "carta", enhanced = "carta {C:attention}mejorada{}", face = "{C:attention}figura{}", number = "carta {C:attention}numérica{}", even = "carta {C:attention}par{}", odd = "carta {C:attention}impar{}", red = "carta {C:red}roja{}", black = "carta {C:spades}negra{}"},
      one_rank = "carta de valor {C:attention}%s{}", one_suit = "carta de {C:%s}%s{}", one_enh = "{C:attention}%s{}",
    },
  }
  R.PER_TEXT = P
  local function pt(lang) return P[lang] or P.en end

  function R.one_label(v, lang)
    local p = pt(lang)
    if p.one[v] then return p.one[v] end
    if tonumber(v) then return string.format(p.one_rank, T.rank_name(v, lang)) end
    if R.member(R.FOUR_SUITS, v) then return string.format(p.one_suit, SUIT_COL[v], T.suit_name(v)) end
    return string.format(p.one_enh, T.enh_name(v))
  end

  function R.count_label(g, lang)
    local p = pt(lang)
    local base = p.counts[g.per] or p.counts.jokers
    if R.COUNT_MATCH[g.per] then return string.format(base, R.one_label(g.m or "any", lang)) end
    return base
  end

  for id in pairs(R.PER_GIVE) do
    TG[id] = function(g, s, lang) return string.format(pt(lang)[id], T.fmt_n(g.n), R.count_label(g, lang)) end
  end
  TG.strip_enh = function(g, s, lang) return pt(lang).strip_enh end

  LG.chips_per, LG.mult_per, LG.xmult_per, LG.money_per = "+Chips for each", "+Mult for each", "XMult for each", "Money for each"
  LG.gain_mult_per, LG.gain_xmult_per, LG.strip_enh = "Gains Mult for each", "Gains XMult for each", "Remove enhancements"
  R.LABEL_COUNT = {jokers = "Joker you have", empty_slots = "Empty Joker slot", consumables = "Consumable you have", deck_left = "Card left in deck",
    deck_match = "Card in full deck", held_match = "Card held in hand", scoring_match = "Scoring card", destroyed_match = "Destroyed card",
    discards_left = "Discard left", hands_left = "Hand left", money = "$1 you have", money_5 = "$5 you have", sell_others = "$1 of other Jokers' sell value",
    times_played = "Time this hand was played", planets_used = "Planet used this run", hands_run = "Hand played this run", discards_unused = "Discard unused this run", below_deck = "Card below starting deck size"}
  R.SIMPLE_GIVE.mult_per = true
  R.SIMPLE_GIVE.chips_per = true

  if mod_loc_register then
    mod_loc_register{
      fr = {
        ["+Chips for each"] = "+Jetons par", ["+Mult for each"] = "+Multi par", ["XMult for each"] = "XMulti par", ["Money for each"] = "Argent par",
        ["Gains Mult for each"] = "Gagne du Multi par", ["Gains XMult for each"] = "Gagne du XMulti par", ["Remove enhancements"] = "Retire les améliorations", ["FOR EACH WHAT?"] = "PAR QUOI ?",
        ["Joker you have"] = "Joker possédé", ["Empty Joker slot"] = "Emplacement de Joker vide", ["Consumable you have"] = "Consommable possédé", ["Card left in deck"] = "Carte restante du jeu",
        ["Card in full deck"] = "Carte du jeu complet", ["Card held in hand"] = "Carte en main", ["Scoring card"] = "Carte qui marque", ["Destroyed card"] = "Carte détruite",
        ["Discard left"] = "Défausse restante", ["Hand left"] = "Main restante", ["$1 you have"] = "1 $ possédé", ["$5 you have"] = "5 $ possédés", ["$1 of other Jokers' sell value"] = "1 $ de vente des autres Jokers",
        ["Time this hand was played"] = "Fois où la main a été jouée", ["Planet used this run"] = "Planète utilisée dans la partie", ["Hand played this run"] = "Main jouée dans la partie", ["Discard unused this run"] = "Défausse non utilisée dans la partie", ["Card below starting deck size"] = "Carte sous la taille de départ",
      },
      es = {
        ["+Chips for each"] = "+Fichas por cada", ["+Mult for each"] = "+Multi por cada", ["XMult for each"] = "XMulti por cada", ["Money for each"] = "Dinero por cada",
        ["Gains Mult for each"] = "Gana multi por cada", ["Gains XMult for each"] = "Gana XMulti por cada", ["Remove enhancements"] = "Quita las mejoras", ["FOR EACH WHAT?"] = "¿POR CADA QUÉ?",
        ["Joker you have"] = "Joker que tienes", ["Empty Joker slot"] = "Espacio de joker vacío", ["Consumable you have"] = "Consumible que tienes", ["Card left in deck"] = "Carta que queda en la baraja",
        ["Card in full deck"] = "Carta de la baraja completa", ["Card held in hand"] = "Carta en la mano", ["Scoring card"] = "Carta que anota", ["Destroyed card"] = "Carta destruida",
        ["Discard left"] = "Descarte restante", ["Hand left"] = "Mano restante", ["$1 you have"] = "$1 que tienes", ["$5 you have"] = "$5 que tienes", ["$1 of other Jokers' sell value"] = "$1 de venta de otros jokers",
        ["Time this hand was played"] = "Vez que se jugó la mano", ["Planet used this run"] = "Planeta usado en la partida", ["Hand played this run"] = "Mano jugada en la partida", ["Discard unused this run"] = "Descarte sin usar en la partida", ["Card below starting deck size"] = "Carta bajo el tamaño inicial",
      },
    }
  end
  local RANK_KEY = {[14] = "Ace", [13] = "King", [12] = "Queen", [11] = "Jack"}

  function R.round_target()
    local g = G and G.GAME
    if not g then return {suit = "Spades", rank = 14, hand = "High Card", card = {suit = "Spades", rank = 14}} end
    local cur = g.forge_target
    local round = tonumber(g.round) or 0
    if type(cur) == "table" and cur.round == round then return cur end
    local prev = type(cur) == "table" and cur or {}
    local seed = "forge_target" .. round
    local suits = {}
    for _, s in ipairs(R.FOUR_SUITS) do if s ~= prev.suit then suits[#suits + 1] = s end end
    local cards = {}
    for _, c in ipairs(G.playing_cards or {}) do
      if c.base and c.base.id and not (c.ability and c.ability.effect == "Stone Card") then cards[#cards + 1] = c end
    end
    local hands = {}
    for _, h in ipairs(R.HANDS) do
      local info = g.hands and g.hands[h]
      if info and info.visible and h ~= prev.hand then hands[#hands + 1] = h end
    end
    local fallback = false
    local pick = function(list, s)
      if #list == 0 then return nil end
      local ok, v = pcall(function() return pseudorandom_element(list, pseudoseed(s)) end)
      if not ok then fallback = true return nil end
      return v
    end
    local a, b = pick(cards, seed .. "r"), pick(cards, seed .. "c")
    local out = {round = round}
    out.suit = pick(suits, seed .. "s") or "Spades"
    out.rank = a and a.base.id or 14
    out.hand = pick(hands, seed .. "h") or "High Card"
    out.card = b and {suit = b.base.suit, rank = b.base.id} or {suit = "Spades", rank = 14}
    if fallback or not G.STAGE or not G.STAGES or G.STAGE ~= G.STAGES.RUN then return out end
    g.forge_target = out
    return out
  end

  local OF = {en = "%s of %s", fr = "%s de %s", es = "%s de %s"}
  local function cur_lang()
    local l = G and G.SETTINGS and G.SETTINGS.language or "en"
    if l:sub(1, 2) == "fr" then return "fr" end
    if l:sub(1, 2) == "es" then return "es" end
    return "en"
  end
  local function rank_text(n)
    local key = RANK_KEY[n] or tostring(n)
    local ok, r = pcall(localize, key, "ranks")
    if ok and type(r) == "string" and r ~= "" and r ~= "ERROR" then return r end
    return T.rank_name(n, cur_lang())
  end

  function R.target_vars()
    local t = R.round_target()
    local lang = cur_lang()
    return {T.suit_name(t.suit, true), rank_text(t.rank), T.hand_name(t.hand), string.format(OF[lang], rank_text(t.card.rank), T.suit_name(t.card.suit, true))}
  end

  add_ids(R.ONLY, {"round_suit", "round_rank", "round_card", "round_hand", "round_hand_suit"})
  R.CARD_ONLY.round_suit = true
  R.CARD_ONLY.round_rank = true
  R.CARD_ONLY.round_card = true
  R.ONLY_WHEN.round_hand = HAND
  R.ONLY_WHEN.round_hand_suit = HAND
  for _, id in ipairs({"round_suit", "round_rank", "round_card", "round_hand", "round_hand_suit"}) do
    R.CLEAN_ONLY[id] = function(c) c.v, c.op, c.n, c.mode = nil, nil, nil, nil end
  end
  C.round_suit = function(o, context, card, other) return other ~= nil and other:is_suit(R.round_target().suit) end
  C.round_rank = function(o, context, card, other) return other ~= nil and other:get_id() == R.round_target().rank end
  C.round_card = function(o, context, card, other)
    local t = R.round_target().card
    return other ~= nil and other:get_id() == t.rank and other:is_suit(t.suit)
  end
  C.round_hand = function(o, context) return context.scoring_name ~= nil and context.scoring_name == R.round_target().hand end
  C.round_hand_suit = function(o, context)
    local suit = R.round_target().suit
    for _, c in ipairs(scoring(context)) do if c:is_suit(suit) then return true end end
    return false
  end

  local RT = {
    en = {round_suit = "it is of {C:attention}this round's suit{} ({C:attention}#9#{})", round_rank = "its rank is {C:attention}this round's rank{} ({C:attention}#10#{})",
      round_card = "it is {C:attention}this round's card{} ({C:attention}#12#{})", round_hand = "the hand is {C:attention}this round's poker hand{} ({C:attention}#11#{})",
      round_hand_suit = "the hand has a scoring card of {C:attention}this round's suit{} ({C:attention}#9#{})",
      changes = "{C:inactive}(Changes every round){}"},
    fr = {round_suit = "elle est de {C:attention}la couleur de la manche{} ({C:attention}#9#{})", round_rank = "sa valeur est {C:attention}la valeur de la manche{} ({C:attention}#10#{})",
      round_card = "c'est {C:attention}la carte de la manche{} ({C:attention}#12#{})", round_hand = "la main est {C:attention}la main de poker de la manche{} ({C:attention}#11#{})",
      round_hand_suit = "la main contient une carte qui marque de {C:attention}la couleur de la manche{} ({C:attention}#9#{})",
      changes = "{C:inactive}(Change à chaque manche){}"},
    es = {round_suit = "es del {C:attention}palo de la ronda{} ({C:attention}#9#{})", round_rank = "su valor es {C:attention}el valor de la ronda{} ({C:attention}#10#{})",
      round_card = "es {C:attention}la carta de la ronda{} ({C:attention}#12#{})", round_hand = "la mano es {C:attention}la mano de póker de la ronda{} ({C:attention}#11#{})",
      round_hand_suit = "la mano tiene una carta que anota del {C:attention}palo de la ronda{} ({C:attention}#9#{})",
      changes = "{C:inactive}(Cambia cada ronda){}"},
  }
  R.TARGET_TEXT = RT
  for _, id in ipairs({"round_suit", "round_rank", "round_card", "round_hand", "round_hand_suit"}) do
    TO[id] = function(o, s, lang) return (RT[lang] or RT.en)[id] end
  end
  LO.round_suit, LO.round_rank, LO.round_card, LO.round_hand = "This round's suit", "This round's rank", "This round's card", "This round's poker hand"
  LO.round_hand_suit = "Hand has this round's suit"

  if mod_loc_register then
    mod_loc_register{
      fr = {["This round's suit"] = "Couleur de la manche", ["This round's rank"] = "Valeur de la manche", ["This round's card"] = "Carte de la manche", ["This round's poker hand"] = "Main de poker de la manche", ["Hand has this round's suit"] = "La main a la couleur de la manche"},
      es = {["This round's suit"] = "Palo de la ronda", ["This round's rank"] = "Valor de la ronda", ["This round's card"] = "Carta de la ronda", ["This round's poker hand"] = "Mano de póker de la ronda", ["Hand has this round's suit"] = "La mano tiene el palo de la ronda"},
    }
  end
  add_ids(R.ONLY, {"lucky_hit", "boss_triggered"})
  R.CARD_ONLY.lucky_hit = true
  R.ONLY_WHEN.lucky_hit = {card_scored = true}
  R.ONLY_WHEN.boss_triggered = HAND
  for _, id in ipairs({"lucky_hit", "boss_triggered"}) do
    R.CLEAN_ONLY[id] = function(c) c.v, c.op, c.n, c.mode = nil, nil, nil, nil end
  end
  C.lucky_hit = function(o, context, card, other) return other ~= nil and other.lucky_trigger and true or false end
  C.boss_triggered = function()
    local b = G.GAME and G.GAME.blind
    return b ~= nil and b.boss and b.triggered and true or false
  end
  local LT = {
    en = {lucky_hit = "its {C:attention}Lucky{} effect triggered", boss_triggered = "the {C:attention}Boss Blind{} ability was triggered"},
    fr = {lucky_hit = "son effet {C:attention}Chance{} s'est déclenché", boss_triggered = "l'effet de la {C:attention}Blinde de boss{} s'est déclenché"},
    es = {lucky_hit = "su efecto de {C:attention}Suerte{} se activó", boss_triggered = "la habilidad de la {C:attention}ciega jefe{} se activó"},
  }
  for _, id in ipairs({"lucky_hit", "boss_triggered"}) do
    TO[id] = function(o, s, lang) return (LT[lang] or LT.en)[id] end
  end
  LO.lucky_hit, LO.boss_triggered = "Lucky effect triggered", "Boss ability triggered"
  if mod_loc_register then
    mod_loc_register{
      fr = {["Lucky effect triggered"] = "Effet Chance déclenché", ["Boss ability triggered"] = "Effet du boss déclenché"},
      es = {["Lucky effect triggered"] = "Efecto de Suerte activado", ["Boss ability triggered"] = "Habilidad del jefe activada"},
    }
  end
end
end
