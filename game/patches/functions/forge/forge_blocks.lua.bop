  R.HOST_GIVE = R.HOST_GIVE or {}

  function R.matches()
    local out = {}
    for _, v in ipairs(R.MATCH_BASE) do out[#out + 1] = v end
    for _, v in ipairs(R.enhancements()) do out[#out + 1] = v end
    return out
  end

  local function is_wild(c) return c and c.ability and (c.ability.name == "Wild Card" or (c.config and c.config.center and c.config.center.forge_wild)) and true or false end

  local function enhanced(c)
    local center = c and c.config and c.config.center
    return center ~= nil and G.P_CENTERS and center ~= G.P_CENTERS.c_base and center.key ~= "c_base"
  end

  function R.card_match(c, v)
    if v == "any" or v == nil then return true end
    if v == "enhanced" then return enhanced(c) end
    if type(v) == "number" or v == "face" or v == "number" or v == "even" or v == "odd" then return R.rank_ok(c, v) end
    if v == "red" or v == "black" or R.member(R.FOUR_SUITS, v) then return R.suit_ok(c, v) end
    return c.config and c.config.center and c.config.center.key == v or false
  end

  local function match_ok(v)
    return R.member(R.MATCH_BASE, v) or R.member(R.ENHANCEMENTS, v) or R.own_id("enhancement", v) ~= nil or (R.ed_ok ~= nil and R.ed_ok(v))
  end

  local function scoring(context)
    return type(context.scoring_hand) == "table" and context.scoring_hand or type(context.full_hand) == "table" and context.full_hand or {}
  end

  function R.discard_hand(context)
    if type(context.full_hand) ~= "table" or #context.full_hand == 0 then return nil end
    if not context.forge_hand and G.FUNCS and G.FUNCS.get_poker_hand_info then
      local ok, text, _, ph = pcall(G.FUNCS.get_poker_hand_info, context.full_hand)
      context.forge_hand = ok and {name = text, hands = ph} or {}
    end
    local name = context.forge_hand and context.forge_hand.name
    if name and G.GAME and G.GAME.hands and G.GAME.hands[name] then return name end
    return nil
  end

  local function card_conds(rule, skip)
    local out = {}
    for _, o in ipairs(rule and rule.only or {}) do
      if o ~= skip and o.id ~= "chance" and R.CARD_ONLY[o.id] and o.id ~= "lowest_held" then out[#out + 1] = o end
    end
    return out
  end

  local function card_ok(list, context, card, c, seed)
    for _, o in ipairs(list) do
      local ok = R.check(o, context, card, c, seed)
      if o.neg then ok = not ok end
      if not ok then return false end
    end
    return true
  end

  local NUM = {
