        for _, s in ipairs(order) do
          if not got[s] and c:is_suit(s) then got[s] = true break end
        end
      end
    end
    if not got[o.v] then return false end
    for _, s in ipairs(R.FOUR_SUITS) do if s ~= o.v and got[s] then return true end end
    return false
  end
  C.held_all = function(o, context)
    local suits = o.v == "black" and {"Spades", "Clubs"} or o.v == "red" and {"Hearts", "Diamonds"} or {o.v}
