  C.first_discard = function() return (tonumber(R.round_info().discards_used) or 0) <= 0 end
  C.once_per_discard = function(o, context, card, other)
    local fh = context.full_hand
    return other ~= nil and type(fh) == "table" and fh[#fh] == other
  end
  C.discarded = function(o, context)
    local n = 0
    for _, c in ipairs(type(context.full_hand) == "table" and context.full_hand or {}) do
      if R.card_match(c, o.v) then n = n + 1 end
    end
    return R.compare(o.op, n, o.n)
  end
  C.deck_count = function(o)
    local n = 0
    for _, c in ipairs(G.playing_cards or {}) do
      if R.card_match(c, o.v) then n = n + 1 end
    end
    return R.compare(o.op, n, o.n)
  end
  C.used_kind = function(o, context)
    local c = context.consumeable
    return c ~= nil and c.ability ~= nil and c.ability.set == o.v
  end
  C.no_discard = function() return (tonumber(R.round_info().discards_used) or 0) <= 0 end

  R.SCORE_GIVE.var_xmult = "xmult"
