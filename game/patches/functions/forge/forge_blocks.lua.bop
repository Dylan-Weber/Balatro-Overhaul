  local C = R.CHECKS
  C.enhanced = function(o, context, card, other) return other ~= nil and enhanced(other) end
  C.first_scored = function(o, context, card, other, seed, rule)
    local hand = context.scoring_hand
    if not other or type(hand) ~= "table" then return false end
    local conds = card_conds(rule, o)
    for _, c in ipairs(hand) do
      if c == other then return true end
      if card_ok(conds, context, card, c, seed) then return false end
    end
    return false
  end
  C.lowest_held = function(o, context, card, other)
    if not other or not G.hand or not G.hand.cards then return false end
    local low, id = nil, 15
    for _, c in ipairs(G.hand.cards) do
      if id >= c.base.id and not (c.ability and c.ability.effect == "Stone Card") then id = c.base.id; low = c end
    end
    return low == other
  end
  C.played_rank = function(o, context)
    for _, c in ipairs(scoring(context)) do if R.rank_ok(c, o.v) then return true end end
    return false
  end
  C.played_suit = function(o, context)
    for _, c in ipairs(scoring(context)) do if R.suit_ok(c, o.v) then return true end end
    return false
  end
  C.all_suits = function(o, context)
    local got = {}
    local hand = scoring(context)
    for _, c in ipairs(hand) do
      if not is_wild(c) then
        for _, s in ipairs(R.FOUR_SUITS) do
          if not got[s] and c:is_suit(s, true) then got[s] = true break end
        end
      end
    end
    for _, c in ipairs(hand) do
      if is_wild(c) then
        for _, s in ipairs(R.FOUR_SUITS) do
          if not got[s] and c:is_suit(s) then got[s] = true break end
        end
      end
    end
    return got.Hearts and got.Diamonds and got.Spades and got.Clubs or false
  end
  C.suit_and_other = function(o, context)
    local got = {}
    local hand = scoring(context)
    for _, c in ipairs(hand) do
      if not is_wild(c) then
        for _, s in ipairs(R.FOUR_SUITS) do if c:is_suit(s) then got[s] = true end end
      end
    end
    local order = {o.v}
    for _, s in ipairs({"Diamonds", "Spades", "Hearts", "Clubs"}) do if s ~= o.v then order[#order + 1] = s end end
    for _, c in ipairs(hand) do
