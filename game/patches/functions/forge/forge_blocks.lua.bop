return function(R)
  local T = require("functions/forge/forge_text")

  local function set(list)
    local out = {}
    for _, v in ipairs(list) do out[v] = true end
    return out
  end

  local function add_ids(list, ids)
    for _, id in ipairs(ids) do
      if not R.member(list, id) then list[#list + 1] = id end
      R.V8_IDS[id] = true
    end
  end

  local HAND = set({"card_scored", "card_held", "hand_played", "before", "after"})
  local SCORE = set({"card_scored", "card_held", "hand_played"})
  local ONE_CARD = set({"card_scored", "card_held"})

  R.FOUR_SUITS = {"Hearts", "Diamonds", "Spades", "Clubs"}
  R.USE_KINDS = {"Tarot", "Planet", "Spectral"}
  R.RARITIES = {"Common", "Uncommon", "Rare", "Legendary"}
  R.MATCH_BASE = {"any", "enhanced", "face", "number", "even", "odd", 14, 13, 12, 11, 10, 9, 8, 7, 6, 5, 4, 3, 2, "Hearts", "Diamonds", "Spades", "Clubs", "red", "black"}
  R.SIMPLE_ONLY = R.SIMPLE_ONLY or {}
