  local function fix(list, def) return function(c) if not R.member(list, c.v) then c.v = def end end end
  R.CLEAN_ONLY.played_rank = fix(R.RANKS, 14)
  R.CLEAN_ONLY.played_suit = fix(R.SUITS, "Hearts")
