  end,
}

local function page_build(key)
  return function()
    local b = Guide.BUILD[key]
    if b then return b() end
    return page(Guide.PAGES[Guide.index(key)].label)
  end
end

function Guide.tabs()
  local out = {}
  for _, p in ipairs(Guide.PAGES) do
    out[#out + 1] = {key = p.key, label = mod_loc(p.label), build = page_build(p.key)}
  end
  return out
end

function Guide.footer_def(key)
  local last = Guide.next_key(key) == nil
  local label = mod_loc(last and "DONE" or "NEXT")
  return {n = G.UIT.ROOT, config = {align = "cm", colour = G.C.CLEAR, padding = 0}, nodes = {
    UIK.button{label = label, button = "forge_guide_next", colour = last and UIK.C.ok or UIK.C.accent, id = "forge_guide_next"},
  }}
end

function Guide.refresh_footer()
  local win = UIK._win
  if not (win and win.id == "forge_guide") then return end
  Guide.state.cur = win._cur
