      {chip = mod_loc("Publish"), colour = UIK.C.ok, text = "In Mods > Forged, on your own mod: puts it online. BROWSE ONLINE gets the mods other players made."},
      {chip = mod_loc("Forge creations"), colour = UIK.C.accent, text = "In a multiplayer lobby the host turns it on: everyone plays with the host's creations. Off in Ranked."},
