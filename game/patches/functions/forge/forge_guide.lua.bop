local Store = require("functions/forge/forge_store")
local UIK = rawget(_G, "UIK")
local function mod_loc(str) local f = rawget(_G, "mod_loc") return f and f(str) or str end
local function forge_ui() return require("functions/forge/forge_ui") end

local Guide = {}

Guide.SEEN_KEY = "guide_seen"
Guide.PAGES = {
  {key = "start", label = "First steps"},
  {key = "rules", label = "Rules"},
  {key = "vars", label = "Variables"},
  {key = "try", label = "Try it"},
  {key = "share", label = "Sharing"},
}
Guide.state = Guide.state or {back_tab = nil, cur = nil}

function Guide.index(key)
  for i, p in ipairs(Guide.PAGES) do if p.key == key then return i end end
  return nil
end

function Guide.next_key(key)
  local i = Guide.index(key) or 0
  local p = Guide.PAGES[i + 1]
  return p and p.key or nil
end

function Guide.seen()
  return Store.get_setting(Guide.SEEN_KEY, false) == true
end

function Guide.mark_seen()
  Store.set_setting(Guide.SEEN_KEY, true)
end

local function thumb() return UIK.thumb() end
local function port() return UIK.portrait() end
local K = 1
local function text_scale() return K * (port() and 0.48 or thumb() and 0.46 or 0.42) end
local function head_scale() return K * (port() and 0.66 or thumb() and 0.62 or 0.56) end
local function chip_scale() return K * (port() and 0.5 or thumb() and 0.46 or 0.42) end
local function chip_h() return K * (port() and 0.8 or thumb() and 0.74 or 0.7) end
local function gap_h() return K * (port() and 0.3 or 0.2) end
local function line_h(s) return s * 1.05 + 0.04 end

local function fit(label, w, scale)
  local lw = UIK.text_w(label, scale)
  if lw > w - 0.3 then return scale * (w - 0.3) / lw end
  return scale
end

local function greedy(words, scale, limit)
  local out, cur = {}, ""
  for _, wd in ipairs(words) do
    local try = cur == "" and wd or (cur .. " " .. wd)
    if cur ~= "" and UIK.text_w(try, scale) > limit then
      out[#out + 1] = cur
      cur = wd
    else
      cur = try
    end
  end
  if cur ~= "" then out[#out + 1] = cur end
  return out
end

local function caps(wd)
  return wd:find("%u") ~= nil and wd:find("%l") == nil
end

function Guide.words(str, plain)
  local words = {}
  for wd in tostring(str):gmatch("%S+") do
    local last = words[#words]
    if last and wd:match("^[:;!?]+$") then
      words[#words] = last .. " " .. wd
    elseif not plain and last and caps(last) and caps(wd) and #last:gsub("%A", "") + #wd:gsub("%A", "") > 2 then
      words[#words] = last .. " " .. wd
    else
      words[#words + 1] = wd
    end
  end
  return words
end

function Guide.balance(str, scale, w, plain)
  local words = Guide.words(str, plain)
  local need = #greedy(words, scale, w)
  if need <= 1 then return {str} end
  local lo, hi = UIK.text_w(str, scale) / need, w
  for _ = 1, 14 do
    local mid = (lo + hi) / 2
    if #greedy(words, scale, mid) <= need then hi = mid else lo = mid end
  end
  return greedy(words, scale, hi)
end

local function say(str)
  if type(str) == "table" then return string.format(mod_loc(str[1]), unpack(str, 2)) end
  return mod_loc(str)
end

local function lines(str, w)
  local s = text_scale()
  return UIK.note(Guide.balance(say(str), s, w - 0.2), {w = w, scale = s, colour = UIK.C.text, nowrap = true})
end

local function chip(label, colour, w, cs)
  local s = cs or fit(label, w, chip_scale())
  return {n = G.UIT.R, config = {align = "cm", padding = 0.04}, nodes = {
    {n = G.UIT.C, config = {align = "cm", minw = w, minh = chip_h(), r = 0.1, colour = colour, shadow = true, padding = 0.06}, nodes = {
      UIK.text(label, {scale = s, shadow = true}),
    }},
  }}
end

local function word(str)
  return {n = G.UIT.R, config = {align = "cm", padding = 0.02}, nodes = {UIK.text(mod_loc(str), {scale = chip_scale(), colour = UIK.C.title, shadow = true})}}
end

local function layout()
  local W = UIK.W
  if port() then
    local cw = W - 0.8
    return {w = cw, chip = math.min(cw - 1.2, 5.6), stack = true}
  end
  local gap = 0.35
  local cw = (W - 1.0 - 2 * gap) / 3
  return {w = cw, chip = cw - 0.15, gap = gap}
end

function Guide.chip_text_scale(list, w, base)
  local s = base
  for _, b in ipairs(list) do
    local lw = UIK.text_w(b.chip, base)
    if lw > w - 0.6 then s = math.min(s, base * (w - 0.6) / lw) end
  end
  return s
end

local function blocks(list, L)
  local cols = {}
  local cs = Guide.chip_text_scale(list, L.chip, chip_scale())
  for _, b in ipairs(list) do
    local nodes = {}
    if b.word then nodes[#nodes + 1] = word(b.word) end
    nodes[#nodes + 1] = chip(b.chip, b.colour, L.chip, cs)
    nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = 0.06}, nodes = {}}
    nodes[#nodes + 1] = lines(b.text, L.w)
    cols[#cols + 1] = {n = L.stack and G.UIT.R or G.UIT.C, config = {align = "tm", minw = L.w, padding = 0}, nodes = nodes}
  end
  if L.stack then
    local rows = {}
    for i, c in ipairs(cols) do
      if i > 1 then rows[#rows + 1] = {n = G.UIT.R, config = {minh = gap_h()}, nodes = {}} end
      rows[#rows + 1] = c
    end
    return {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {{n = G.UIT.C, config = {align = "tm", padding = 0}, nodes = rows}}}
  end
  local row = {}
  for i, c in ipairs(cols) do
    if i > 1 then row[#row + 1] = {n = G.UIT.C, config = {minw = L.gap}, nodes = {}} end
    row[#row + 1] = c
  end
  return {n = G.UIT.R, config = {align = "tm", padding = 0}, nodes = row}
end

local function text_w() return port() and UIK.W - 0.8 or thumb() and UIK.W - 1.5 or math.min(UIK.W - 1.0, 12) end

local function note_h(str, w)
  local s = text_scale()
  return #Guide.balance(say(str), s, w - 0.2) * line_h(s) + 0.08
end

function Guide.height(head, sub, list, foot)
  local L = layout()
  local tw = text_w()
  local h = #Guide.balance(mod_loc(head), head_scale(), tw, true) * line_h(head_scale()) + 0.12
  if sub then h = h + note_h(sub, tw) end
  h = h + gap_h()
  if list then
    local most, sum = 0, 0
    for _, b in ipairs(list) do
      local bh = chip_h() + 0.08 + 0.06 + note_h(b.text, L.w)
      if b.word then bh = bh + line_h(chip_scale()) end
      most = math.max(most, bh)
      sum = sum + bh
    end
    h = h + (L.stack and (sum + gap_h() * (#list - 1)) or most)
  end
  if foot then h = h + gap_h() + note_h(foot, tw) end
  return h
end

function Guide.fit(head, sub, list, foot)
  K = 1
  local room = UIK.H - UIK.TOP - 0.3
  while K > 0.78 and Guide.height(head, sub, list, foot) > room do K = K - 0.03 end
  return K
end

local function page(head, sub, list, foot)
  Guide.fit(head, sub, list, foot)
  local L = layout()
  local W = UIK.W
  local tw = text_w()
  local hl = {}
  for _, l in ipairs(Guide.balance(mod_loc(head), head_scale(), tw, true)) do
    hl[#hl + 1] = {n = G.UIT.R, config = {align = "cm", padding = 0}, nodes = {UIK.text(l, {scale = head_scale(), colour = UIK.C.title, shadow = true})}}
  end
  local nodes = {
    {n = G.UIT.R, config = {align = "cm", padding = 0.06}, nodes = {{n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = hl}}},
  }
  if sub then nodes[#nodes + 1] = lines(sub, tw) end
  nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = gap_h()}, nodes = {}}
  if list then nodes[#nodes + 1] = blocks(list, L) end
  if foot then
    nodes[#nodes + 1] = {n = G.UIT.R, config = {minh = gap_h()}, nodes = {}}
    nodes[#nodes + 1] = lines(foot, tw)
  end
  K = 1
  return {n = G.UIT.R, config = {align = "cm", minw = W, minh = UIK.H - UIK.TOP - 0.05, padding = 0}, nodes = {
    {n = G.UIT.C, config = {align = "cm", padding = 0}, nodes = nodes},
  }}
end

