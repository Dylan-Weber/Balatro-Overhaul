function Guide.definition(key)
  local cur = Guide.index(key) and key or Guide.PAGES[1].key
  Guide.state.cur = cur
  return UIK.window{
    id = "forge_guide",
    title = mod_loc("FORGE GUIDE"),
    tabs = Guide.tabs(),
    tab = cur,
    back_func = "forge_guide_back",
    back_inline = "land",
    footer = function() return {{n = G.UIT.O, config = {id = "forge_guide_footer", object = UIBox{definition = Guide.footer_def(cur), config = {offset = {x = 0, y = 0}}}}}} end,
  }
end

function Guide.open(key, back_tab, back_to)
  Guide.state.back_tab = back_tab
  Guide.state.back_to = back_to or "forge"
  if not Guide.seen() then Guide.mark_seen() end
r 32 1381 %20%20 -
l 150
  local ok, err = pcall(function()
    G.FUNCS.overlay_menu{definition = Guide.definition(key)}
  end)
  if not ok then print("[FORGE] guide could not open: " .. tostring(err)) end
end

function Guide.first_open(tab, from)
  if Guide.seen() then return false end
  local UI = forge_ui()
  if from then UI.state.from = from end
  Guide.open(nil, tab or "my")
  return true
end

function Guide.leave()
  local tab = Guide.state.back_tab or "my"
  local to = Guide.state.back_to
  Guide.state.back_tab, Guide.state.back_to = nil, nil
  if to == "guide" and G.FUNCS.guide_back_to_guide_tab then return G.FUNCS.guide_back_to_guide_tab() end
  forge_ui().open(tab)
end

G.FUNCS.forge_guide_back = function(e)
  Guide.leave()
end

G.FUNCS.forge_guide_next = function(e)
  local nk = Guide.next_key(Guide.state.cur)
  if not nk then return Guide.leave() end
  UIK.open_tab(nk)
  Guide.refresh_footer()
end

function Guide.entry_button()
  return UIK.button{label = mod_loc("GUIDE"), button = "forge_guide_open", colour = UIK.C.accent, id = "forge_guide_open"}
end

G.FUNCS.forge_guide_open = function(e)
  local win = UIK._win
  local tab = win and win.id == "forge" and win._cur or "my"
  Guide.open(nil, tab)
end

if not Guide.hooked and G.FUNCS.uik_tab then
  Guide.hooked = true
  local orig_tab = G.FUNCS.uik_tab
  G.FUNCS.uik_tab = function(e)
    orig_tab(e)
    if UIK._win and UIK._win.id == "forge_guide" then Guide.refresh_footer() end
  end
  local orig_forge = G.FUNCS.open_joker_forge
  G.FUNCS.open_joker_forge = function(e)
    if Guide.first_open("my", "tavern") then
      forge_ui().state.page = 1
      return
    end
    return orig_forge(e)
  end
  local orig_mods = G.FUNCS.forge_from_mods
  G.FUNCS.forge_from_mods = function(e)
    local tab = e and e.config and e.config.ref_table and e.config.ref_table.tab or "my"
    if Guide.first_open(tab, "mods") then return end
    return orig_mods(e)
  end
end

G.FUNCS.open_guide_joker_forge = function(e)
  Guide.open(nil, nil, "guide")
end

G.ESC_BACK_FUNCS = G.ESC_BACK_FUNCS or {}
G.ESC_BACK_FUNCS.forge_guide_back = true

