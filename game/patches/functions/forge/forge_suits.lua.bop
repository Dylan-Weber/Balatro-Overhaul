      ["Teal"] = "Sarcelle", ["Pink"] = "Rose", ["Ink colour"] = "Teinte",
    },
    es = {
      ["Suit"] = "Palo", ["Suits"] = "Palos", ["Suit symbol"] = "Símbolo del palo", ["In the starting deck"] = "En la baraja inicial", ["Not in the starting deck"] = "No está en la baraja inicial",
      ["How often in packs"] = "Frecuencia en sobres", ["{C:attention}13{} cards, 2 to Ace"] = "{C:attention}13{} cartas, del 2 al As",
      ["Shows in packs {C:attention}%d%%{} as often as a usual suit"] = "Sale en sobres un {C:attention}%d%%{} de lo que sale un palo normal",
      ["Teal"] = "Turquesa", ["Pink"] = "Rosa", ["Ink colour"] = "Tinta",
    },
  }
end

register_strings()

