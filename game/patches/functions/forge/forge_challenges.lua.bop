function Ch.install_hooks()
  if Ch.hooked then return end
  Ch.hooked = true
  local Hooks = require("overhaul.hooks")
  Hooks.wrap("Game", "start_run", function(orig) return function(self, args, ...)
    pcall(Ch.pre_start, args)
    local r = orig(self, args, ...)
    local ok, err = pcall(Ch.on_start, args)
    if not ok then require("functions/forge/forge_joker").log_once("ch_start", "challenge start failed: " .. tostring(err)) end
    return r
  end end, {id = "forge_challenges.start_run"})
  if type(rawget(_G, "SMODS")) ~= "table" and G and G.UIDEF and G.UIDEF.challenge_list_page then
    G.UIDEF.challenge_list_page = Ch.list_page
  end
end

local function register_strings()
  if not mod_loc_register then return end
  mod_loc_register{
    fr = {
      ["Challenge"] = "Défi", ["Challenges"] = "Défis",
