function Ch.pre_start(args)
  local ch = type(args) == "table" and not args.savetext and args.challenge
  if not (type(ch) == "table" and ch.forge_ch and ch.deck and ch.deck.type) then return end
  local find = rawget(_G, "get_deck_from_name")
  if type(find) == "function" and not find(ch.deck.type) then ch.deck.type = "Challenge Deck" end
end

function Ch.unlocked(v, k)
  local p = G.PROFILES[G.SETTINGS.profile]
  if type(v) == "table" and v.forge_ch then return true end
  if p.all_unlocked then return true end
  return p.challenges_unlocked and p.challenges_unlocked >= k
end

