      pcall(P.boost, node, P.unit(), P.floor_px())
    end
    return raw_add(self, node, parent)
  end
end

if not P.hud_wrapped and create_UIBox_HUD_blind then
  P.hud_wrapped = true
  local raw_hud = create_UIBox_HUD_blind
  create_UIBox_HUD_blind = function(...)
    local def = raw_hud(...)
    if type(def) == 'table' and P.on() then
      local ok, hit = pcall(P.hud_blind_fit, def)
      local b = G.GAME and G.GAME.blind
      if ok and hit and b and b.T then b:change_dim(b.T.w * 0.8, b.T.h * 0.8) end
    end
    return def
  end
end

if not P.defs_wrapped then
  P.defs_wrapped = true
  P.wrap_def(_G, 'create_UIBox_game_over', P.OVERLAY_FLOOR)
  P.wrap_def(_G, 'create_UIBox_win', P.OVERLAY_FLOOR)
  P.wrap_def(G.UIDEF, 'speech_bubble', P.POPUP_FLOOR, P.POPUP_MAX_K)
end

P.BLIND_K = 1.08

function P.blind_k()
  if not P.on() then return 1 end
  local PT = rawget(_G, 'PORTRAIT')
  if PT and PT.on and PT.on() then return 1 end
  local w, h = love.graphics.getDimensions()
  local a = w / math.max(1, h)
  if a >= 2.1 then return P.BLIND_K end
  if a >= 1.9 then return 1.1 end
  return 1
end

local function widen(n, k, d)
  if type(n) ~= 'table' or d > 30 then return end
  local c = n.config
  if type(c) == 'table' then
    if type(c.minw) == 'number' and c.minw >= 1.8 then c.minw = c.minw * k end
    if type(c.maxw) == 'number' and c.maxw >= 1.8 then c.maxw = c.maxw * k end
  end
  for i = 1, table.maxn(n.nodes or {}) do widen(n.nodes[i], k, d + 1) end
end

function P.blind_lines()
  local PT = rawget(_G, 'PORTRAIT')
  if PT and PT.on and PT.on() then return 4 end
  return 3
end

local function var_text(v)
  if v == nil then return '0000' end
  local ok, r = pcall(format_ui_value, v)
  return ok and tostring(r) or tostring(v)
end

local function parsed_words(lines, vars)
  local words, cur = {}, nil
  local function flush()
    if cur then words[#words + 1] = cur end
    cur = nil
  end
  local function add(control, item, txt)
    cur = cur or {segs = {}, text = ''}
    local last = cur.segs[#cur.segs]
    if not (last and last.control == control) then
      last = {control = control, strings = {}}
      cur.segs[#cur.segs + 1] = last
    end
    last.strings[#last.strings + 1] = item
    cur.text = cur.text .. txt
  end
  for _, line in ipairs(lines) do
    if type(line) ~= 'table' then return nil end
    flush()
    for _, part in ipairs(line) do
      if type(part) ~= 'table' or type(part.strings) ~= 'table' or type(part.control) ~= 'table' or part.control.element then return nil end
      for _, sub in ipairs(part.strings) do
        if type(sub) == 'table' then
          add(part.control, sub, var_text(vars and vars[tonumber(sub[1])]))
        elseif type(sub) == 'string' then
          for piece, gap in sub:gmatch('([^%s]*)(%s*)') do
            if piece ~= '' then add(part.control, piece, piece) end
            if gap ~= '' then flush() end
          end
        else
          return nil
        end
      end
    end
  end
  flush()
  return words
end

local function parsed_wrap(words, scale, w, max)
  local space = width(' ', scale)
  local out, line, lw = {}, nil, 0
  local function close()
    if line then out[#out + 1] = line end
    line, lw = nil, 0
  end
  for _, wd in ipairs(words) do
    local ww = width(wd.text, scale)
    if line and lw + space + ww > w then close() end
    if line then
      local lp = line[#line]
      lp.strings[#lp.strings + 1] = ' '
      lw = lw + space
    end
    line = line or {}
    for _, seg in ipairs(wd.segs) do
      local lp = line[#line]
      if not (lp and lp.control == seg.control) then
        lp = {control = seg.control, strings = {}}
        line[#line + 1] = lp
      end
      for _, it in ipairs(seg.strings) do lp.strings[#lp.strings + 1] = it end
    end
    lw = lw + ww
  end
  close()
  if max and #out > max then return nil end
  return out
end

function P.rewrap_parsed(lines, scale, w, max, vars)
  if type(lines) ~= 'table' or #lines == 0 then return lines end
  local k = P.k(scale)
  if k <= 1.001 then return lines end
  local words = parsed_words(lines, vars)
  if not words or #words == 0 then return lines end
  max = math.max(#lines, max or #lines)
  while k > 1.001 do
    local out = parsed_wrap(words, scale * k, w, max)
    if out and #out > 0 then return out end
    k = k - 0.05
  end
  return lines
end

local function blind_vars(blind)
  local c = blind and blind.config
  if type(c) ~= 'table' then return nil end
  if c.name == 'The Ox' and G.GAME and G.GAME.current_round then
    return {localize(G.GAME.current_round.most_played_poker_hand, 'poker_hands')}
  end
  if type(c.loc_vars) == 'function' then
    local ok, res = pcall(c.loc_vars, c)
    if ok and type(res) == 'table' then return res.vars end
  end
  return c.vars
end

function P.blind_text(lines, run_info, blind)
  local max = not run_info and P.blind_lines() or nil
  local w = 2.8 * P.blind_k()
  if type(lines) == 'table' and type(lines[1]) == 'table' then
    return P.rewrap_parsed(lines, 0.32, w, max, blind_vars(blind))
  end
  local out = P.rewrap(lines, 0.32, w, max)
  if type(out) ~= 'table' or #out <= 2 then return out end
  local tail = {}
  for i = 3, #out do tail[#tail + 1] = out[i] end
  P.blind_tail = {anchor = out[2], lines = tail}
  return {out[1], out[2]}
end

local function copy(t)
  local c = {}
  for k, v in pairs(t) do c[k] = v end
  return c
end

local function add_tail(n, tail, d)
  if type(n) ~= 'table' or type(n.nodes) ~= 'table' or d > 30 then return false end
  for i = 1, table.maxn(n.nodes) do
    local row = n.nodes[i]
    local tn = type(row) == 'table' and type(row.nodes) == 'table' and #row.nodes == 1 and row.nodes[1]
    if type(tn) == 'table' and tn.n == G.UIT.T and tn.config and tn.config.text == tail.anchor then
      for j = #tail.lines, 1, -1 do
        local tc = copy(tn.config)
        tc.text = tail.lines[j]
        table.insert(n.nodes, i + 1, {n = row.n, config = copy(row.config), nodes = {{n = G.UIT.T, config = tc}}})
      end
      return true
    end
    if add_tail(row, tail, d + 1) then return true end
  end
  return false
end

if not P.blind_wrapped and rawget(_G, 'create_UIBox_blind_choice') then
  P.blind_wrapped = true
  local raw_bc = create_UIBox_blind_choice
  function create_UIBox_blind_choice(kind, run_info, ...)
    P.blind_tail = nil
    local t = raw_bc(kind, run_info, ...)
    local tail = P.blind_tail
    P.blind_tail = nil
    if tail and type(t) == 'table' then pcall(add_tail, t, tail, 0) end
    local k = P.blind_k()
    if k > 1 and not run_info and type(t) == 'table' then pcall(widen, t, k, 0) end
    return t
  end
end
end
