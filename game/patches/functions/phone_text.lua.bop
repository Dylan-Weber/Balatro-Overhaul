P.OVERLAY_FLOOR = 0.031

function P.wrap_def(tbl, key, floor, cap)
  local raw = tbl and tbl[key]
  if type(raw) ~= 'function' then return end
  tbl[key] = function(...)
    local def = raw(...)
    if type(def) == 'table' and P.on() then
      local ok, err = pcall(P.boost, def, P.unit(), P.floor_px(floor), cap)
      if not ok then print('[PHONE_TEXT] ' .. tostring(err)) end
    end
    return def
  end
end

P.HUD_EXTRA = 0.3

function P.hud_blind_fit(def)
  local label = localize('ph_blind_score_at_least')
  local extra = P.HUD_EXTRA * (def.config and tonumber(def.config.hud_scale) or 1)
  local hit
  local function walk(n, parent, gp, d)
    if type(n) ~= 'table' or d > 40 then return end
    local c = n.config
    if n.n == G.UIT.T and c and c.text == label and parent and gp then hit = {parent, gp} end
    if c and c.func == 'HUD_blind_reward' and c.maxw then c.maxw = c.maxw + extra end
    for i = 1, table.maxn(n.nodes or {}) do walk(n.nodes[i], n, parent, d + 1) end
  end
  walk(def, nil, nil, 0)
  if not hit then return false end
  if hit[1].config.maxw then hit[1].config.maxw = hit[1].config.maxw + extra end
  if hit[2].config.minw then hit[2].config.minw = hit[2].config.minw + extra end
  return true
end

if UIBox and not P.eval_hooked then
  P.eval_hooked = true
  local raw_add = UIBox.add_child
