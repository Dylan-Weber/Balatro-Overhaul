PHONE_TEXT = PHONE_TEXT or {}
local P = PHONE_TEXT

P.FLOOR = 0.028
P.POPUP_FLOOR = 0.034
P.MAX_K = 1.4
P.POPUP_MAX_K = 1.7

function P.on()
  return UIK and UIK.touch and UIK.touch() or false
end

function P.unit()
  local f = G.LANG and G.LANG.font
  if not (f and f.FONT and G.TILESCALE) then return nil end
  return f.FONT:getHeight() * f.FONTSCALE * (f.TEXT_HEIGHT_SCALE or 1) * G.TILESCALE / (G.MENU_ZOOM or 1)
end

function P.floor_px(f)
  local w, h = love.graphics.getDimensions()
  return math.min(w, h) * (f or P.FLOOR)
end

local function plain(str)
  return (tostring(str):gsub('{[^}]*}', ''))
end

local function width(str, scale)
  local f = G.LANG and G.LANG.font
  if not (f and f.FONT and G.TILESIZE) then return 0 end
  return f.FONT:getWidth(plain(str)) * (f.squish or 1) * scale * (f.FONTSCALE or 0.1) / G.TILESIZE
end

function P.wrap(str, scale, w, max)
  local lines, cur, open = {}, '', nil
  for word in tostring(str):gmatch('%S+') do
    local try = cur == '' and word or (cur .. ' ' .. word)
    if cur ~= '' and width(try, scale) > w then
      lines[#lines + 1] = open and (cur .. '{}') or cur
      cur = open and (open .. word) or word
    else
      cur = try
    end
    for tag in word:gmatch('{[^}]*}') do open = tag ~= '{}' and tag or nil end
  end
  if cur ~= '' then lines[#lines + 1] = cur end
  if max and #lines > max then return nil end
  return lines
end

function P.rewrap(lines, scale, w, max)
  if type(lines) ~= 'table' or #lines == 0 then return lines end
  local k = P.k(scale)
  if k <= 1.001 then return lines end
  local parts = {}
  for _, l in ipairs(lines) do parts[#parts + 1] = tostring(l) end
  max = math.max(#lines, max or #lines)
  local str = table.concat(parts, ' ')
  while k > 1.001 do
    local out = P.wrap(str, scale * k, w, max)
    if out and #out > 0 then return out end
    k = k - 0.05
  end
  return lines
end

function P.k(scale, unit, floor, cap)
  unit = unit or P.unit()
  if not (unit and type(scale) == 'number' and scale > 0) then return 1 end
  local px = scale * unit
  floor = floor or P.floor_px()
  if px >= floor then return 1 end
  return math.min(cap or P.MAX_K, floor / px)
end

function P.idle_zoom()
  if PORTRAIT and PORTRAIT.on() and PORTRAIT.idle_zoom and ui_size_fit then
    local w, h = love.graphics.getDimensions()
    return PORTRAIT.idle_zoom(w, h, ui_size_fit(w, h)) or 1
  end
  return 1
end

function P.menu_k(scale, cap)
  if not (P.on() and P.unit()) then return 1 end
  return P.k(scale, P.unit() * P.idle_zoom(), nil, cap or P.MAX_K)
end

local function is_dyna(o)
  return type(o) == 'table' and type(o.is) == 'function' and DynaText and o:is(DynaText)
end

function P.boost(n, unit, floor, cap, d)
  d = d or 0
  if type(n) ~= 'table' or d > 40 then return end
  local c = n.config
  if type(c) == 'table' and not c.pt_k then
    if n.n == G.UIT.T and type(c.scale) == 'number' then
      local k = P.k(c.scale, unit, floor, cap)
      c.pt_k = k
      if k > 1.001 then c.scale = c.scale * k end
    elseif n.n == G.UIT.O and is_dyna(c.object) then
      local o = c.object
      local k = P.k(o.scale, unit, floor, cap)
      c.pt_k = k
      if k > 1.001 then
        o.scale = o.scale * k
        if o.config.maxw then o.config.maxw = o.config.maxw * k end
        o.text_offset = {x = o.font.TEXT_OFFSET.x * o.scale + (o.config.x_offset or 0), y = o.font.TEXT_OFFSET.y * o.scale + (o.config.y_offset or 0)}
        local pin = o.config.pop_in
        o:update_text(true)
        if pin then o:pop_in(pin) end
      end
    end
  end
  for i = 1, table.maxn(n.nodes or {}) do P.boost(n.nodes[i], unit, floor, cap, d + 1) end
end

function P.wanted(args)
  if not P.on() or P.skip then return false end
  local cfg = args and args.config
  if P.popup or (cfg and cfg.instance_type == 'POPUP') then return true end
  return G.STAGE == G.STAGES.RUN and not G.OVERLAY_MENU
end

