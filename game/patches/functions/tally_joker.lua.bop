TALLY = TALLY or {}
local T = TALLY

T.REFRESH = 0.5
T.PER_FRAME = 3
T.SCALE = 0.34
T.AGAIN = {j_sock_and_buskin = true, j_mime = true, j_dusk = true}
T.cards = setmetatable({}, {__mode = 'k'})

mod_loc_register{
    fr = {
        ["Tally Joker"] = "Tally Joker",
        ["A line under each Joker with its numbers"] = "Une ligne sous chaque Joker avec ses valeurs",
        ["Tally Joker: Advanced"] = "Tally Joker : avancé",
        ["Says how each Joker gets its number"] = "Dit comment chaque Joker obtient sa valeur",
        ["Turn on Tally Joker first"] = "Activez d'abord Tally Joker",
    },
    es = {
        ["Tally Joker"] = "Tally Joker",
        ["A line under each Joker with its numbers"] = "Una línea bajo cada comodín con sus valores",
        ["Tally Joker: Advanced"] = "Tally Joker: avanzado",
        ["Says how each Joker gets its number"] = "Dice cómo consigue cada comodín su valor",
        ["Turn on Tally Joker first"] = "Activa primero Tally Joker",
    },
}

local logged = {}
local function log_once(key, msg)
    if logged[key] then return end
    logged[key] = true
    print("[tally] " .. tostring(msg))
end

function T.enabled()
    return G and G.SETTINGS and G.SETTINGS.tally_joker ~= false
end

function T.advanced()
    return T.enabled() and G.SETTINGS.tally_advanced == true or false
end

local function in_run()
    return G and G.STAGE == G.STAGES.RUN and G.GAME and G.jokers and G.jokers.cards and true or false
end

local function same_colour(a, b)
    if type(a) ~= 'table' or type(b) ~= 'table' then return false end
    for i = 1, 3 do
        if math.abs((a[i] or 0) - (b[i] or 0)) > 0.02 then return false end
    end
    return true
end

local function is_inactive(c)
    return c == nil or same_colour(c, G.C.UI.TEXT_INACTIVE)
end

local function trim(s)
    return (tostring(s or ''):gsub('^%s+', ''):gsub('%s+$', ''):gsub('%s%s+', ' '))
end

local now_cache = {}
function T.now_word()
    local lang = G.SETTINGS and G.SETTINGS.language or 'en-us'
    if now_cache[lang] ~= nil then return now_cache[lang] end
    local word = false
    local ok = pcall(function()
        local d = G.localization.descriptions.Joker.j_ride_the_bus
        for _, line in ipairs(d.text or {}) do
            local w = line:match('{C:inactive}%(([^{]+){')
            if w and trim(w) ~= '' then word = trim((trim(w):gsub('%s*:$', ''))) break end
        end
    end)
    if not ok then word = false end
    now_cache[lang] = word
    return word
end

local function dyna_text(obj)
    local s = obj.config and obj.config.string
    if type(s) == 'table' then s = s[1] end
    if type(s) == 'table' then s = s.string or (s.ref_table and s.ref_table[s.ref_value]) end
    if type(s) ~= 'string' and type(s) ~= 'number' then return nil end
    return tostring(s), obj.colours and obj.colours[1]
end

local function flatten(nodes, out, bg, depth)
    if type(nodes) ~= 'table' or depth > 6 then return end
    for _, n in ipairs(nodes) do
        if type(n) == 'table' then
            local c = n.config or {}
            if n.n == G.UIT.T and (c.text ~= nil or (c.ref_table and c.ref_value)) then
                local text = c.text
                if c.ref_table and c.ref_value then text = c.ref_table[c.ref_value] end
                if c.ref_value == 'blueprint_compat_ui' and (text == nil or trim(text) == '') and c.ref_table.blueprint_compat then
                    text = localize('k_' .. tostring(c.ref_table.blueprint_compat))
                end
                if text ~= nil then out[#out + 1] = {text = tostring(text), colour = c.colour, bg = bg} end
            elseif n.n == G.UIT.O and type(c.object) == 'table' then
                local s, col = dyna_text(c.object)
                if s then out[#out + 1] = {text = s, colour = col, bg = bg} end
            elseif n.nodes then
                flatten(n.nodes, out, (n.n == G.UIT.C and c.colour and not same_colour(c.colour, G.C.CLEAR)) and c.colour or bg, depth + 1)
            elseif n.n == nil then
                flatten(n, out, bg, depth + 1)
            end
        end
    end
end

local function split_parens(segs)
    local out = {}
    for _, s in ipairs(segs) do
        local rest = s.text
        while rest ~= '' do
            local i = rest:find('[%(%)]')
            if not i then
                out[#out + 1] = {text = rest, colour = s.colour, bg = s.bg}
                break
            end
            if i > 1 then out[#out + 1] = {text = rest:sub(1, i - 1), colour = s.colour, bg = s.bg} end
            out[#out + 1] = {paren = rest:sub(i, i), colour = s.colour}
            rest = rest:sub(i + 1)
        end
    end
    return out
end

local function groups_of(segs)
    local groups, cur, depth = {}, nil, 0
    for _, s in ipairs(split_parens(segs)) do
        if s.paren == '(' then
            depth = depth + 1
            if depth == 1 then cur = {} end
        elseif s.paren == ')' then
            if depth == 1 and cur then groups[#groups + 1] = cur; cur = nil end
            depth = math.max(0, depth - 1)
        elseif cur then
            cur[#cur + 1] = s
        end
    end
    return groups
end

local function group_text(g)
    local t = {}
    for _, s in ipairs(g) do t[#t + 1] = s.text end
    return trim(table.concat(t))
end

local function has_value(g)
    for _, s in ipairs(g) do
        if s.text:find('%d') and (s.bg or not (is_inactive(s.colour) or same_colour(s.colour, G.C.GREEN))) then return true end
    end
    return false
end

local function has_digit(g)
    for _, s in ipairs(g) do if s.text:find('%d') then return true end end
    return false
end

local function strip_word(g, word)
    if not word or #g == 0 then return g end
    local first = g[1]
    local t = first.text:gsub('^%s+', '')
    if t:sub(1, #word) ~= word then return nil end
    local out = {{text = (t:sub(#word + 1):gsub('^%s*:', '')), colour = first.colour, bg = first.bg}}
    for i = 2, #g do out[#out + 1] = g[i] end
    return out
end

local function pieces_of(g)
    local out = {}
    for _, s in ipairs(g) do
        local t = trim(s.text)
        if t ~= '' and t ~= ',' and t ~= ':' then
            local last = out[#out]
            if last and not s.bg and not last.bg and same_colour(last.colour, s.colour) then
                last.text = last.text .. ' ' .. t
            else
                out[#out + 1] = {text = t, colour = s.colour, bg = s.bg}
            end
        end
    end
    return out
end

local UNIT_COLOURS = {'CHIPS', 'MULT', 'MONEY'}

local function unit_word(segs, i)
    local nx = segs[i + 1]
    if not nx or nx.paren or nx.bg or nx.text:find('%d') then return nil end
    local w = nx.text:match('^%s+([^%s%p]+)')
    if not w or #w > 10 then return nil end
    return w
end

local function base_pieces(segs)
    local out, depth = {}, 0
    local list = split_parens(segs)
    for i, s in ipairs(list) do
        if s.paren then
            depth = math.max(0, depth + (s.paren == '(' and 1 or -1))
        elseif depth == 0 and s.text:find('%d') and (s.bg or not (is_inactive(s.colour) or same_colour(s.colour, G.C.GREEN))) then
            local t = trim(s.text)
            local col = s.bg or s.colour
            local unit = false
            for _, k in ipairs(UNIT_COLOURS) do if same_colour(col, G.C[k]) then unit = true end end
            local w = unit and unit_word(list, i)
            local last = out[#out]
            if last and same_colour(last.colour, col) and not last.unit and not w then
                last.text = last.text .. ', ' .. t
            else
                out[#out + 1] = {text = w and (t .. ' ' .. w) or t, colour = col, unit = w and true or nil}
            end
        end
    end
    return out
end

local function tag_pieces(segs)
    local out, depth = {}, 0
    for _, s in ipairs(split_parens(segs)) do
        if s.paren then
            depth = math.max(0, depth + (s.paren == '(' and 1 or -1))
        elseif depth == 0 and s.bg and trim(s.text) ~= '' then
            local t = trim(s.text)
            local col = s.bg
            if t == localize('k_compatible') then col = G.C.GREEN
            elseif t == localize('k_incompatible') then col = G.C.RED end
            out[#out + 1] = {text = t, colour = col}
        end
    end
    return out
end

local function chance_pieces(segs)
    local out, run, depth = {}, nil, 0
    for _, s in ipairs(split_parens(segs)) do
        if s.paren then depth = math.max(0, depth + (s.paren == '(' and 1 or -1)) end
        if not s.paren and depth == 0 and not s.bg and same_colour(s.colour, G.C.GREEN) then
            run = (run or '') .. s.text
        else
            if run and run:find('%d') then out[#out + 1] = {text = trim(run), colour = G.C.GREEN, chance = true} end
            run = nil
        end
    end
    if run and run:find('%d') then out[#out + 1] = {text = trim(run), colour = G.C.GREEN, chance = true} end
    return out
end

local function remove_new(r, n0, m0)
    local fresh, any = {}, false
    local nodes, moves = G.I and G.I.NODE, G.I and G.I.MOVEABLE
    if nodes then for i = n0 + 1, #nodes do fresh[nodes[i]] = true; any = true end end
    if moves then for i = m0 + 1, #moves do fresh[moves[i]] = true; any = true end end
    if not any then return end
    local seen = {}
    local function walk(t, d)
        if type(t) ~= 'table' or seen[t] or d > 12 then return end
        seen[t] = true
        local c = rawget(t, 'config')
        local o = type(c) == 'table' and rawget(c, 'object')
        if o and fresh[o] and o.remove then pcall(o.remove, o); fresh[o] = nil end
