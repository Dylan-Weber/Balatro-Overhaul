local Hooks = require("overhaul.hooks")

local function shop_area(a)
    return a ~= nil and (a == G.shop_jokers or a == G.shop_booster or a == G.shop_vouchers)
end

local function game_area(a)
    return a == G.hand or a == G.jokers or a == G.consumeables or a == G.deck or a == G.discard or a == G.play
        or a == G.pack_cards or shop_area(a)
end

local function mod_area(a)
    return a ~= nil and type(a.config) == "table" and not game_area(a) and G.CONTROLLER and G.CONTROLLER.HID and G.CONTROLLER.HID.touch or false
end

local function pc_select(a)
    local t = a.config.type
    return t == 'hand' or t == 'joker' or t == 'consumeable' or (t == 'shop' and (a.config.highlighted_limit or 0) > 0)
end

if Card and Card.single_tap then
    Hooks.wrap(Card, "single_tap", function(orig) return function(self, ...)
