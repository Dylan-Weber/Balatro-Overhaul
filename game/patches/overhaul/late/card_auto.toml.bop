[[patches]]
[patches.regex]
id = "auto.card.002"
target = "card.lua"
pattern = '''^(?<pre>)[\t ]*self\.children\.center = Sprite\(self\.T\.x, self\.T\.y, self\.T\.w, self\.T\.h, G\.ASSET_ATLAS\[_center\.set\], self\.config\.center\.pos\)\n(?<post>)'''
position = "at"
payload = '''
${pre}                    self.children.center = Sprite(self.T.x, self.T.y, self.T.w, self.T.h, G.ASSET_ATLAS[_center.atlas or _center.set] or G.ASSET_ATLAS[_center.set], self.config.center.pos)
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.card.003"
target = "card.lua"
pattern = '''^(?<pre>)[\t ]*self\.children\.back = Sprite\(self\.T\.x, self\.T\.y, self\.T\.w, self\.T\.h, G\.ASSET_ATLAS\["centers"\], self\.params\.bypass_back or \(self\.playing_card and G\.GAME\[self\.back\]\.pos or G\.P_CENTERS\['b_red'\]\.pos\)\)\n(?<post>)'''
position = "at"
payload = '''
${pre}            local _back_atlas = G.ASSET_ATLAS["centers"]
            local _back_pos = self.params.bypass_back or (self.playing_card and G.GAME[self.back].pos or G.P_CENTERS['b_red'].pos)
            if self.playing_card and G.GAME and G.GAME[self.back] and G.GAME[self.back].effect then
                local _bc = G.GAME[self.back].effect.center
                if _bc and _bc.atlas and _bc.atlas ~= "centers" and G.ASSET_ATLAS[_bc.atlas] then
                    _back_atlas = G.ASSET_ATLAS[_bc.atlas]
                end
            end
            self.children.back = Sprite(self.T.x, self.T.y, self.T.w, self.T.h, _back_atlas, _back_pos)
${post}'''
times = 1

