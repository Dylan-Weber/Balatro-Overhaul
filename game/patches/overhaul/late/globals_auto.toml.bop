position = "at"
payload = '''
${pre}        self.F_CRASH_REPORTS = true

        self.F_MOBILE = false

e 8 97 %20%20%20%20%20%20%20%20 - =7,-2,+%4C,=1,-1,+%4E%4B%54%52%45,=8
l 15
