pattern = '''^(?<pre>)[\t ]*G\.ROOM\.T\.x = G\.ROOM_ORIG\.x \+ \(shake_amt\)\*\(0\.015\*math\.sin\(0\.913\*G\.TIMERS\.REAL\)  \+ 0\.01\*\(G\.ROOM\.jiggle\*shake_amt\)\*math\.sin\(19\.913\*G\.TIMERS\.REAL\) \+ \(G\.ARGS\.eased_cursor_pos\.x - 0\.5\*\(G\.ROOM\.T\.w \+ G\.ROOM_ORIG\.x\)\)\*0\.01\)\n[\t ]*G\.ROOM\.T\.y = G\.ROOM_ORIG\.y \+ \(shake_amt\)\*\(0\.015\*math\.sin\(0\.952\*G\.TIMERS\.REAL\)  \+ 0\.01\*\(G\.ROOM\.jiggle\*shake_amt\)\*math\.sin\(21\.913\*G\.TIMERS\.REAL\) \+ \(G\.ARGS\.eased_cursor_pos\.y - 0\.5\*\(G\.ROOM\.T\.h \+ G\.ROOM_ORIG\.y\)\)\*0\.01\)\n(?<post>)'''
position = "at"
payload = '''
${pre}    G.ROOM.T.x = G.ROOM_ORIG.x + (shake_amt)*(0.015*math.sin(0.913*G.TIMERS.REAL)  + 0.01*(G.ROOM.jiggle*shake_amt)*math.sin(19.913*G.TIMERS.REAL) + (G.ARGS.eased_cursor_pos.x - 0.5*G.ROOM.T.w)*0.01)
    G.ROOM.T.y = G.ROOM_ORIG.y + (shake_amt)*(0.015*math.sin(0.952*G.TIMERS.REAL)  + 0.01*(G.ROOM.jiggle*shake_amt)*math.sin(21.913*G.TIMERS.REAL) + (G.ARGS.eased_cursor_pos.y - 0.5*G.ROOM.T.h)*0.01)
${post}'''
times = 1

[[patches]]
[patches.regex]
id = "auto.common_events.033"
requires = ["auto.globals.014"]
target = "functions/common_events.lua"
pattern = '''^(?<pre>)[\t ]*if G\.CONTROLLER\.GAMEPAD\.object and G\.F_RUMBLE then G\.CONTROLLER\.GAMEPAD\.object:setVibration\(G\.CURR_VIBRATION\*0\.4\*G\.F_RUMBLE, G\.CURR_VIBRATION\*0\.4\*G\.F_RUMBLE\) end\n(?<post>)'''
position = "at"
payload = '''
${pre}    local pad = G.CONTROLLER.GAMEPAD and G.CONTROLLER.GAMEPAD.object
    local rumble_on = G.F_RUMBLE and G.SETTINGS.rumble
    if rumble_on and pad then
        local strength = G.CURR_VIBRATION*0.4*G.F_RUMBLE
        pad:setVibration(strength, strength)
    elseif love.system.getOS() == 'Android' and G.SETTINGS.haptic_feedback and (G.SETTINGS.haptic_intensity or 50) > 0 and (G.HAPTIC_LEVEL or 0) > 0 then
        local _intensity = (G.SETTINGS.haptic_intensity or 50) / 100
        local _durations = {0.015, 0.03, 0.06, 0.1}
        local _dur = (_durations[G.HAPTIC_LEVEL] or 0.03) * (0.3 + _intensity * 1.4)
        pcall(function() love.system.vibrate(_dur) end)
        G.HAPTIC_LEVEL = 0
    end
    G.VIBRATION = 0
end

function haptic_buzz(level)
    if not G or not G.SETTINGS then return end
    if not G.SETTINGS.haptic_feedback then return end
    G.HAPTIC_LEVEL = math.max(G.HAPTIC_LEVEL or 0, level or 1)
${post}'''
times = 1

