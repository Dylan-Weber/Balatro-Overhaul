[[patches]]
[patches.regex]
id = "auto.common_events.038"
target = "functions/common_events.lua"
pattern = '''^(?<pre>)(?<post>[\t ]*\n[\t ]*function notify_alert\(_achievement, _type\)\n)'''
position = "at"
payload = '''
${pre}function notify_alert_scale(node, k, depth)
    depth = depth or 0
    if type(node) ~= "table" or depth > 12 then return node end
    local c = node.config
    if c then
        if c.scale then c.scale = c.scale * k end
        if c.maxw then c.maxw = c.maxw * k end
        if c.padding then c.padding = c.padding * math.min(k, 1.3) end
        local o = c.object
        if o and o.T and o.T.w then o.T.w, o.T.h = o.T.w * k, o.T.h * k end
    end
    for _, v in ipairs(node.nodes or {}) do notify_alert_scale(v, k, depth + 1) end
    return node
end

local function notify_alert_min_scale(node, depth)
    depth = depth or 0
    if type(node) ~= "table" or depth > 12 then return nil end
    local m = node.n == G.UIT.T and node.config and node.config.scale or nil
    for _, v in ipairs(node.nodes or {}) do
        local c = notify_alert_min_scale(v, depth + 1)
        if c and (not m or c < m) then m = c end
    end
    return m
end

function notify_alert_def(_achievement, _type, from_left)
    local def = create_UIBox_notify_alert(_achievement, _type, from_left)
    local room = nil
    if PORTRAIT and PORTRAIT.on and PORTRAIT.on() and PORTRAIT.popup_k then
        local fit = 0.45 * love.graphics.getWidth() / (G.TILESIZE * G.TILESCALE) / 4.2
        local k = math.min(PORTRAIT.popup_k(), fit)
        notify_alert_scale(def, k)
        def.nodes[1].config.minw = nil
        room = fit / k
    end
    if PHONE_TEXT and PHONE_TEXT.on() and PHONE_TEXT.unit() then
        local ms = notify_alert_min_scale(def)
        if ms then
            local k = PHONE_TEXT.k(ms, PHONE_TEXT.unit() * (G.MENU_ZOOM or 1), nil, 1.4)
            if room then k = math.min(k, math.max(1, room)) end
            if k > 1.001 then
                notify_alert_scale(def, k)
                if def.nodes[1].config.minw then def.nodes[1].config.minw = def.nodes[1].config.minw * k end
            end
        end
    end
    return def
end

function notify_alert_rest_x(n, inner)
    local edge = love.graphics.getWidth() / (G.TILESIZE * G.TILESCALE) - G.ROOM.T.x - G.ROOM_ATTACH.T.x - G.ROOM_ATTACH.T.w
    return math.min(G.ROOM.T.x - inner.T.w - 0.8, edge - 0.1 - n.T.w)
end
${post}'''
times = 1

