pattern = '''^(?<pre>)[\t ]*local rarity = _rarity or SMODS\.poll_rarity\("Joker", 'rarity'\.\.(?:to_[a-z_]+\()?G\.GAME\.round_resets\.ante\)?\.\.\(_append or ''\)\)\n(?<post>)'''
position = "at"
payload = '''
${pre}local rr_rarity = not _rarity and RunRules and RunRules.rarity_of and RunRules.active and (RunRules.active('rarity_common') ~= nil or RunRules.active('rarity_uncommon') ~= nil or RunRules.active('rarity_rare') ~= nil) and RunRules.rarity_of(pseudorandom('rarity'..G.GAME.round_resets.ante..(_append or '')))
local rarity = _rarity or rr_rarity or SMODS.poll_rarity("Joker", 'rarity'..G.GAME.round_resets.ante..(_append or ''))
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.common_events.modded.010"
target = "functions/common_events.lua"
pattern = '''^(?<pre>)[\t ]*if sticker\.should_apply and type\(sticker\.should_apply\) == 'function' and sticker:should_apply\(card, center, area\) then\n(?<post>)'''
position = "at"
payload = '''
${pre}        if sticker and sticker.should_apply and type(sticker.should_apply) == 'function' and sticker:should_apply(card, center, area) then
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.common_events.modded.011"
target = "functions/common_events.lua"
pattern = '''^(?<pre>)[\t ]*if card\.area == G\.cdds_cards and card\.generate_ds_card_ui and type\(card\.generate_ds_card_ui\) == 'function' and card\.deckskin and card\.palette then\n(?<post>)'''
position = "at"
payload = '''
${pre}        if card and card.area == G.cdds_cards and card.generate_ds_card_ui and type(card.generate_ds_card_ui) == 'function' and card.deckskin and card.palette then
${post}'''
optional = true

[[patches]]
[patches.regex]
id = "auto.common_events.modded.012"
target = "functions/common_events.lua"
pattern = '''^(?<pre>)[\t ]*if card_type == 'Default' or card_type == 'Enhanced' and not _c\.replace_base_card and card and card\.base then\n(?<post>)'''
position = "at"
payload = '''
${pre}   if (card_type == 'Default' or card_type == 'Enhanced') and not _c.replace_base_card and card and card.base then
${post}'''
optional = true
end
