	return true
end

local function guarded(fn, ...)
	local g = love.graphics
	local depth = g and g.getStackDepth and g.getStackDepth()
	local ok, r = pcall(fn, ...)
	if not ok and depth then
		while g.getStackDepth() > depth do g.pop() end
	end
	return ok, r
end

function M.run(engine, draw)
	draw = draw or M.draw
	local list = M.pending(engine)
	if #list == 0 then return 0 end
	local total, done = 0, 0
	for _, item in ipairs(list) do total = total + item.size end
	local warnings = type(engine.warnings) == "table" and #engine.warnings or nil
	guarded(draw, 0, total)
	for _, item in ipairs(list) do
		local code = love.filesystem.read(item.path)
		if type(code) == "string" then pcall(engine.patch_cached, item.target, code) end
		done = done + item.size
		guarded(draw, done, total)
	end
	if warnings then
		for i = #engine.warnings, warnings + 1, -1 do engine.warnings[i] = nil end
	end
	return #list
end

return M
end
