local M = {}

M.FONT = "resources/fonts/m6x11plus.ttf"
M.TITLE = "Preparing Balatro Overhaul"
M.LINE = "First start after an install or update, this can take a minute"

local function source_path(engine, target)
	for path, t in pairs(engine.aliases or {}) do
		if t == target and love.filesystem.getInfo(path, "file") then return path end
	end
	if love.filesystem.getInfo("balatro/" .. target, "file") then return "balatro/" .. target end
	if love.filesystem.getInfo(target, "file") then return target end
	return nil
end

function M.pending(engine)
	local list = {}
	if type(engine) ~= "table" or not engine.cache_dir or type(engine.targets) ~= "table" then return list end
	for target in pairs(engine.targets) do
		if type(target) == "string" and target:match("^[%w_%-%./]+%.lua$") then
			local path = source_path(engine, target)
			if path and not love.filesystem.getInfo(engine.cache_dir .. "/" .. engine.hash(target) .. ".meta", "file") then
				list[#list + 1] = {target = target, path = path, size = (love.filesystem.getInfo(path) or {}).size or 1}
			end
		end
	end
	table.sort(list, function(a, b) return a.target < b.target end)
	return list
end

local fonts = {}

local function font(px)
	px = math.max(8, math.floor(px + 0.5))
	if fonts[px] == nil then
		local ok, f = pcall(love.graphics.newFont, M.FONT, px)
		if not ok then ok, f = pcall(love.graphics.newFont, px) end
		fonts[px] = ok and f or false
	end
	return fonts[px] or love.graphics.getFont()
end

local function centered(text, f, cx, y)
	love.graphics.setFont(f)
	love.graphics.print(text, math.floor(cx - f:getWidth(text) / 2 + 0.5), math.floor(y + 0.5))
end

function M.draw(done, total)
	if not (love.graphics and love.window and love.window.isOpen and love.window.isOpen()) then return false end
	if love.event and love.event.pump then love.event.pump() end
	if love.graphics.isActive and not love.graphics.isActive() then return false end
	local w, h = love.graphics.getDimensions()
	local s = math.min(w, h)
	local frac = total > 0 and math.max(0, math.min(1, done / total)) or 0
	love.graphics.push("all")
